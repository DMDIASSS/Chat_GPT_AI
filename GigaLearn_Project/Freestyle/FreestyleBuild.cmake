# Compare source identities rather than raw spelling: -D values from Python
# on Windows can contain backslashes while GLOB returns forward slashes.
function(freestyle_source_identity output path base)
 string(REPLACE "\\" "/" normalized "${path}")
 get_filename_component(normalized "${normalized}" ABSOLUTE BASE_DIR "${base}")
 if(WIN32)
  string(TOLOWER "${normalized}" normalized)
 endif()
 set(${output} "${normalized}" PARENT_SCOPE)
endfunction()

function(freestyle_replace_learner target original replacement base)
 get_target_property(sources ${target} SOURCES)
 freestyle_source_identity(expected "${original}" "${base}")
 set(retained "")
 set(removed 0)
 foreach(source IN LISTS sources)
  freestyle_source_identity(actual "${source}" "${base}")
  if(actual STREQUAL expected)
   math(EXPR removed "${removed}+1")
  else()
   list(APPEND retained "${source}")
  endif()
 endforeach()
 if(NOT removed EQUAL 1)
  message(FATAL_ERROR "Expected exactly one upstream Learner.cpp; found ${removed}. Refusing duplicate or unverified learner implementations.")
 endif()
 set_property(TARGET ${target} PROPERTY SOURCES ${retained} "${replacement}")
endfunction()
