        <Item class="ModuleScript" referent="RBX00000010">
          <Properties>
            <string name="Name">AssetLoader</string>
            <ProtectedString name="Source">-- Mesh geometry and optional decoration have separate availability. Never discard
-- usable native car parts just because a private texture or sound cannot load.
local ContentProvider=game:GetService('ContentProvider')
local Loader={};local entries=setmetatable({},{__mode='k'})
local function inspect(template)
 local visible,native,ids,seen=0,0,{},{}
 for _,item in ipairs(template:GetDescendants())do
  if item:IsA('BasePart')and item.Transparency&lt;1 then
   visible+=1
   local mesh=item:IsA('MeshPart')and item or item:FindFirstChildOfClass('SpecialMesh')
   local external=mesh and (mesh:IsA('MeshPart')or mesh.MeshType==Enum.MeshType.FileMesh)
   if external then
    local id=mesh.MeshId
    if id and id~=''and not seen[id]then seen[id]=true;ids[#ids+1]=id end
    if not id or id==''then ids[#ids+1]=''end
   else native+=1 end
  end
 end
 return visible,native,ids
end
function Loader.nativeParts(template)local _,native=inspect(template);return native end
local function finish(entry,ok)
 if entry.status~='loading'then return end
 entry.status=ok and 'ready'or 'unavailable'
 local callbacks=entry.callbacks;entry.callbacks={}
 for _,callback in ipairs(callbacks)do task.defer(callback,ok)end
end
function Loader.check(template,callback)
 if not template then if callback then task.defer(callback,false)end;return 'unavailable'end
 local entry=entries[template]
 if not entry then
  entry={status='loading',callbacks={}};entries[template]=entry
  local visible,native,ids=inspect(template);entry.native=native
  if visible==0 or table.find(ids,'')then entry.status='unavailable'
  elseif #ids==0 then entry.status='ready'
  else
   task.delay(8,function()finish(entry,false)end)
   task.spawn(function()
    local failed,observed=false,false
    local ok=pcall(function()
     -- Only required geometry IDs: an optional decal/SurfaceAppearance failure
     -- must not suppress an otherwise working exterior or original interior.
     ContentProvider:PreloadAsync(ids,function(_,status)
      observed=true;if status~=Enum.AssetFetchStatus.Success then failed=true end
     end)
    end)
    finish(entry,ok and observed and not failed)
   end)
  end
 end
 if callback then
  if entry.status=='loading'then entry.callbacks[#entry.callbacks+1]=callback else task.defer(callback,entry.status=='ready')end
 end
 return entry.status
end
function Loader.ready(template)return Loader.check(template)=='ready'end
return Loader
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000011">
          <Properties>
            <string name="Name">Assets</string>
            <ProtectedString name="Source">-- Original lightweight models; optional skins are harvested from the user's place by Installer.
local Assets={}
local Loader=require(script.Parent.AssetLoader)
local function color(t)return Color3.new(t[1],t[2],t[3])end
function Assets.part(parent,name,size,cf,tint,material,shape)
 local p=Instance.new('Part');p.Name=name;p.Size=size;p.CFrame=cf;p.Anchored=true
 p.Color=typeof(tint)=='Color3'and tint or color(tint);p.Material=material or Enum.Material.SmoothPlastic
 p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.CastShadow=false
 p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;if shape then p.Shape=shape end;p.Parent=parent;return p
end
local function box(model,name,size,position,tint,material)
 return Assets.part(model,name,size,CFrame.new(position),tint,material)
end
local dark={.075,.09,.095};local glass={.14,.24,.25};local metal={.50,.55,.54}
function Assets.car(parent,car,ghost,useOriginal,withAudio)
 local model=Instance.new('Model');model.Name=ghost and 'SavedGhost'or car.name
 local body=box(model,'Chassis',Vector3.new(5.7,1.55,9.4),Vector3.zero,car.color);model.PrimaryPart=body
 box(model,'Bonnet',Vector3.new(5.55,.55,2.7),Vector3.new(0,.9,-3),car.color)
 box(model,'Roof',Vector3.new(4.6,.35,4.7),Vector3.new(0,2.2,.4),car.color)
 box(model,'Cabin',Vector3.new(4.5,1.5,4.3),Vector3.new(0,1.4,.4),glass)
 box(model,'Windscreen',Vector3.new(4.5,1.25,.12),Vector3.new(0,1.5,-1.8),glass)
 for _,side in ipairs({-1,1})do
  box(model,'A pillar',Vector3.new(.18,1.65,.22),Vector3.new(side*2.25,1.5,-1.8),car.color)
  box(model,'B pillar',Vector3.new(.18,1.65,.20),Vector3.new(side*2.25,1.5,.3),car.color)
  box(model,'C pillar',Vector3.new(.18,1.65,.22),Vector3.new(side*2.25,1.5,2.4),car.color)
  box(model,'Mirror',Vector3.new(.55,.25,.7),Vector3.new(side*3,1,-1.45),dark)
  box(model,'Sill',Vector3.new(.15,.3,6.2),Vector3.new(side*2.9,-.4,.3),dark)
  box(model,'Headlamp',Vector3.new(1.5,.45,.12),Vector3.new(side*1.65,.4,-4.76),{.99,.91,.64},Enum.Material.Neon)
  box(model,'Tail lamp',Vector3.new(1.1,.32,.12),Vector3.new(side*1.85,.45,4.76),{.72,.13,.1},Enum.Material.Neon)
 end
 box(model,'Front bumper',Vector3.new(5.9,.55,.4),Vector3.new(0,-.3,-4.8),dark)
 box(model,'Rear bumper',Vector3.new(5.9,.55,.4),Vector3.new(0,-.3,4.8),dark)
 box(model,'Grille',Vector3.new(2.3,.5,.15),Vector3.new(0,.3,-4.78),dark)
 box(model,'Rally stripe',Vector3.new(.8,.04,9.1),Vector3.new(.8,.8,0),{.94,.91,.79})
 if car.id=='scout'then
  box(model,'Roof rack',Vector3.new(4.9,.2,4.7),Vector3.new(0,2.5,.4),dark)
  box(model,'Expedition case',Vector3.new(3.5,.55,2.7),Vector3.new(0,2.9,.8),{.45,.37,.24})
 elseif car.id=='coupe'then
  box(model,'Spoiler',Vector3.new(6,.2,.8),Vector3.new(0,1.35,4.1),dark)
 end
 local wheels={}
 for _,front in ipairs({true,false})do for _,sign in ipairs({-1,1})do
  local tyre=Assets.part(model,'Tyre',Vector3.new(.8,car.radius*2,car.radius*2),CFrame.new(sign*3,car.radius-2.2,front and -car.wheelbase*car.rearShare or car.wheelbase*(1-car.rearShare)),dark,Enum.Material.SmoothPlastic,Enum.PartType.Cylinder)
  local rim=Assets.part(model,'Wheel',Vector3.new(.83,car.radius*1.16,car.radius*1.16),tyre.CFrame,metal,Enum.Material.Metal,Enum.PartType.Cylinder)
  wheels[#wheels+1]={tyre=tyre,rim=rim,side=sign,front=front}
 end end
 local root=game:GetService('ReplicatedStorage'):FindFirstChild('BackseatExpedition')
 local library=root and root:FindFirstChild('ImportedCars')
 local template=useOriginal~=false and library and library:FindFirstChild(car.template)
 if useOriginal~=false and not template and root then template=require(script.Parent.ImportAssets).getCar(root,car.template)end
 local parts={}
 for _,p in ipairs(model:GetDescendants())do if p:IsA('BasePart')then
  p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=not ghost
  if ghost then p.Color=Color3.fromRGB(107,220,201);p.Transparency=.65;p.Material=Enum.Material.ForceField end
  parts[#parts+1]=p
 end end
 local lights={}
 if not ghost then for _,part in ipairs(parts)do if part.Name=='Headlamp'then
  local light=Instance.new('SpotLight');light.Face=Enum.NormalId.Front;light.Range=60;light.Angle=64;light.Brightness=2.5;light.Enabled=false;light.Shadows=false;light.Parent=part;lights[#lights+1]=light
 end end end
 local sounds={};local bank=withAudio and root and root:FindFirstChild('ImportedAudio')
 if bank and not ghost then for _,name in ipairs({'Idle','Run','High'})do
  local source=bank:FindFirstChild(name)
  if source and source:IsA('Sound')then local sound=source:Clone();sound.Parent=body;sound.Volume=0;sound:Play();sounds[#sounds+1]=sound end
 end end
 model.Parent=parent
 model:SetAttribute('VisualSource','BuiltIn')
 local visual={model=model,wheels=wheels,parts=parts,spin=0,audio=sounds,car=car,lights=lights,skinStatus=template and 'loading'or 'missing'}
 if template and not ghost then
  local skinOffset=CFrame.new(0,car.radius-(car.rideHeight or 2.2),-car.wheelbase*((car.rearShare or .5)-.5))
  local function attachOriginal(complete)
   if not model.Parent then return end
   local skin=visual.skin
   if not skin then
    skin=template:Clone();if not skin.PrimaryPart then skin:Destroy();return end
    skin.Name='Original exterior';skin:PivotTo(model:GetPivot()*skinOffset);skin.Parent=model;visual.skin=skin
    for _,part in ipairs(skin:GetDescendants())do if part:IsA('BasePart')then
     part.Anchored=true;part.CanCollide=false;part.CanTouch=false;part.CanQuery=false
    end end
    local cabin=skin:FindFirstChild('Interior');visual.interior=cabin
    visual.interiorReady=cabin and (Loader.nativeParts(cabin)&gt;0 or complete)or false
    visual.eyeOffsets={}
    for key,name in pairs({Driver='DriverEye',CoDriver='CoDriverEye'})do
     local eye=skin.PrimaryPart:FindFirstChild(name)
     if eye then visual.eyeOffsets[key]=skinOffset*eye.CFrame end
    end
    visual.steeringParts={}
    local hub=cabin and cabin:FindFirstChild('SteeringHub')
    if hub and hub:IsA('BasePart')then
     local inverse=model:GetPivot():Inverse();local localHub=inverse*hub.CFrame
     for _,part in ipairs(cabin:GetDescendants())do if part:IsA('BasePart')and part.Name:find('SteeringWheel',1,true)then
      visual.steeringParts[#visual.steeringParts+1]={part=part,hub=localHub,localFrame=hub.CFrame:Inverse()*part.CFrame}
     end end
    end
    visual.instrumentParts={}
    if cabin then for _,gauge in ipairs({'Speedo','Tach'})do
     local hub=cabin:FindFirstChild(gauge..'Hub')
     if hub then for _,part in ipairs(cabin:GetDescendants())do
      if part:IsA('BasePart')and (part.Name==gauge..'Needle'or part.Name==gauge..'Tail')then
       visual.instrumentParts[#visual.instrumentParts+1]={part=part,hub=model:GetPivot():Inverse()*hub.CFrame,localFrame=hub.CFrame:Inverse()*part.CFrame,
        kind=gauge,zero=hub:GetAttribute('ZeroAngle')or 135,finish=hub:GetAttribute('MaxAngle')or -135,max=hub:GetAttribute('MaxValue')or (gauge=='Speedo'and 200 or 8000)}
      end
     end end
    end end
    local group=skin:FindFirstChild('OriginalWheels')
    for i,name in ipairs({'FL','FR','RL','RR'})do
     local original=group and group:FindFirstChild(name);local wheel=wheels[i]
     if original then
      local relative=model:GetPivot():Inverse()*original:GetPivot();wheel.original=original;wheel.originalRotation=relative.Rotation;wheel.originalPosition=relative.Position
      Loader.check(original,function(ready)if ready and model.Parent then wheel.tyre.Transparency=1;wheel.rim.Transparency=1 end end)
     end
    end
   end
   if complete then
    visual.interiorReady=visual.interior~=nil
    for _,part in ipairs(parts)do if part.Name~='Tyre'and part.Name~='Wheel'then part.Transparency=1 end end
    model:SetAttribute('VisualSource','Original')
   else model:SetAttribute('VisualSource','OriginalPartial')end
   if visual.cockpit then visual.cockpit=nil;Assets.cockpitView(visual,true)end
  end
  -- Native objects in the original car are useful immediately, even if one of
  -- its private meshes cannot be obtained. Never throw away the whole interior.
  if Loader.nativeParts(template)&gt;0 then attachOriginal(false)end
  Loader.check(template,function(ready)
   visual.skinStatus=ready and 'loaded'or (visual.skin and 'partial'or 'unavailable')
   if ready then attachOriginal(true)end
  end)
 end
 return visual
end
function Assets.cockpitView(visual,enabled)
 if visual.cockpit==enabled then return end;visual.cockpit=enabled
 for _,part in ipairs(visual.model:GetDescendants())do if part:IsA('BasePart')then
  local name=part.Name:lower()
  if name=='cabin'or name=='windscreen'or (part.Parent==visual.model and (name=='roof'or name=='a pillar'or name=='b pillar'or name=='c pillar'))or name:find('glass',1,true)or name:find('windshield',1,true)or name:find('window',1,true)then
   visual.hidden=visual.hidden or {}
   if enabled then if visual.hidden[part]==nil then visual.hidden[part]=part.LocalTransparencyModifier end;part.LocalTransparencyModifier=1
   elseif visual.hidden[part]~=nil then part.LocalTransparencyModifier=visual.hidden[part];visual.hidden[part]=nil end
  end
 end end
end
function Assets.headlights(visual,enabled,quality)
 for _,light in ipairs(visual.lights or {})do light.Enabled=enabled;light.Shadows=quality=='high'end
end
function Assets.pose(visual,s,route,offset,dt)
 local D=require(script.Parent.Dynamics)
 local y,pitch,roll=D.pose(s,route,visual.car)
 local cf=route.original and route:frame(s,offset,y,pitch,roll)or (CFrame.new(Vector3.new(s.x,y,s.z)+offset)*CFrame.Angles(0,math.pi+s.yaw,0)*CFrame.Angles(pitch,0,roll))
 visual.model:PivotTo(cf);visual.spin=(visual.spin+s.v*(dt or 0)/visual.car.radius)%(math.pi*2)
 for i,wheel in ipairs(visual.wheels)do
  local wb=visual.car.wheelbase;local com=wb*((visual.car.rearShare or .5)-.5)
  local z=(wheel.front and -wb/2 or wb/2)-com
  local wheelPosition=wheel.originalPosition or Vector3.new(wheel.side*3,0,z)
  local pos=cf:PointToWorldSpace(Vector3.new(wheelPosition.X,0,wheelPosition.Z))
  local localPos=pos-offset;local ground
  if route.original then
   local arm=-wheelPosition.Z
   ground=route:ground(s.x+math.sin(s.yaw)*arm-math.cos(s.yaw)*wheelPosition.X,s.z+math.cos(s.yaw)*arm+math.sin(s.yaw)*wheelPosition.X)
  else ground=route:ground(localPos.X,localPos.Z)end
  local tyre=s.tyres and s.tyres[i]
  local flatten=tyre and math.clamp(.68+.32*tyre.pressure,.70,1.06)or 1
  wheel.tyre.Size=Vector3.new(.8,visual.car.radius*2*flatten,visual.car.radius*2)
  local at=Vector3.new(pos.X,ground+visual.car.radius*flatten+offset.Y,pos.Z)
  local wc=CFrame.new(at)*cf.Rotation*CFrame.Angles(0,wheel.front and -s.steer*.32 or 0,0)
  wheel.tyre.CFrame=wc;wheel.rim.CFrame=wc*CFrame.Angles(visual.spin,0,0)
  if wheel.original then wheel.original:PivotTo(wc*wheel.originalRotation*CFrame.Angles(visual.spin,0,0))end
 end
 for i,sound in ipairs(visual.audio or {})do
  local speed=math.abs(s.v);local gear=(speed%32)/32
  sound.PlaybackSpeed=math.clamp(.65+gear*.8,.5,1.6)
  local gain=i==1 and math.clamp(1-speed/35,0,1)or(i==2 and math.clamp(speed/45,0,1)or math.clamp((speed-65)/65,0,1))
  sound.Volume=(dt or 0)&gt;0 and gain*.17 or 0
 end
 return cf
end
function Assets.park(parent)
 local ground=Assets.part(parent,'Service park',Vector3.new(160,2,150),CFrame.new(0,-1,0),{.21,.25,.22},Enum.Material.Asphalt)
 ground.CanCollide=true;ground.CanQuery=true
 for i,car in ipairs(require(script.Parent.Config).Cars)do
  local visual=Assets.car(parent,car,false,require(script.Parent.Config).ImportedVisuals)
  visual.model:PivotTo(CFrame.new((i-2)*20,2.2,-12)*CFrame.Angles(0,math.pi,0))
 end
 Assets.part(parent,'Workshop',Vector3.new(64,14,22),CFrame.new(0,7,-42),{.24,.30,.29},Enum.Material.WoodPlanks)
 Assets.part(parent,'Roof',Vector3.new(70,1,28),CFrame.new(0,14,-42),{.12,.18,.18},Enum.Material.Metal)
 for _,x in ipairs({-21,0,21})do Assets.part(parent,'Garage door',Vector3.new(17,10,.25),CFrame.new(x,5,-30.8),{.10,.14,.15},Enum.Material.Metal)end
 for _,x in ipairs({-44,44})do
  Assets.part(parent,'Lamp',Vector3.new(.5,12,.5),CFrame.new(x,6,5),metal,Enum.Material.Metal)
  Assets.part(parent,'Lantern',Vector3.new(2,.4,3),CFrame.new(x,12,5),{.99,.79,.48},Enum.Material.Neon)
 end
 local sign=Assets.part(parent,'Expedition sign',Vector3.new(45,4,.4),CFrame.new(0,12,-30.5),dark)
 local gui=Instance.new('SurfaceGui');gui.Face=Enum.NormalId.Back;gui.CanvasSize=Vector2.new(1000,100);gui.Parent=sign
 local text=Instance.new('TextLabel');text.Size=UDim2.fromScale(1,1);text.BackgroundTransparency=1;text.Text='BACKSEAT / EXPEDITION'
 text.TextColor3=Color3.fromRGB(239,222,183);text.Font=Enum.Font.GothamBold;text.TextScaled=true;text.Parent=gui
end
return Assets
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000012">
          <Properties>
            <string name="Name">Config</string>
            <ProtectedString name="Source">-- Backseat Rally: Expedition. Authored game systems, not an executor script.
return {
 Version='1.5.0', AutoOpen=true, UseOriginalStages=true, ImportedVisuals=true, ExternalAudio=false, Generation=4, WorldX=12000, LaneSpacing=1800, StudMetres=.28, Step=1/60, StateRate=12, InputRate=20,
 Climate={dryWetness=.08,rainWetness=.45,wetGripLoss=.24,windSpeed=3},
 Chunk=256, RoadStep=8, RoadWidth=28, Checkpoint=768, MaxPlayers=8,
 ReplayRate=10, ReplayPage=500, ReplayPending=4, LibrarySize=12, BestSize=8,
 Modes={
  {id='sprint',name='Rally Sprint',tag='A road with an ending',length=6144,weather='clear',xp=240},
  {id='expedition',name='Expedition',tag='Four biomes. One long drive.',length=16384,weather='clear',xp=650},
  {id='daily',name='Daily Roadbook',tag='The same new road for everyone today',length=8192,weather='dusk',xp=340},
  {id='endless',name='Endless Journey',tag='Keep going. Bank the run whenever you want.',length=0,weather='clear',xp=0},
 },
 Cars=require(script.Parent.VehicleCatalog),
 Biomes={
  {name='Pine Country',ground={.29,.36,.24},road={.39,.34,.27},accent={.88,.66,.28},trees=true},
  {name='Alpine Pass',ground={.56,.60,.57},road={.40,.43,.43},accent={.72,.86,.91},snow=true},
  {name='Red Mesa',ground={.63,.40,.25},road={.67,.51,.35},accent={.91,.67,.33},desert=true},
  {name='North Coast',ground={.40,.51,.37},road={.36,.39,.40},accent={.80,.85,.71},coast=true},
 },
 Quality={low={behind=1,ahead=4,props=2,shadows=false},medium={behind=2,ahead=5,props=5,shadows=false},high={behind=2,ahead=6,props=9,shadows=true}},
}
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000013">
          <Properties>
            <string name="Name">Dynamics</string>
            <ProtectedString name="Source">-- Shared deterministic rally model, in studs and seconds (.28 metres/stud).
-- Fixed four-contact approximation: no unbounded tyre raycasts or client forces.
-- Profiles supply each car's engine, mass, axle balance, geometry and suspension.
local D={}
-- Edit this table for every car, or override individual keys in car.simulation.
D.Tuning={DamageEnergy=700,PunctureImpact=.24,PressureLeak=.11,LoadSensitivity=.12,
 WearRate=1,TyreHeatRate=.09,ThrottleResponse=7,CorneringScale=48,BodyFrequency=9}
local function tune(car,key)return car and car.simulation and car.simulation[key]or D.Tuning[key]end
local G=9.81/.28
local function wrap(a)return (a+math.pi)%(2*math.pi)-math.pi end
local function approach(a,b,rate,dt)return a+(b-a)*(1-math.exp(-rate*dt))end
local function finite(n)return type(n)=='number'and n==n and math.abs(n)&lt;1e8 end
local function deepCopy(value)
 if type(value)~='table'then return value end
 local out={};for k,v in pairs(value)do out[k]=deepCopy(v)end;return out
end
local function equip(s,car,ambient)
 if not s.health then s.health={engine=1,brakes=1,suspension=1,steering=1}end
 if not s.tyres then
  s.tyres={}
  for i=1,4 do s.tyres[i]={pressure=1,targetPressure=1,temperature=ambient or 20,wear=0,punctured=false,load=0,slip=0,grip=1,compression=0}end
 end
 s.settings=s.settings or {damage=true,punctures=true,abs=true,tractionControl=true,steeringAssist=.65,stabilityAssist=.5}
 s.engineTemperature=s.engineTemperature or 75;s.brakeTemperature=s.brakeTemperature or 25
 s.engineHealth=s.health.engine
end
function D.new(route)
 local p=route:point(0)
 local s={x=p.x,z=0,v=0,lateralV=0,yaw=p.heading,steer=0,damage=0,distance=0,crashes=0,impact=0,impactSpeed=0,impactSide=0,throttle=0,brake=0}
 equip(s,nil,route:conditions(0).temperature);return s
end
function D.copy(s)return deepCopy(s)end
-- Only known handling switches are accepted; presentation options live on client.
function D.configure(s,settings)
 equip(s);settings=settings or {}
 if type(settings.assists)=='boolean'then s.settings.abs=settings.assists;s.settings.tractionControl=settings.assists;s.settings.steeringAssist=settings.assists and .65 or 0;s.settings.stabilityAssist=settings.assists and .5 or 0 end
 if finite(settings.tyrePressure)then D.setPressure(s,'all',settings.tyrePressure)end
 for _,key in ipairs({'damage','punctures','abs','tractionControl'})do if type(settings[key])=='boolean'then s.settings[key]=settings[key]end end
 for _,key in ipairs({'steeringAssist','stabilityAssist'})do if finite(settings[key])then s.settings[key]=math.clamp(settings[key],0,1)end end
end
-- Pressure is relative to a car's nominal cold pressure (1 = 100%, not PSI).
function D.setPressure(s,wheel,pressure,car)
 equip(s,car)
 if not finite(pressure)then return false end
 pressure=math.clamp(pressure,.55,1.4)
 local first,last=1,4
 if type(wheel)=='number'and wheel%1==0 and wheel&gt;=1 and wheel&lt;=4 then first=wheel;last=wheel
 elseif wheel=='front'then last=2 elseif wheel=='rear'then first=3 elseif wheel~='all'then return false end
 for i=first,last do local tyre=s.tyres[i];tyre.targetPressure=pressure;if not tyre.punctured then tyre.pressure=pressure end end
 return true
end
function D.puncture(s,wheel,car)
 equip(s,car)
 if not s.settings.damage or not s.settings.punctures or type(wheel)~='number'or wheel%1~=0 or wheel&lt;1 or wheel&gt;4 then return false end
 local t=s.tyres[wheel];local fresh=not t.punctured;t.punctured=true;t.wear=math.max(t.wear,.5);return fresh
end
-- Impact speed is the relative component into an obstacle, not vehicle speed.
-- Side -1/+1 selects left/right damage; zero is a frontal impact.
function D.impact(s,speed,side,car,severity)
 equip(s,car)
 if not finite(speed)or speed&lt;5 then return 0 end
 side=finite(side)and math.clamp(side,-1,1)or 0
 severity=finite(severity)and math.clamp(severity,.1,3)or 1
 local energy=math.clamp(((speed*.28)^2-1.9)/tune(car,'DamageEnergy')*severity,0,.95)
 s.crashes=(s.crashes or 0)+1;s.impactId=(s.impactId or 0)+1;s.impact=1;s.impactSpeed=speed;s.impactSide=side
 if not s.settings.damage then return 0 end
 s.damage=math.clamp((s.damage or 0)+energy*62,0,100)
 local h=s.health
 h.engine=math.max(.08,h.engine-energy*(math.abs(side)&lt;.3 and .75 or .28))
 h.brakes=math.max(.3,h.brakes-energy*.28);h.suspension=math.max(.18,h.suspension-energy*.7)
 h.steering=math.max(.25,h.steering-energy*.55);s.alignment=math.clamp((s.alignment or 0)+side*energy*.12,-.2,.2)
 s.engineHealth=h.engine
 if energy&gt;tune(car,'PunctureImpact')and s.settings.punctures then D.puncture(s,side&lt;0 and 1 or side&gt;0 and 2 or (s.crashes%2==0 and 1 or 2),car)end
 s.terminal=energy&gt;.82 or h.engine&lt;=.1
 return energy
end
function D.repair(s,mode,car)
 equip(s,car)
 if mode=='tyres'or mode=='all'or mode=='service'then
  for _,t in ipairs(s.tyres)do t.punctured=false;t.pressure=t.targetPressure;t.wear=0 end
 end
 if mode=='all'or mode=='service'then
  s.health={engine=1,brakes=1,suspension=1,steering=1};s.damage=0;s.alignment=0;s.terminal=false;s.engineHealth=1
 end
 s.impact=0;s.impactSpeed=0
end
local function tyreGrip(t,ambient,wetness,off,surface)
 -- Underinflation trades small loose-surface compliance against heat and damage.
 local target=surface=='tarmac'and 1 or .94
 local pressureGrip=math.clamp(1-math.abs(t.pressure-target)*.32,.65,1)
 if t.punctured then pressureGrip=math.max(.22,t.pressure*.68)end
 local optimum=surface=='tarmac'and 65 or 48
 local thermal=math.clamp(1-math.abs(t.temperature-optimum)*.0022,.72,1)
 local water=math.clamp(1-wetness*math.max(0,.95-t.pressure)*.45,.7,1)
 return pressureGrip*thermal*water*(1-t.wear*.28)
end
function D.step(s,input,route,car,dt)
 dt=math.clamp(dt,0,1/30);if dt==0 then return s end
 local p=route:point(s.z);local climate=route:conditions(s.z);equip(s,car,climate.temperature)
 local _,offset=route:ground(s.x,s.z);local off=math.abs(offset)&gt;p.width/2+1
 local mass=car.mass or 1000;local balance=car.rearShare or .5;local wb=car.wheelbase or 7.6
 local cg=car.centreOfGravityHeight or 1.8;local track=car.track or 5.6
 local transfer=math.clamp((s.acceleration or 0)*cg/(G*wb),-.18,.18)
 local frontLoad=math.clamp(1-balance-transfer,.15,.85)
 local lateralTransfer=math.clamp((s.yawRate or 0)*s.v*cg/(G*track),-.25,.25)
 local frontGrip,rearGrip=0,0;local averageGrip=0;local flatDrag,pull=0,0
 for i,t in ipairs(s.tyres)do
  local front=i&lt;=2;local right=i%2==0;local share=(front and frontLoad or 1-frontLoad)*.5
  local wheelShare=math.clamp(share+(right and lateralTransfer or -lateralTransfer)*.5,.025,.65)
  t.load=wheelShare*mass*9.81
  local staticShare=(front and 1-balance or balance)*.5
  local loadSensitivity=math.clamp((wheelShare/staticShare)^(-tune(car,'LoadSensitivity')),.82,1.14)
  if t.punctured then t.pressure=math.max(.1,t.pressure-dt*tune(car,'PressureLeak'))else t.pressure=approach(t.pressure,t.targetPressure*(273+t.temperature)/(273+climate.temperature),.2,dt)end
  t.grip=tyreGrip(t,climate.temperature,climate.wetness,off,p.surface)*loadSensitivity
  averageGrip+=t.grip*wheelShare
  if front then frontGrip+=t.grip*.5 else rearGrip+=t.grip*.5 end
  if t.punctured then flatDrag+=(1-t.pressure)*1.4;pull+=(right and 1 or -1)*(1-t.pressure)*.022 end
 end
 local grip=averageGrip*climate.friction*car.grip*(p.surface=='tarmac'and 1.22 or 1)*(off and .63 or 1)
 s.grip=grip;s.frontLoad=frontLoad;s.rearLoad=1-frontLoad
 local steering=car.steering or {};local request=math.clamp(input.steer or 0,-1,1)
 local steerRate=(request==0 and (steering.ReturnRate or 10)or (steering.Rate or 9))*(s.settings.damage and (.55+.45*s.health.steering)or 1)
 s.steer=approach(s.steer,request,steerRate,dt)
 local throttle=math.clamp(input.throttle or 0,-1,1);local brake=math.clamp(input.brake or 0,0,1)
 -- Digital throttle ramps over a fraction of a second, making keyboard exits controllable.
 s.pedal=approach(s.pedal or 0,throttle,throttle==0 and 14 or tune(car,'ThrottleResponse'),dt)
 local effectiveThrottle=s.terminal and 0 or s.pedal
 local engineFactor=s.settings.damage and (.35+.65*s.health.engine)or 1
 local accel=effectiveThrottle*car.accel*engineFactor*(1-.35*math.min(math.abs(s.v)/car.top,.94))
 local longitudinal=car.tyres and car.tyres.LongitudinalGrip or .8
 local tractionCap=grip*G*math.clamp(longitudinal/ .68,.75,1.3)
 local wheelspin=0;s.tcsActive=false
 if car.mass and car.torque then
  local ms=math.abs(s.v)*.28;local radius=(car.radius or 1.2)*.28
  local gear=math.clamp(s.gear or 1,1,#car.ratios)
  local rpm=ms/radius*car.ratios[gear]*60/(2*math.pi)
  if rpm&gt;(car.shiftRpm or 6000)and gear&lt;#car.ratios then gear+=1
  elseif rpm&lt;2200 and gear&gt;1 then gear-=1 end
  rpm=math.max(850,ms/radius*car.ratios[gear]*60/(2*math.pi));s.gear=gear;s.rpm=rpm
  local fraction=1
  if car.curve then
   fraction=car.curve[1][2]
   for i=2,#car.curve do local a,b=car.curve[i-1],car.curve[i]
    if rpm&gt;=a[1]then fraction=a[2]+(b[2]-a[2])*math.clamp((rpm-a[1])/(b[1]-a[1]),0,1)end
   end
  end
  local force=car.torque*fraction*car.ratios[gear]*.88/radius
  force=math.min(force,car.power*745.7*.88/math.max(ms,3))
  local driveFront=car.driveFront or 0
  local weight=driveFront*frontLoad+(1-driveFront)*(1-frontLoad)
  local drivenGrip=driveFront*frontGrip+(1-driveFront)*rearGrip
  local maximum=mass*9.81*weight*1.2*climate.friction*drivenGrip
  wheelspin=math.max(0,math.abs(effectiveThrottle)*force/math.max(maximum,1)-1)
  s.tcsActive=s.settings.tractionControl and wheelspin&gt;.05
  force=math.min(force,maximum)*(s.tcsActive and 1 or 1-math.min(wheelspin,.7)*.15)
  accel=effectiveThrottle*force/mass/.28*engineFactor
 end
 if throttle&lt;0 and s.v&gt;2 then accel=-58 end
 if throttle&gt;0 and s.v&lt; -2 then accel=45 end
 local drag=(.72+.0011*(car.drag and car.drag.Air/.00024 or 1)*s.v*s.v+(off and 8 or 0)+flatDrag)*(s.v&lt;0 and -1 or 1)
 if math.abs(s.v)&lt;.3 and throttle==0 then s.v=0;drag=0 end
 s.throttle=throttle;s.brake=brake;s.handbrake=input.handbrake==true
 local brakeHealth=s.settings.damage and (.4+.6*s.health.brakes)or 1
 local fade=math.clamp(1-math.max(0,s.brakeTemperature-430)/700,.45,1)
 local brakeForce=(car.brakes and car.brakes.Force or 66)*brakeHealth*fade
 s.absActive=s.settings.abs and brake*brakeForce&gt;tractionCap
 local locked=not s.settings.abs and brake*brakeForce&gt;tractionCap*1.05 and math.abs(s.v)&gt;8
 local braking=brake*math.min(brakeForce,tractionCap)*(s.v&lt;0 and -1 or 1)
 local nextV=s.v+(accel-drag-braking-p.dy*20)*dt
 if brake&gt;0 and (math.abs(s.v)&lt;1.5 or s.v*nextV&lt;0)then nextV=0 end
 s.acceleration=(nextV-s.v)/dt
 s.v=math.clamp(nextV,-23,car.top*(off and .68 or 1))
 local steerAngle=(s.steer+(s.settings.damage and (s.alignment or 0)or 0)+pull)*math.rad(steering.MaxAngle or 31)/(1+math.abs(s.v)/95)
 local response=math.clamp(frontLoad/(1-balance),.7,1.25)*math.clamp(frontGrip/math.max(rearGrip,.2),.65,1.25)
 if locked then response*=.48 end
 local yawRate=s.v/wb*math.tan(steerAngle)*response
 local demand=math.clamp(math.abs(accel-braking)/(grip*tune(car,'CorneringScale')),0,.95)
 local limit=grip*tune(car,'CorneringScale')*math.sqrt(1-demand*demand)/math.max(math.abs(s.v),10)
 local excess=yawRate-math.clamp(yawRate,-limit,limit)
 yawRate=math.clamp(yawRate,-limit,limit)+excess*.12
 local stability=s.settings.stabilityAssist
 local slideRate=input.handbrake and 2.1 or (4+2*stability)*grip
 local slideTarget=excess*math.abs(s.v)*.22*(1.25-.5*stability)
 s.lateralV=approach(s.lateralV,slideTarget,slideRate,dt)
 s.lateralV+=climate.wind*.002*dt
 if input.handbrake then yawRate*=1.2;s.v*=math.exp(-.65*dt)end
 -- Countersteer assist damps a developing slide without steering along the route.
 local assist=s.settings.steeringAssist
 yawRate+=math.clamp(s.lateralV/math.max(math.abs(s.v),10),-.2,.2)*assist*.12
 s.yawRate=yawRate;s.yaw=wrap(s.yaw-yawRate*dt)
 local forwardX,forwardZ=math.sin(s.yaw),math.cos(s.yaw)
 s.x+=(forwardX*s.v+forwardZ*s.lateralV)*dt
 local advance=(forwardZ*s.v-forwardX*s.lateralV)*dt
 if route.original then
  advance/=math.clamp(1-p.curvature*s.x,.5,1.5)
  s.yaw=wrap(s.yaw-p.curvature*advance)
 end
 s.z+=advance
 local _,lateral,newPoint=route:ground(s.x,s.z)
 s.impact=math.max(0,(s.impact or 0)-dt*2)
 local barrier=newPoint.bridge or newPoint.tunnel;local bound=newPoint.width/2-3.1
 if barrier and math.abs(lateral)&gt;bound then
  local sign=lateral&lt;0 and -1 or 1
  s.x=newPoint.x+sign*bound*math.sqrt(1+newPoint.dx*newPoint.dx)
  local relative=wrap(s.yaw-newPoint.heading)
  local hit=math.abs(math.sin(relative)*s.v)+math.abs(s.lateralV)
  if hit&gt;5 and s.impact&lt;=0 then D.impact(s,hit,sign,car)end
  s.yaw=approach(s.yaw,newPoint.heading,.8,dt);s.lateralV=0;s.v*=math.exp(-2*dt)
 elseif math.abs(lateral)&gt;newPoint.width/2+14 then s.v*=math.exp(-1.8*dt)end
 local ty,pt,rl=D.contactPose(s,route,car)
 local suspension=car.suspension or {};local travel=suspension.Travel or 1.2
 local springHealth=s.settings.damage and s.health.suspension or 1
 local omega=tune(car,'BodyFrequency')/(1+travel*.3)*(.8+.2*springHealth)
 local bump=suspension.Bump or .4;local rebound=suspension.Rebound or .55
 s.bodyY=s.bodyY or ty;s.bodyV=s.bodyV or 0
 local compression=ty-s.bodyY
 local damping=math.clamp((compression&gt;0 and bump or rebound)*1.7,.35,1.3)
 local stop=math.max(0,compression-travel*(suspension.BumpStopFrom or .88))*(suspension.BumpStopRate or 6)
 s.bodyV+=(omega*omega*compression+stop-2*damping*omega*s.bodyV)*dt
 s.bodyY=math.clamp(s.bodyY+s.bodyV*dt,ty-travel*.4,ty+travel*.65)
 s.pitch=approach(s.pitch or pt,pt+math.clamp((accel-braking)*.0006,-.06,.06),omega,dt)
 local antiroll=suspension.AntiRoll or {};local rollSupport=((antiroll.Front or .5)+(antiroll.Rear or .5))*.5
 s.roll=approach(s.roll or rl,rl+math.clamp(yawRate*s.v*.0007*(1.25-rollSupport*.5),-.09,.09),omega,dt)
 local tyreTemp=0;local speed=math.abs(s.v)
 for i,t in ipairs(s.tyres)do
  local drive=i&lt;=2 and (car.driveFront or 0)or 1-(car.driveFront or 0)
  t.slip=math.abs(excess)*speed*.06+wheelspin*drive+(locked and brake or 0)+(input.handbrake and i&gt;2 and .6 or 0)
  local heat=climate.temperature+speed*.28+t.slip*35+(1-t.pressure)*speed*.8
  t.temperature=approach(t.temperature,math.min(180,heat),tune(car,'TyreHeatRate')+(climate.wetness or 0)*.1,dt)
  t.compression=math.clamp(.5+compression/math.max(travel,.1),0,1)
  if s.settings.damage then
   t.wear=math.clamp(t.wear+dt*tune(car,'WearRate')*(speed*.0000015+t.slip*.00015)*(1+math.max(0,t.temperature-100)*.02),0,1)
   -- Repeated fast rough-shoulder abuse and worn tyres cause deterministic leaks.
   t.stress=(t.stress or 0)+dt*(off and speed&gt;55 and (speed-55)*.003*(1.5-t.pressure)or -.3)
   t.stress=math.max(0,t.stress)
   if s.settings.punctures and (t.stress&gt;7+i*.4 or t.wear&gt;.985)then D.puncture(s,i,car)end
  end
  tyreTemp+=t.temperature*.25
 end
 s.tyreTemperature=tyreTemp;s.brakeTemperature=approach(s.brakeTemperature,climate.temperature+brake*speed*6,.08,dt)
 s.engineTemperature=approach(s.engineTemperature,78+math.abs(effectiveThrottle)*20+math.max(0,1-s.health.engine)*35,.035,dt)
 s.distance+=speed*dt
 return s
end
function D.telemetry(s)
 equip(s)
 local flats=0;local minPressure=2;local wear=0
 for _,t in ipairs(s.tyres)do if t.punctured then flats+=1 end;minPressure=math.min(minPressure,t.pressure);wear=math.max(wear,t.wear)end
 return {punctures=flats,pressure=minPressure,wear=wear,temperature=s.tyreTemperature or 20,engine=s.health.engine,brakes=s.health.brakes,suspension=s.health.suspension,steering=s.health.steering,terminal=s.terminal==true,grip=s.grip or 1}
end
function D.contactPose(s,route,car)
 local wb=car and car.wheelbase or 7.6;local rearShare=car and car.rearShare or .5
 local fX,fZ=math.sin(s.yaw),math.cos(s.yaw)
 local frontArm=wb*rearShare;local backArm=wb*(1-rearShare)
 local front=route:ground(s.x+fX*frontArm,s.z+fZ*frontArm)
 local back=route:ground(s.x-fX*backArm,s.z-fZ*backArm)
 local track=car and car.track or 5.6
 local left=route:ground(s.x+fZ*track*.5,s.z-fX*track*.5)
 local right=route:ground(s.x-fZ*track*.5,s.z+fX*track*.5)
 if s.tyres then
  local radius=(car and car.radius or 1.2)*.42
  local a=math.max(0,1-s.tyres[1].pressure)*radius;local b=math.max(0,1-s.tyres[2].pressure)*radius
  local c=math.max(0,1-s.tyres[3].pressure)*radius;local d=math.max(0,1-s.tyres[4].pressure)*radius
  front-=(a+b)*.5;back-=(c+d)*.5;left-=(a+c)*.5;right-=(b+d)*.5
 end
 return front*(1-rearShare)+back*rearShare+(car and car.rideHeight or 2.2),math.atan2(front-back,wb),math.atan2(right-left,track)
end
function D.pose(s,route,car)
 if s.bodyY then return s.bodyY,s.pitch or 0,s.roll or 0 end
 return D.contactPose(s,route,car)
end
function D.reset(s,route,z)
 local p=route:point(z);s.x=p.x;s.z=z;s.yaw=p.heading;s.v=0;s.lateralV=0;s.steer=0;s.impact=0;s.bodyY=nil;s.bodyV=0;s.pitch=nil;s.roll=nil;s.acceleration=0;s.yawRate=0;s.pedal=0
end
return D
</ProtectedString>
