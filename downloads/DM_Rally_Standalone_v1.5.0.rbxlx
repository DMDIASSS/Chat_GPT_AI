      <Item class="ModuleScript" referent="RBX00000022">
        <Properties>
          <string name="Name">LegacyProfiles</string>
          <ProtectedString name="Source">-- Offline compatibility for the exported client, not the original game's backend.
-- Only fresh defaults from its own SaveStructure are used; no entitlements or remote data.
local Bridge={}
local function copy(value)
 if type(value)~='table'then return value end
 local result={};for key,item in pairs(value)do result[key]=copy(item)end;return result
end
function Bridge.start()
 local rs=game:GetService('ReplicatedStorage');local shared=rs:FindFirstChild('Shared')
 local structure=shared and shared:FindFirstChild('SaveStructure')
 if not structure then return nil end
 local defaults=require(structure).NotIncludingData
 assert(type(defaults)=='table'and type(defaults.Settings)=='table','Invalid exported SaveStructure')
 local players=game:GetService('Players')
 local folder=rs:FindFirstChild('RemoteEvents')
 if not folder then folder=Instance.new('Folder');folder.Name='RemoteEvents';folder.Parent=rs end
 local function remote(parent,name,class)
  local result=parent:FindFirstChild(name)
  if result then assert(result:IsA(class),'Conflicting legacy remote '..name);return result end
  result=Instance.new(class);result.Name=name;result.Parent=parent;return result
 end
 local names={'ReplicaRequestData','ReplicaSet','ReplicaSetValues','ReplicaTableInsert','ReplicaTableRemove',
  'ReplicaWrite','ReplicaSignal','ReplicaParent','ReplicaCreate','ReplicaBind','ReplicaDestroy'}
 local events={};for _,name in ipairs(names)do events[name]=remote(folder,name,'RemoteEvent')end
 remote(folder,'ReplicaSignalUnreliable','UnreliableRemoteEvent')
 local profiles,ids,sent,connections,requestAt={},{},{},{},{};local serial=0
 local function publish(player,key,value)
  if sent[player]then events.ReplicaSet:FireClient(player,ids[player],{'Settings',key},value)end
 end
 local function ensure(player)
  if profiles[player]then return profiles[player]end
  serial+=1;ids[player]=serial;local data=copy(defaults);profiles[player]=data;connections[player]={}
  local settings=player:FindFirstChild('Settings')
  if not settings then settings=Instance.new('Folder');settings.Name='Settings';settings.Parent=player end
  for key,value in pairs(data.Settings)do
   local class=type(value)=='boolean'and 'BoolValue'or(type(value)=='number'and 'NumberValue'or 'StringValue')
   local item=settings:FindFirstChild(key)
   if not item then item=Instance.new(class);item.Name=key;item.Value=value;item.Parent=settings
   elseif item:IsA(class)and type(item.Value)==type(value)then data.Settings[key]=item.Value end
   if item:IsA(class)then connections[player][#connections[player]+1]=item:GetPropertyChangedSignal('Value'):Connect(function()
    data.Settings[key]=item.Value;publish(player,key,item.Value)
   end)end
  end
  settings:SetAttribute('SessionOnlyCompatibility',true)
  return data
 end
 local request=events.ReplicaRequestData
 request.OnServerEvent:Connect(function(player)
  local now=os.clock();if now-(requestAt[player]or -math.huge)&lt;.5 then return end;requestAt[player]=now
  local data=ensure(player)
  if not sent[player]then
   events.ReplicaCreate:FireClient(player,{[tostring(ids[player])]={'PlayerProfile',{Player=player,SessionOnly=true},data,0}})
   sent[player]=true
  end
  request:FireClient(player)
 end)
 local util=shared:FindFirstChild('RBXUtil');local net=util and util:FindFirstChild('Net')
 if net then
  local option=remote(net,'RE/SetOptionRE','RemoteEvent')
  option.OnServerEvent:Connect(function(player,key,value)
   local initial=type(key)=='string'and defaults.Settings[key]
   if initial==nil or type(value)~=type(initial)then return end
   if type(value)=='number'then
    if value~=value or math.abs(value)&gt;1e6 then return end
    if key=='GraphicsQuality'then value=math.clamp(math.floor(value),1,4)
    elseif key:find('Volume',1,true)then value=math.clamp(value,0,1)
    else value=math.clamp(value,0,10)end
   end
   ensure(player);local item=player.Settings:FindFirstChild(key)
   if item then item.Value=value end
  end)
 end
 players.PlayerAdded:Connect(ensure)
 players.PlayerRemoving:Connect(function(player)
  for _,connection in ipairs(connections[player]or {})do connection:Disconnect()end
  profiles[player]=nil;ids[player]=nil;sent[player]=nil;connections[player]=nil;requestAt[player]=nil
 end)
 for _,player in ipairs(players:GetPlayers())do ensure(player)end
 return {get=function(player)return profiles[player]end,events=events}
end
return Bridge
</ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX00000023">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source">local Players=game:GetService('Players')
local ReplicatedStorage=game:GetService('ReplicatedStorage')
local RunService=game:GetService('RunService')
local Workspace=game:GetService('Workspace')
local root=ReplicatedStorage:WaitForChild('BackseatExpedition')
local compatOK,compatError=pcall(function()require(script.Parent.LegacyProfiles).start()end)
if not compatOK then warn('Export compatibility: '..tostring(compatError))end
local C=require(root.Shared.Config);local Route=require(root.Shared.Route)
local OriginalCourse=require(root.Shared.OriginalCourse)
local defaultCourse=C.UseOriginalStages and OriginalCourse.default(C)
if defaultCourse then root:SetAttribute('OriginalStage',defaultCourse.stageId)end
local D=require(root.Shared.Dynamics);local Replay=require(root.Shared.Replay)
local Persistence=require(script.Parent.Persistence);local storage=Persistence.new(C)
local Assets=require(root.Shared.Assets)
local remotes=root.Remotes;local action=remotes.Action;local request=remotes.Request;local stateEvent=remotes.State;local inputEvent=remotes.Input
local runs,viewing,slots={}, {}, {};local ending=0;local returnPoints={};local returnFocus={};local races
local Preferences=require(root.Shared.Preferences);local RaceSession=require(script.Parent.RaceSession)
local function getCar(id)for _,car in ipairs(C.Cars)do if car.id==id then return car end end;return C.Cars[1]end
local function getMode(id)for _,mode in ipairs(C.Modes)do if mode.id==id then return mode end end;return C.Modes[1]end
local function tell(player,kind,data)if player and player.Parent then action:FireClient(player,kind,data)end end
local function participants(run)
 local out={run.player};if run.passenger and run.passenger.Parent then table.insert(out,run.passenger)end;return out
end
local function broadcastRun(run,kind,data)for _,p in ipairs(participants(run))do tell(p,kind,data)end end
local function origin(run)if run.route.original then return Vector3.zero end;return Vector3.new(C.WorldX+run.slot*C.LaneSpacing,0,-math.floor(run.s.z/4096)*4096)end
local function worldFrame(run)
 local y,pitch,roll=D.pose(run.s,run.route,run.car)
 if run.route.original then return run.route:frame(run.s,Vector3.zero,y,pitch,roll)end
 return CFrame.new(Vector3.new(run.s.x,y,run.s.z)+origin(run))*CFrame.Angles(0,math.pi+run.s.yaw,0)*CFrame.Angles(pitch,0,roll)
end
local function seatPlayer(player,seat)
 local character=player.Character;local humanoid=character and character:FindFirstChildOfClass('Humanoid')
 if humanoid then character:PivotTo(seat.CFrame*CFrame.new(0,3,0));seat:Sit(humanoid)end
end
local function rememberReturn(player)
 if not returnFocus[player]then returnFocus[player]={part=player.ReplicationFocus}end
 if not returnPoints[player]and player.Character then returnPoints[player]=player.Character:GetPivot()end
end
local function returnLobby(player)
 viewing[player]=nil
 if returnFocus[player]then player.ReplicationFocus=returnFocus[player].part;returnFocus[player]=nil end
 local character=player.Character;local h=character and character:FindFirstChildOfClass('Humanoid')
 if h then h.Sit=false;h.Jump=true end
 local target=returnPoints[player];returnPoints[player]=nil
 task.delay(.15,function()if target and character and character.Parent and not runs[player]and not viewing[player]then character:PivotTo(target)end end)
end
local function packet(run)
 return {id=run.record.meta.id,owner=run.player.UserId,name=run.player.DisplayName,mode=run.mode.id,seed=run.route.seed,length=run.route.length,
  stage=run.route.stageId,stageName=run.route.name,incomplete=run.route.incomplete,car=run.car.id,slot=run.slot,s=D.copy(run.s),clock=run.clock,penalty=run.penalty,nextGate=run.nextGate,
  missed=run.missed or false,status=run.status,originZ=origin(run).Z,course=run.record.meta.course,
  race=run.race,settings=run.settings,passenger=run.passenger and run.passenger.UserId or 0,ghost=run.ghost and run.ghost.id or nil,recording=not run.record.failed}
end
local function recordFrame(run,flag)
 local f=Replay.frame(run.clock+run.penalty,run.s,flag,run.input);local frames=run.frames
 frames[#frames+1]=f
 if #frames&gt;=C.ReplayPage then storage:page(run.record,Replay.encode(frames),frames);run.frames={}end
end
local function finish(run,reason)
 if runs[run.player]~=run then return end
 recordFrame(run)
 if races and run.race then races:update(run.player,run.validZ,run.clock+run.penalty,reason=='finish',reason~='finish'and reason or nil)end
 runs[run.player]=nil;slots[run.slot]=nil;ending+=1
 if #run.frames&gt;0 then storage:page(run.record,Replay.encode(run.frames),run.frames);run.frames={}end
 local meta=run.record.meta;meta.duration=run.clock+run.penalty;meta.penalty=run.penalty
 meta.completed=reason=='finish';meta.banked=reason=='bank';meta.reason=reason
 meta.distance=run.s.distance;meta.progress=run.missed and run.lastGate or run.validZ;meta.crashes=run.s.crashes
 local reward=meta.completed and run.mode.xp or (meta.banked and math.floor(run.validZ/128)or 0)
 if meta.completed and run.s.crashes==0 then reward+=50;meta.cleanBonus=50 end
 meta.reward=reward
 local members=participants(run)
 for _,p in ipairs(members)do
  returnLobby(p);tell(p,'result',meta)
 end
 run.model:Destroy()
 storage:finish(run.record,reward,function(userId,record,status)
  local p=Players:GetPlayerByUserId(userId);tell(p,'saved',{id=record.id,status=status,saved=record.saved})
 end)
 task.spawn(function()local deadline=os.clock()+22;while not run.record.done and os.clock()&lt;deadline do task.wait(.1)end;ending-=1 end)
end
local function start(player,data,raceId)
 if runs[player]or viewing[player]then return nil end
 local car=getCar(data.car);local profile=storage:load(player.UserId)
 if profile.xp&lt;car.unlock then tell(player,'notice','This car unlocks at '..car.unlock..' XP.');return end
 if profile.loading and car.unlock&gt;0 then tell(player,'notice','Loading your unlocked cars; try again in a moment.');return end
 local numeric=tonumber(data.seed);if not numeric or numeric~=numeric or math.abs(numeric)&gt;1e12 then numeric=math.random(1,999999999)end
 local mode=getMode(data.mode);local seed=math.floor(numeric)%1000000000
 if mode.id=='daily'then seed=math.floor(os.time()/86400)end
 local slot
 for i=1,C.MaxPlayers do if not slots[i]then slot=i;break end end
 if not slot then tell(player,'notice','All rally slots are in use. Join a co-driver seat or try again shortly.');return end
 local settings=Preferences.sanitize({values=data.settings}).values
 local route=(C.UseOriginalStages and data.map~='generated'and OriginalCourse.default(C,seed))or Route.new(seed,mode.length,C)
 local length=route.length
 local run={race=raceId,settings=settings,player=player,route=route,car=car,mode=mode,slot=slot,s=D.new(route),clock=0,penalty=0,nextGate=C.Checkpoint,
  lastGate=0,validZ=0,status='loading',frames={},sample=0,input={throttle=0,steer=0,brake=1},lastInput=0,seq=-1,created=os.clock(),recoverAt=-100}
 D.configure(run.s,settings)
 if length&gt;0 then run.nextGate=math.min(run.nextGate,length)end
 run.record=storage:newRecording(player.UserId,{seed=seed,length=length,stage=route.stageId,stageName=route.name,mode=mode.id,car=car.id,course=route:key(mode.id,car.id)..':'..(settings.damage and 'damage'or 'clean')..':'..(settings.assists and 'assist'or 'raw'),setup=settings,generation=C.Generation,weather=mode.weather})
 for _,best in ipairs(profile.bests)do if best.course==run.record.meta.course then run.ghost=best;break end end
 local model=Instance.new('Model');model.Name='Rally_'..player.UserId
 local body=Instance.new('Part');body.Name='Root';body.Size=Vector3.new(6,2,10);body.Transparency=1;body.Anchored=true;body.CanCollide=false;body.Parent=model;model.PrimaryPart=body
 local serverVisual=Assets.car(model,car,false,false,false);serverVisual.model.Name='NativeCar';run.serverVisual=serverVisual
 model:SetAttribute('ExpeditionCar',true)
 for i,name in ipairs({'Driver','CoDriver'})do
  local seat=Instance.new('Seat');seat.Name=name;seat.Size=Vector3.new(2,1,2);seat.Transparency=1;seat.Anchored=true;seat.CanCollide=false
  seat.CFrame=CFrame.new(i==1 and -1.3 or 1.3,.25,0);seat.Parent=model
 end
 model.Parent=Workspace;run.model=model
 if route.original and Workspace.Blockcast then
  local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.RespectCanCollide=true
  local excluded={model};if player.Character then excluded[#excluded+1]=player.Character end
  local world=Workspace:FindFirstChild('World');local stage=world and world:FindFirstChild('Stage_'..route.stageId);local collision=stage and stage:FindFirstChild('Collision')
  if collision then excluded[#excluded+1]=collision end
  params.FilterDescendantsInstances=excluded;run.castParams=params
 end
 model:PivotTo(worldFrame(run));runs[player]=run;slots[slot]=run
 rememberReturn(player);player.ReplicationFocus=body;seatPlayer(player,model.Driver);tell(player,'start',packet(run));recordFrame(run)
 return run
end
races=RaceSession.new({
 notify=tell,active=function(player)return runs[player]or viewing[player]end,
 launch=start,
 validate=function(player,data)
  local car=getCar(data.car);local profile=storage:load(player.UserId)
  if profile.xp&lt;car.unlock then return false,player.DisplayName..' has not unlocked that car.'end
  return true
 end,
 cancel=function(player,raceId)
  local r=runs[player]
  if r and r.race==raceId then runs[player]=nil;slots[r.slot]=nil;r.model:Destroy();returnLobby(player);tell(player,'lobby',{})end
 end,
 countdown=function(members,raceId)
  local untilTime=os.clock()+3
  for _,p in ipairs(members)do local r=runs[p];if r and r.race==raceId then
   r.status='countdown';r.countUntil=untilTime;broadcastRun(r,'countdown',3)
  end end
 end,
})
local lastAction={}
action.OnServerEvent:Connect(function(player,kind,data)
 if type(kind)~='string'then return end
 local now=os.clock();if kind~='ready'and kind~='retire'and kind~='leave'and kind~='preferences'and now-(lastAction[player]or -math.huge)&lt;.12 then return end;lastAction[player]=now
 data=type(data)=='table'and data or {};local run=runs[player]
 if kind=='preferences'then storage:setPreferences(player.UserId,Preferences.sanitize(data))
 elseif kind:sub(1,4)=='race'then
  local verb=kind:sub(5):lower();races:action(player,verb,data)
 elseif kind=='start'then if not runs[player]and not viewing[player]then races:remove(player);start(player,data)end
 elseif kind=='ready'and run and run.status=='loading'then
  if run.race then races:loaded(player)else run.status='countdown';run.countUntil=now+3;broadcastRun(run,'countdown',3)end
 elseif kind=='retire'and run then finish(run,run.mode.id=='endless'and 'bank'or 'retired')
 elseif kind=='recover'and run and now-run.recoverAt&gt;3 and run.status=='running'then
  run.recoverAt=now;run.penalty+=5;D.reset(run.s,run.route,run.lastGate);run.missed=false;recordFrame(run,1);broadcastRun(run,'notice','Recovered to checkpoint · +5 seconds')
 elseif kind=='service'and run and run.status=='running'then
  local near=run.s.z&lt;80 or math.abs(run.s.z-run.lastGate)&lt;85
  if math.abs(run.s.v)&gt;1.5 then tell(player,'notice','Stop the car before servicing.')
  elseif not near then tell(player,'notice','Service is available at the start and checkpoint bays.')
  elseif now-(run.serviceAt or -100)&gt;5 then
   run.serviceAt=now;run.penalty+=15;D.repair(run.s,'all',run.car)
   local pressure=Preferences.value('tyrePressure',data.pressure)
   D.setPressure(run.s,'all',pressure,run.car);recordFrame(run,1)
   broadcastRun(run,'notice','Full service · tyres replaced and car repaired · +15 seconds')
  end
 elseif kind=='bookmark'and run then
  local markers=run.record.meta.markers;if #markers&lt;32 then markers[#markers+1]=run.clock+run.penalty end;tell(player,'notice','Replay moment marked')
 elseif kind=='join'then
  if run or viewing[player]then return end
  local host=Players:GetPlayerByUserId(tonumber(data.owner)or 0);local target=host and runs[host]
  if target and not target.passenger then
   rememberReturn(player);target.passenger=player;viewing[player]=target
   if not table.find(target.record.meta.access,player.UserId)then table.insert(target.record.meta.access,player.UserId)end
   if target.castParams and player.Character then local excluded=target.castParams.FilterDescendantsInstances;excluded[#excluded+1]=player.Character;target.castParams.FilterDescendantsInstances=excluded end
   player.ReplicationFocus=target.model.Root;seatPlayer(player,target.model.CoDriver);tell(player,'start',packet(target));tell(host,'notice',player.DisplayName..' joined as co-driver')
  end
 elseif kind=='leave'and viewing[player]then
  local target=viewing[player];target.passenger=nil;returnLobby(player);tell(player,'lobby',{})
 elseif kind=='call'and viewing[player]then
  local allowed={left=true,right=true,caution=true}
  if allowed[data.note]then
   local target=viewing[player];local note=data.note=='caution'and 'CAUTION · co-driver'or target.route:call(target.s.z,target.s.v)
   tell(target.player,'notice',note..' · '..player.DisplayName)
  end
 end
end)
inputEvent.OnServerEvent:Connect(function(player,data)
 local run=runs[player];if not run or type(data)~='table'then return end
 if type(data.seq)~='number'or data.seq%1~=0 or data.seq&lt;=run.seq then return end
 local function unit(n)if type(n)~='number'or n~=n then return 0 end;return math.clamp(n,-1,1)end
 run.seq=data.seq;run.lastInput=os.clock()
 run.input={throttle=unit(data.throttle),steer=unit(data.steer),brake=math.max(0,unit(data.brake)),handbrake=data.handbrake==true}
end)
local requestAt={}
request.OnServerInvoke=function(player,kind,data)
 local now=os.clock();if now-(requestAt[player]or -math.huge)&lt;.12 then return {error='Please wait a moment'}end;requestAt[player]=now
 if kind=='preferences'then
  local profile=storage:load(player.UserId);local deadline=os.clock()+4
  while profile.loading and os.clock()&lt;deadline do task.wait(.1)end
  return {snapshot=Preferences.sanitize(profile.preferences),sessionOnly=not storage.profiles}
 elseif kind=='library'then return storage:library(player.UserId)
 elseif kind=='replay'then
  local id=type(data)=='table'and data.id;local r=storage:find(player.UserId,id)
  if not r then return {error='Replay unavailable'}end
  return {record=r}
 elseif kind=='page'then
  if type(data)~='table'then return {error='Invalid request'}end
  local text,reason=storage:getPage(player.UserId,data.id,data.index);return text and {text=text}or {error=reason}
 elseif kind=='lobby'then
  local open={};for _,r in pairs(runs)do if not r.passenger then table.insert(open,{owner=r.player.UserId,name=r.player.DisplayName,mode=r.mode.name})end end
  return {drivers=open,races=races:lobby(),race=races:forPlayer(player),library=storage:library(player.UserId)}
 end
 return {error='Unknown request'}
end
local accumulated,network=0,0
RunService.Heartbeat:Connect(function(dt)
 accumulated=math.min(accumulated+dt,.15);local steps=0
 while accumulated&gt;=C.Step and steps&lt;5 do
  accumulated-=C.Step;steps+=1
  for _,run in pairs(runs)do
   if run.status=='loading'and os.clock()-run.created&gt;45 then finish(run,'loading cancelled')
   elseif run.status=='countdown'then
    if os.clock()&gt;=run.countUntil then run.status='running';broadcastRun(run,'go',{})end
   elseif run.status=='running'then
    local input=os.clock()-run.lastInput&lt;.6 and run.input or {throttle=0,steer=0,brake=.5}
    local previous,before
    if run.castParams then previous={x=run.s.x,z=run.s.z,yaw=run.s.yaw,bodyY=run.s.bodyY,pitch=run.s.pitch,roll=run.s.roll};before=worldFrame(run)end
    D.step(run.s,input,run.route,run.car,C.Step);run.clock+=C.Step
    if before then
     local target=worldFrame(run);local delta=target.Position-before.Position
     if delta.Magnitude&gt;.0001 then
      local hit=Workspace:Blockcast(before,Vector3.new(run.car.track or 5.6,1.3,run.car.wheelbase+1),delta,run.castParams)
      if hit then
       local impact=math.abs(delta.Unit:Dot(hit.Normal))*math.abs(run.s.v)
       if (run.s.impact or 0)&lt;=0 then D.impact(run.s,impact,0,run.car)end
       for _,key in ipairs({'x','z','yaw','bodyY','pitch','roll'})do run.s[key]=previous[key]end
       run.s.v*=.12;run.s.lateralV=0
      end
     end
    end
    local p=run.route:point(run.s.z);local lateral=math.abs((run.s.x-p.x)/math.sqrt(1+p.dx*p.dx))
    if not run.missed and run.s.z&gt;=run.nextGate and run.s.z&lt;run.nextGate+30 and lateral&lt;p.width/2+2 then
     run.lastGate=run.nextGate;run.validZ=run.lastGate
     if run.route.length&gt;0 and run.lastGate&gt;=run.route.length then finish(run,run.mode.id=='endless'and 'bank'or 'finish')
     else
      run.nextGate=run.lastGate+C.Checkpoint
      if run.route.length&gt;0 then run.nextGate=math.min(run.nextGate,run.route.length)end
      broadcastRun(run,'checkpoint',{z=run.lastGate,time=run.clock+run.penalty})
     end
    elseif run.s.z&gt;run.nextGate+30 then run.missed=true end
    if not run.missed and lateral&lt;p.width/2+3 then run.validZ=math.max(run.validZ,run.s.z)end
    if runs[run.player]==run then
    if run.race then races:update(run.player,run.validZ,run.clock+run.penalty,false)end
    run.sample+=C.Step
    if run.sample&gt;=1/C.ReplayRate then run.sample-=1/C.ReplayRate;recordFrame(run)end
    end
   end
  end
 end
 network+=dt
 if network&gt;=1/C.StateRate then
  network=0;local nearby={}
  for _,run in pairs(runs)do
   run.model:PivotTo(worldFrame(run));Assets.pose(run.serverVisual,run.s,run.route,origin(run),1/C.StateRate);if run.route.original then
    local pose={};for _,key in ipairs({'x','z','yaw','v','steer','bodyY','pitch','roll'})do pose[key]=run.s[key]end
    nearby[#nearby+1]={owner=run.player.UserId,car=run.car.id,stage=run.route.stageId,s=pose}
   end
   if not run.model.Driver.Occupant and os.clock()-run.created&gt;2 then seatPlayer(run.player,run.model.Driver)end
  end
  for _,run in pairs(runs)do for _,p in ipairs(participants(run))do stateEvent:FireClient(p,{time=Workspace:GetServerTimeNow(),runs={packet(run)},nearby=nearby})end end
 end
end)
Players.PlayerAdded:Connect(function(player)storage:load(player.UserId)end)
Players.PlayerRemoving:Connect(function(player)
 task.spawn(function()storage:flushPreferences(player.UserId)end)
 if runs[player]then finish(runs[player],runs[player].mode.id=='endless'and 'bank'or 'disconnected')end
 if viewing[player]then viewing[player].passenger=nil;viewing[player]=nil end
 races:remove(player)
 lastAction[player]=nil;requestAt[player]=nil
end)
for _,p in ipairs(Players:GetPlayers())do storage:load(p.UserId)end
game:BindToClose(function()
 local pending=0
 for userId in pairs(storage.users)do pending+=1;task.spawn(function()storage:flushPreferences(userId);pending-=1 end)end
 local list={};for _,run in pairs(runs)do list[#list+1]=run end
 for _,run in ipairs(list)do finish(run,run.mode.id=='endless'and 'bank'or 'server closed')end
 local untilTime=os.clock()+25;while (ending&gt;0 or pending&gt;0)and os.clock()&lt;untilTime do task.wait(.1)end
end)
-- Reuse visual templates in the expansion namespace without changing the source assets.
task.spawn(function()
 if not C.ImportedVisuals and not C.ExternalAudio then return end
 local ok,reason=pcall(function()require(root.Shared.ImportAssets).harvest(root)end)
 if not ok then warn('Optional original visual templates unavailable: '..tostring(reason))end
end)
root:SetAttribute('ServerReady',true)
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000024">
        <Properties>
          <string name="Name">Persistence</string>
          <ProtectedString name="Source">-- Immutable replay pages + small manifests. No DataStore work on the simulation thread.
local DataStoreService=game:GetService('DataStoreService')
local HttpService=game:GetService('HttpService')
local P={};P.__index=P
local function fresh()return {version=1,xp=0,records={},bests={},applied={}}end
function P.new(config)
 local self=setmetatable({config=config,users={},cache={},order={},status={},warned=false},P)
 -- Opening a downloaded place is valid. Storage must never abort server startup.
 if game.GameId~=0 then
  local ok,profiles,replays=pcall(function()
   return DataStoreService:GetDataStore('BRExpeditionProfiles_v1'),DataStoreService:GetDataStore('BRExpeditionReplays_v1')
  end)
  if ok then self.profiles=profiles;self.replays=replays end
 end
 return self
end
function P:request(store,method,key,value)
 if not store then return false,'Session only'end
 local last
 for attempt=1,3 do
  local ok,result=pcall(function()
   if method=='GetAsync'then return store:GetAsync(key)end
   return store:UpdateAsync(key,function()return value end)
  end)
  if ok then return true,result end
  last=tostring(result)
  if not self.warned then self.warned=true;warn('Expedition storage unavailable; replays stay in this server until storage recovers.')end
  task.wait(math.min(2,attempt*.5))
 end
 return false,last
end
function P:load(userId)
 if self.users[userId]then return self.users[userId]end
 local profile=fresh();profile.loading=true;self.users[userId]=profile;self.status[userId]='Loading save…'
 if not self.profiles then
  profile.loading=false;self.status[userId]='Session only · ready to drive';return profile
 end
 task.spawn(function()
  local ok,data=self:request(self.profiles,'GetAsync','u:'..userId)
  if ok and type(data)=='table'and data.version==1 then
   if not profile.preferences then profile.preferences=data.preferences end
   profile.xp=tonumber(data.xp)or 0;profile.records=data.records or {};profile.bests=data.bests or {};profile.applied=data.applied or {}
  end
  profile.loading=false
  self.status[userId]=ok and 'Cloud save ready'or 'Session only · enable Studio API access for cloud saves'
 end)
 return profile
end
function P:flushPreferences(userId)
 local profile=self.users[userId]
 if not profile or not profile.preferences or not self.profiles then return true end
 local snapshot=profile.preferences
 local ok=pcall(function()self.profiles:UpdateAsync('u:'..userId,function(old)
  old=type(old)=='table'and old.version==1 and old or fresh();old.preferences=snapshot;return old
 end)end)
 if not ok then self.status[userId]='Session only · settings save was not confirmed'end
 return ok
end
function P:setPreferences(userId,snapshot)
 local profile=self:load(userId);profile.preferences=snapshot
 self.pendingPreferences=self.pendingPreferences or {}
 if self.pendingPreferences[userId]then return end
 self.pendingPreferences[userId]=true
 -- One queued task per player, even if a slider generates many changes.
 task.delay(2,function()
  self.pendingPreferences[userId]=nil;self:flushPreferences(userId)
 end)
end
function P:remember(key,text)
 self.cache[key]=text;table.insert(self.order,key)
 while #self.order&gt;80 do local old=table.remove(self.order,1);self.cache[old]=nil end
end
function P:newRecording(userId,metadata)
 metadata.id=HttpService:GenerateGUID(false);metadata.owner=userId;metadata.pages={};metadata.created=os.time()
 metadata.access={userId};metadata.markers={};metadata.saved=false;metadata.startTime=0
 return {meta=metadata,pending=0,failed=false,finished=false}
end
function P:page(record,text,frames)
 local meta=record.meta;local index=#meta.pages+1;local key='r:'..meta.id..':'..index
 local desc={index=index,from=frames[1][1]/1000,to=frames[#frames][1]/1000,count=#frames,key=key,saved=false}
 meta.pages[index]=desc;self:remember(key,text)
 if record.pending&gt;=self.config.ReplayPending then
  record.failed=true;meta.partial=true;return
 end
 record.pending+=1
 task.spawn(function()
  local ok=self:request(self.replays,'UpdateAsync',key,text)
  desc.saved=ok;record.failed=record.failed or not ok;record.pending-=1
 end)
end
local function add(profile,meta,reward,config,durableOnly)
 local applied=profile.applied or {};profile.applied=applied
 if table.find(applied,meta.id)then return profile end
 table.insert(applied,meta.id);while #applied&gt;32 do table.remove(applied,1)end
 profile.xp=math.max(0,tonumber(profile.xp)or 0)+reward
 if durableOnly and not meta.saved then return profile end
 local records=profile.records or {};profile.records=records
 table.insert(records,1,meta);while #records&gt;config.LibrarySize do table.remove(records)end
 local bests=profile.bests or {};profile.bests=bests
 if meta.completed or meta.banked then
  local found
  for i,b in ipairs(bests)do if b.course==meta.course then found=i;break end end
  local previous=found and bests[found]
  local faster=not previous or meta.duration&lt;previous.duration
  local farther=not previous or (meta.progress or 0)&gt;(previous.progress or 0)
  if not previous or (meta.banked and farther)or (not meta.banked and faster)then
   if found then table.remove(bests,found)end
   table.insert(bests,1,meta)
  end
  while #bests&gt;config.BestSize do table.remove(bests)end
 end
 return profile
end
function P:finish(record,reward,notify)
 record.finished=true
 task.spawn(function()
  local deadline=os.clock()+18
  while record.pending&gt;0 and os.clock()&lt;deadline do task.wait(.1)end
  local meta=record.meta;local complete=#meta.pages&gt;0
  for _,page in ipairs(meta.pages)do if not page.saved then complete=false end end
  meta.saved=complete and not record.failed
  -- Session-only recordings stay accessible through the in-memory page cache.
  meta.storage=meta.saved and 'Saved to cloud'or 'Session only'
  local okManifest=self:request(self.replays,'UpdateAsync','m:'..meta.id,meta)
  if not okManifest then meta.saved=false;meta.storage='Session only'end
  for _,userId in ipairs(meta.access)do
   local profile=self:load(userId)
   add(profile,meta,reward,self.config)
   local savedProfile
   local ok=self.profiles and pcall(function()
    savedProfile=self.profiles:UpdateAsync('u:'..userId,function(old)
     old=type(old)=='table'and old.version==1 and old or fresh()
     return add(old,meta,reward,self.config,true)
    end)
   end)
   if ok and savedProfile then
    -- Preserve session-only clips in RAM without writing broken cloud references.
    local seen={};for _,r in ipairs(savedProfile.records)do seen[r.id]=true end
    for _,r in ipairs(profile.records)do if not r.saved and not seen[r.id]then table.insert(savedProfile.records,1,r);seen[r.id]=true end end
    while #savedProfile.records&gt;self.config.LibrarySize do table.remove(savedProfile.records)end
    local courses={};for _,r in ipairs(savedProfile.bests)do courses[r.course]=true end
    for _,r in ipairs(profile.bests)do if not r.saved and not courses[r.course]then table.insert(savedProfile.bests,r);courses[r.course]=true end end
    while #savedProfile.bests&gt;self.config.BestSize do table.remove(savedProfile.bests)end
    savedProfile.preferences=profile.preferences or savedProfile.preferences
    self.users[userId]=savedProfile
   elseif not self.profiles then meta.saved=false;meta.storage='Session only'
   elseif not ok then meta.saved=false;meta.storage='Session only · save index unconfirmed'end
   self.status[userId]=(meta.saved and ok)and 'Cloud save ready'or(not self.profiles and 'Session only · replay ready'or 'Session only · save was not confirmed')
   if notify then notify(userId,meta,self.status[userId])end
  end
  record.done=true
 end)
end
function P:find(userId,id)
 local profile=self:load(userId)
 for _,list in ipairs({profile.records,profile.bests})do for _,r in ipairs(list)do if r.id==id then return r end end end
end
function P:getPage(userId,id,index)
 local record=self:find(userId,id)
 if not record or type(index)~='number'or index%1~=0 then return nil,'Replay unavailable'end
 local page=record.pages[index];if not page then return nil,'Page unavailable'end
 local cached=self.cache[page.key];if cached then return cached end
 if not page.saved then return nil,'This session-only page is no longer in memory'end
 local ok,text=self:request(self.replays,'GetAsync',page.key)
 if ok and type(text)=='string'then self:remember(page.key,text);return text end
 return nil,'Could not load replay page; try again'
end
function P:library(userId)
 local profile=self:load(userId)
 return {xp=profile.xp,records=profile.records,bests=profile.bests,status=self.status[userId]or 'Loading save…'}
end
return P
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX00000025">
        <Properties>
          <string name="Name">RaceSession</string>
          <ProtectedString name="Source">-- Server-owned parallel rally races: one road/seed/ruleset, separate collision lanes.
-- The caller launches ordinary runs, then releases their countdown as one group.
local Race={};Race.__index=Race
local function finite(n)return type(n)=='number'and n==n and math.abs(n)&lt;1e12 end
local function label(player)return tostring(player.DisplayName or player.Name or player.UserId)end
local function deep(value)
 if type(value)~='table'then return value end
 local out={};for k,v in pairs(value)do out[k]=deep(v)end;return out
end
local function rules(source)
 source=type(source)=='table'and source or {}
 -- Never forward arbitrary client tables to the driving solver.
 local out={}
 for _,name in ipairs({'damage','damageEnabled','assists','keyboardAssist','tractionControl','abs','stabilityControl'})do
  if type(source[name])=='boolean'then out[name]=source[name]end
 end
 for _,name in ipairs({'tyrePressure','pressure','assistStrength'})do
  if finite(source[name])then out[name]=math.clamp(source[name],.55,1.4)end
 end
 return out
end
function Race.new(callbacks)
 assert(type(callbacks)=='table'and type(callbacks.notify)=='function'and type(callbacks.launch)=='function','Race callbacks required')
 return setmetatable({callbacks=callbacks,races={},membership={},serial=0,maxPlayers=8,maxRooms=16},Race)
end
function Race:_notice(player,message)self.callbacks.notify(player,'notice',message)end
function Race:_snapshot(race)
 local members={}
 for _,m in ipairs(race.members)do
  members[#members+1]={userId=m.userId,name=m.name,car=m.car,ready=m.ready,loaded=m.loaded,z=m.z,time=m.time,
   finished=m.finished,dnf=m.dnf or false,reason=m.reason}
 end
 table.sort(members,function(a,b)
  if a.dnf~=b.dnf then return not a.dnf end
  if a.finished~=b.finished then return a.finished end
  if a.finished and a.time~=b.time then return a.time&lt;b.time end
  if a.z~=b.z then return a.z&gt;b.z end
  return a.userId&lt;b.userId
 end)
 for i,m in ipairs(members)do m.rank=i end
 return {id=race.id,host=race.host.UserId,name=label(race.host).."'s rally",status=race.status,seed=race.seed,mode='sprint',
  settings=deep(race.settings),members=members,maxPlayers=self.maxPlayers}
end
function Race:_send(race)
 local snapshot=self:_snapshot(race)
 for _,m in ipairs(race.members)do if m.player then self.callbacks.notify(m.player,'race',snapshot)end end
 return snapshot
end
function Race:_member(race,player)
 for _,m in ipairs(race.members)do if m.player==player then return m end end
end
function Race:lobby()
 local out={}
 for _,race in pairs(self.races)do if race.status=='lobby'and #race.members&lt;self.maxPlayers then out[#out+1]=self:_snapshot(race)end end
 table.sort(out,function(a,b)return a.id&lt;b.id end);return out
end
function Race:_free(player)
 return not self.callbacks.active or not self.callbacks.active(player)
end
function Race:action(player,kind,data)
 data=type(data)=='table'and data or {}
 local race=self.membership[player]
 if kind=='create'then
  if not self:_free(player)then self:_notice(player,'Finish or leave your current drive before hosting a race.');return false end
  if race then self:remove(player);race=nil end
  local count=0
  for id,entry in pairs(self.races)do
   if entry.status=='finished'then
    local live=false;for _,m in ipairs(entry.members)do if m.player and self.membership[m.player]==entry then live=true end end
    if not live then self.races[id]=nil else count+=1 end
   else count+=1 end
  end
  if count&gt;=self.maxRooms then self:_notice(player,'Race rooms are full. Join an existing rally.');return false end
  self.serial+=1
  local seed=finite(data.seed)and math.floor(data.seed)%1000000000 or math.random(1,999999999)
  race={id=tostring(self.serial),host=player,seed=seed,status='lobby',settings=rules(data.settings),members={}}
  self.races[race.id]=race
  local member={player=player,userId=player.UserId,name=label(player),car=type(data.car)=='string'and string.sub(data.car,1,60)or 'hatch',ready=false,loaded=false,z=0,time=0,finished=false}
  race.members[1]=member;self.membership[player]=race;self:_send(race);return true
 elseif kind=='join'then
  if not self:_free(player)then self:_notice(player,'Finish or leave your current drive before joining a race.');return false end
  local target=self.races[tostring(data.id or '')]
  if not target or target.status~='lobby'or #target.members&gt;=self.maxPlayers then self:_notice(player,'That rally lobby is unavailable or full.');return false end
  if race==target then self:_send(target);return true end
  if race then self:remove(player)end
  target.members[#target.members+1]={player=player,userId=player.UserId,name=label(player),car=type(data.car)=='string'and string.sub(data.car,1,60)or 'hatch',ready=false,loaded=false,z=0,time=0,finished=false}
  self.membership[player]=target;self:_send(target);return true
 elseif kind=='leave'then
  local member=race and self:_member(race,player)
  if race and race.status~='lobby'and race.status~='finished'and member and not member.finished and not member.dnf then self:_notice(player,'Retire from the race before leaving its room.');return false end
  self:remove(player);self.callbacks.notify(player,'race',{});return true
 elseif not race then self:_notice(player,'Join or host a rally first.');return false
 elseif kind=='ready'and race.status=='lobby'then
  local m=self:_member(race,player)
  m.ready=data.ready~=false
  if type(data.car)=='string'then m.car=string.sub(data.car,1,60)end
  self:_send(race);return true
 elseif kind=='start'and race.status=='lobby'then
  if race.host~=player then self:_notice(player,'Only the host can start this rally.');return false end
  if #race.members&lt;2 then self:_notice(player,'Invite at least one other driver before starting.');return false end
  for _,m in ipairs(race.members)do
   if not m.ready then self:_notice(player,m.name..' is not ready.');return false end
   if not self:_free(m.player)then self:_notice(player,m.name..' is already driving.');return false end
   if self.callbacks.validate then
    local ok,reason=self.callbacks.validate(m.player,{mode='sprint',seed=race.seed,car=m.car,settings=deep(race.settings)},race.id)
    if not ok then self:_notice(player,reason or (m.name..' cannot start yet.'));return false end
   end
  end
  race.status='loading';local launched={}
  for _,m in ipairs(race.members)do
   m.loaded=false;m.finished=false;m.dnf=false;m.reason=nil;m.z=0;m.time=0
   local ok,result,reason=pcall(self.callbacks.launch,m.player,{mode='sprint',seed=race.seed,car=m.car,settings=deep(race.settings)},race.id)
   if not ok or not result then
    -- Launch can fail on car availability/slot allocation. Roll back every prior launch.
    for _,started in ipairs(launched)do if self.callbacks.cancel then self.callbacks.cancel(started.player,race.id)end end
    race.status='lobby'
    for _,entry in ipairs(race.members)do entry.ready=false;entry.loaded=false end
    self:_send(race)
    for _,entry in ipairs(race.members)do self:_notice(entry.player,reason or 'Unable to start every driver. Ready up and retry.')end
    return false
   end
   launched[#launched+1]=m
  end
  self:_send(race);return true
 end
 return false
end
function Race:_releaseIfLoaded(race)
 if race.status~='loading'then return false end
 local players={}
 for _,m in ipairs(race.members)do
  if m.player and not m.dnf and not m.finished then
   if not m.loaded then return false end
   players[#players+1]=m.player
  end
 end
 if #players==0 then race.status='finished';self:_send(race);return false end
 race.status='running';self:_send(race)
 if self.callbacks.countdown then self.callbacks.countdown(players,race.id)end
 return true
end
function Race:loaded(player)
 local race=self.membership[player];if not race or race.status~='loading'then return false end
 local member=self:_member(race,player);if not member or member.dnf then return false end
 member.loaded=true
 if self:_releaseIfLoaded(race)then return true end
 self:_send(race);return false
end
function Race:update(player,z,time,finished,reason)
 local race=self.membership[player];if not race or (race.status~='running'and race.status~='loading')then return end
 local m=self:_member(race,player);if not m or m.dnf or m.finished then return end
 if finite(z)then m.z=math.max(m.z,math.clamp(z,0,6144))end
 if finite(time)then m.time=math.max(m.time,math.max(0,time))end
 if finished==true then m.finished=true
 elseif reason then m.dnf=true;m.reason=string.sub(tostring(reason),1,64)end
 if reason and race.status=='loading'then self:_releaseIfLoaded(race)end
 local complete=true;for _,entry in ipairs(race.members)do if not entry.finished and not entry.dnf then complete=false end end
 if complete then race.status='finished'end
 local now=self.callbacks.clock and self.callbacks.clock()or os.clock()
 if finished==true or reason or not race.lastStandings or now-race.lastStandings&gt;=.1 then
  race.lastStandings=now;return self:_send(race)
 end
end
function Race:remove(player)
 local race=self.membership[player];if not race then return end
 self.membership[player]=nil
 local m=self:_member(race,player)
 if race.status=='lobby'or race.status=='finished'then
  for i,entry in ipairs(race.members)do if entry==m then table.remove(race.members,i);break end end
 else
  m.player=nil;if not m.finished then m.dnf=true;m.reason='Left the race'end
 end
 local nextHost;for _,entry in ipairs(race.members)do if entry.player then nextHost=entry.player;break end end
 if not nextHost then self.races[race.id]=nil;return end
 if race.host==player then race.host=nextHost end
 if race.status=='loading'then self:_releaseIfLoaded(race)end
 local complete=true;for _,entry in ipairs(race.members)do if not entry.finished and not entry.dnf then complete=false end end
 if complete and race.status=='running'then race.status='finished'end
 self:_send(race)
end
function Race:forPlayer(player)
 local race=self.membership[player];return race and self:_snapshot(race)or nil
end
return Race
</ProtectedString>
