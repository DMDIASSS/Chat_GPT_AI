  <Item class="ServerStorage" referent="RBX00000007">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
  </Item>
  <Item class="ReplicatedFirst" referent="RBX00000008">
    <Properties>
      <string name="Name">ReplicatedFirst</string>
    </Properties>
  </Item>
  <Item class="StarterGui" referent="RBX00000009">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="RBX0000000A">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX0000000B">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="RBX00000026">
        <Properties>
          <string name="Name">BackseatExpeditionClient</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX00000027">
          <Properties>
            <string name="Name">Cockpit</string>
            <ProtectedString name="Source">-- Local, asset-independent cabin. Geometry and instruments are allocated once.
-- Car local forward is -Z; recommended eye is (+/-1.15, 1.45, .35).
local Cockpit={};Cockpit.__index=Cockpit
local ink=Color3.fromRGB(19,24,25)
local metal=Color3.fromRGB(105,116,115)
local trim=Color3.fromRGB(48,57,57)
local function part(parent,name,size,cf,color,material)
 local p=Instance.new('Part');p.Name=name;p.Size=size;p.CFrame=cf;p.Color=color
 p.Material=material or Enum.Material.SmoothPlastic;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false
 p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=parent;return p
end
local function text(parent,name,value,x,y,w,h,size,color)
 local t=Instance.new('TextLabel');t.Name=name;t.Text=value;t.Position=UDim2.fromOffset(x,y);t.Size=UDim2.fromOffset(w,h)
 t.BackgroundTransparency=1;t.TextColor3=color or Color3.fromRGB(231,234,215);t.Font=Enum.Font.Code;t.TextSize=size
 t.TextXAlignment=Enum.TextXAlignment.Left;t.Parent=parent;return t
end
function Cockpit.new(parent,car,options)
 local model=Instance.new('Model');model.Name='RallyCockpit';model.Parent=parent
 local root=part(model,'Cabin root',Vector3.new(.05,.05,.05),CFrame.new(),ink);root.Transparency=1;model.PrimaryPart=root
 local self=setmetatable({model=model,car=car,visual=options and options.visual,wheel={},instrumentAt=0,visible=true,parts={}},Cockpit)
 part(model,'Padded dashboard',Vector3.new(4.45,.27,1.03),CFrame.new(0,.41,-1.5),ink)
 part(model,'Dashboard brow',Vector3.new(2.35,.1,.54),CFrame.new(-1.06,.81,-1.44),trim)
 local panel=part(model,'Driver instrument panel',Vector3.new(2.22,.59,.08),CFrame.new(-1.06,.48,-1.28),ink)
 part(model,'Passenger glovebox',Vector3.new(1.83,.48,.1),CFrame.new(1.14,.43,-.97),trim)
 part(model,'Centre console',Vector3.new(.44,.45,1.4),CFrame.new(.15,-.12,-.22),ink)
 part(model,'Gear stick',Vector3.new(.09,.48,.09),CFrame.new(.18,.17,-.22),metal,Enum.Material.Metal)
 part(model,'Gear knob',Vector3.new(.23,.17,.23),CFrame.new(.18,.46,-.22),trim)
 for _,side in ipairs({-1,1})do
  part(model,'Lower door trim',Vector3.new(.14,.59,2.8),CFrame.new(side*2.22,.06,.18),ink)
  part(model,'Window sill',Vector3.new(.17,.12,3.2),CFrame.new(side*2.22,.71,.1),trim)
  part(model,'Front roll cage',Vector3.new(.055,1.83,.055),CFrame.new(side*2.18,1.37,-1.73)*CFrame.Angles(.12,0,side*.04),metal,Enum.Material.Metal)
  part(model,'Roof cage rail',Vector3.new(.055,.055,3.2),CFrame.new(side*2.16,2.28,-.1),metal,Enum.Material.Metal)
 end
 part(model,'Top windscreen rail',Vector3.new(4.35,.055,.055),CFrame.new(0,2.28,-1.73),metal,Enum.Material.Metal)
 -- The steering rim is twelve flat segments, with no hidden external meshes.
 local hub=CFrame.new(-1.15,.53,-1.12)*CFrame.Angles(math.rad(10),0,0)
 self.hub=hub
 for i=1,12 do
  local angle=(i-1)*math.pi/6
  local localFrame=hub*CFrame.Angles(0,0,angle)*CFrame.new(0,.31,0)
  local p=part(model,'Steering rim',Vector3.new(.162,.045,.045),localFrame,ink)
  self.wheel[#self.wheel+1]={part=p,localFrame=hub:Inverse()*localFrame}
 end
 for i=1,3 do
  local a=(i-1)*math.pi*2/3
  local localFrame=hub*CFrame.Angles(0,0,a)*CFrame.new(0,.13,0)
  local p=part(model,'Steering spoke',Vector3.new(.045,.25,.045),localFrame,metal,Enum.Material.Metal)
  self.wheel[#self.wheel+1]={part=p,localFrame=hub:Inverse()*localFrame}
 end
 part(model,'Steering centre',Vector3.new(.14,.14,.065),hub,trim)
 local gui=Instance.new('SurfaceGui');gui.Name='LiveInstruments';gui.Face=Enum.NormalId.Back;gui.CanvasSize=Vector2.new(720,210)
 gui.LightInfluence=0;gui.Brightness=1.3;gui.Parent=panel
 local background=Instance.new('Frame');background.Size=UDim2.fromScale(1,1);background.BorderSizePixel=0;background.BackgroundColor3=Color3.fromRGB(7,14,15);background.Parent=gui
 text(background,'Brand','EXPEDITION / RALLY COMPUTER',16,8,690,27,25,Color3.fromRGB(177,195,166))
 self.speed=text(background,'Speed','000',16,39,255,111,98)
 text(background,'Speed unit','KM/H',30,154,200,30,25,Color3.fromRGB(137,158,144))
 self.gear=text(background,'Gear','N',295,45,115,108,98,Color3.fromRGB(242,186,78))
 text(background,'Gear legend','GEAR',301,154,128,30,25,Color3.fromRGB(137,158,144))
 self.rpm=text(background,'RPM','0850 RPM',451,48,255,45,37)
 self.status=text(background,'Status','SYSTEMS READY',451,108,255,36,23,Color3.fromRGB(137,187,148))
 self.pressure=text(background,'Pressure','TYRES  100%',451,154,255,32,24,Color3.fromRGB(177,195,166))
 self.revBars={}
 for i=1,10 do
  local bar=Instance.new('Frame');bar.Name='ShiftLight';bar.Position=UDim2.fromOffset(16+(i-1)*70,191);bar.Size=UDim2.fromOffset(62,7)
  bar.BackgroundColor3=Color3.fromRGB(32,49,40);bar.BorderSizePixel=0;bar.Parent=background;self.revBars[i]=bar
 end
 for _,p in ipairs(model:GetDescendants())do if p:IsA('BasePart')then self.parts[#self.parts+1]={part=p,transparency=p.Transparency}end end
 self:_refreshSource()
 return self
end
-- Original cabin geometry belongs to the imported visual, never this fallback model.
-- An available original interior must not be overlaid with a second dashboard/wheel.
function Cockpit:source()
 if self.originalModel and self.originalModel.Parent then return 'original'end
 local visual=self.visual
 if visual and ((visual.interiorReady==true and (not visual.interior or visual.interior.Parent))or (visual.interior and visual.interior.Parent))then return 'original'end
 if visual and visual.skinStatus=='loading'then return 'loading'end
 return 'fallback'
end
function Cockpit:setOriginal(model,steeringParts)
 self.originalModel=model;self.originalSteering=steeringParts;self:_refreshSource()
end
function Cockpit:_refreshSource()
 local source=self:source();local show=self.visible and source=='fallback'
 if self.appliedVisible==show then return end
 self.appliedVisible=show
 for _,entry in ipairs(self.parts)do if entry.part.Parent then entry.part.Transparency=show and entry.transparency or 1 end end
 local panel=self.model:FindFirstChild('Driver instrument panel')
 if panel and panel:FindFirstChild('LiveInstruments')then panel.LiveInstruments.Enabled=show end
end
function Cockpit:setVisible(visible)
 self.visible=visible;self:_refreshSource()
end
function Cockpit:update(cf,state,dt,passenger)
 self:_refreshSource()
 local original=self:source()=='original'
 if original then
  for _,entry in ipairs(self.visual and self.visual.instrumentParts or {})do if entry.part.Parent then
   local value=entry.kind=='Speedo'and math.abs(state.v or 0)*.28*3.6 or (state.rpm or 850)
   local angle=entry.zero+(entry.finish-entry.zero)*math.clamp(value/math.max(1,entry.max),0,1)
   entry.part.CFrame=cf*entry.hub*CFrame.Angles(0,0,math.rad(angle))*entry.localFrame
  end end
  local entries=self.originalSteering or (self.visual and self.visual.steeringParts)
  for _,entry in ipairs(entries or {})do if entry.part and entry.part.Parent and entry.hub and entry.localFrame then
   entry.part.CFrame=cf*entry.hub*CFrame.Angles(0,0,-(state.steer or 0)*math.rad(entry.range or 125))*entry.localFrame
  end end
 end
 -- Keep the portable model's pivot for view continuity, even while fully hidden.
 self.model:PivotTo(cf)
 if original or self:source()=='loading'then return end
 local steering=CFrame.Angles(0,0,-(state.steer or 0)*math.rad(125))
 for _,entry in ipairs(self.wheel)do entry.part.CFrame=cf*self.hub*steering*entry.localFrame end
 self.instrumentAt+=math.max(0,dt or 0)
 if self.instrumentAt&lt;.1 then return end;self.instrumentAt=0
 local speed=math.abs(state.v or 0)*.28*3.6
 self.speed.Text=string.format('%03d',math.floor(speed+.5))
 self.gear.Text=(state.v or 0)&lt;-.5 and 'R'or(speed&lt;1 and 'N'or tostring(state.gear or 1))
 local rpm=math.max(800,state.rpm or (800+speed*29));self.rpm.Text=string.format('%04d RPM',math.floor(rpm+.5))
 local pressure,count,punctured=0,0,false
 for _,tyre in pairs(state.tyres or {})do pressure+=tyre.pressure or 1;count+=1;punctured=punctured or tyre.punctured==true end
 self.pressure.Text=string.format('TYRES  %d%%',math.floor((count&gt;0 and pressure/count or 1)*100+.5))
 self.status.Text=punctured and 'PUNCTURE / PIT'or((state.damage or 0)&gt;55 and 'DAMAGE / PIT'or(passenger and 'CO-DRIVER' or 'SYSTEMS READY'))
 self.status.TextColor3=(punctured or (state.damage or 0)&gt;55)and Color3.fromRGB(239,110,75)or Color3.fromRGB(137,187,148)
 local maxRPM=self.car.shiftRpm or 6500;local fraction=math.clamp(rpm/maxRPM,0,1)
 for i,bar in ipairs(self.revBars)do
  bar.BackgroundColor3=fraction&gt;=i/10 and (i&gt;=9 and Color3.fromRGB(236,83,57)or Color3.fromRGB(216,185,77))or Color3.fromRGB(32,49,40)
 end
end
function Cockpit:destroy()self.model:Destroy();self.wheel={};self.parts={}end
return Cockpit
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000028">
          <Properties>
            <string name="Name">Effects</string>
            <ProtectedString name="Source">-- Finite, non-graphic impact and weather overlays. No assets or frame-time allocation.
local Effects={};Effects.__index=Effects
local function frame(parent,name,color,z)
 local f=Instance.new('Frame');f.Name=name;f.Size=UDim2.fromScale(1,1);f.BorderSizePixel=0
 f.BackgroundColor3=color;f.BackgroundTransparency=1;f.ZIndex=z;f.Active=false;f.Parent=parent;return f
end
function Effects.new(gui)
 local container=frame(gui,'RallyEffects',Color3.new(0,0,0),20)
 local self=setmetatable({root=container,red=frame(container,'ImpactRed',Color3.fromRGB(140,17,13),22),
  black=frame(container,'ImpactBlackout',Color3.new(0,0,0),23),rain={},time=0,impactAge=100,strength=0,severe=false,lastImpact=0,lastCrashes=0},Effects)
 for i=1,24 do
  local streak=frame(container,'RainStreak',Color3.fromRGB(201,218,225),21);streak.Size=UDim2.fromOffset(1,28+i%5*4)
  streak.Rotation=-12;streak.Visible=false;self.rain[i]=streak
 end
 return self
end
function Effects:reset()
 self.impactAge=100;self.strength=0;self.severe=false;self.lastImpact=0;self.lastCrashes=0
 self.red.BackgroundTransparency=1;self.black.BackgroundTransparency=1
 for _,streak in ipairs(self.rain)do streak.Visible=false end
end
function Effects:update(state,dt,settings,isReplay,weather)
 dt=math.clamp(dt or 0,0,.1);settings=settings or {};self.time+=dt;self.impactAge+=dt
 local impact=state.impact or 0;local crashes=state.crashes or 0
 if not isReplay and (crashes&gt;self.lastCrashes or impact&gt;self.lastImpact+.25)then
  local speed=math.abs(state.impactSpeed or state.crashSpeed or state.v or 0)
  self.strength=math.clamp(.25+speed/140,.25,1);self.severe=speed&gt;=84;self.impactAge=0
 end
 self.lastImpact=impact;self.lastCrashes=crashes
 local mode=settings.crashEffects or 'red'
 local red=0;local black=0
 if not isReplay and mode~='off'then
  red=self.strength*math.max(0,1-self.impactAge/1.15)*.52
  if mode=='blackout'and self.severe then
   black=self.impactAge&lt;.42 and 1 or math.max(0,1-(self.impactAge-.42)/1.1)
   red*=1-black
  end
 end
 self.red.BackgroundTransparency=1-red;self.black.BackgroundTransparency=1-black
 local wetness=weather and weather.wetness or state.wetness or 0
 local amount=not isReplay and wetness&gt;.26 and (settings.quality=='low'and 8 or 24)or 0
 for i,streak in ipairs(self.rain)do
  streak.Visible=i&lt;=amount
  if i&lt;=amount then
   local x=((i*.61803398875+self.time*.017)%1)
   local y=((i*.38196601125+self.time*(.73+i%5*.08))%1)
   streak.Position=UDim2.fromScale(x,y);streak.BackgroundTransparency=math.clamp(.94-wetness*.18,.72,.96)
  end
 end
end
function Effects:destroy()self.root:Destroy();self.rain={}end
return Effects
</ProtectedString>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBX00000029">
          <Properties>
            <string name="Name">Main</string>
            <ProtectedString name="Source">local Players=game:GetService('Players');local RS=game:GetService('ReplicatedStorage')
local RunService=game:GetService('RunService');local UIS=game:GetService('UserInputService');local Lighting=game:GetService('Lighting')
local player=Players.LocalPlayer;local root=RS:WaitForChild('BackseatExpedition');local remotes=root.Remotes
local C=require(root.Shared.Config);local Route=require(root.Shared.Route);local D=require(root.Shared.Dynamics);local Assets=require(root.Shared.Assets)
local OriginalCourse=require(root.Shared.OriginalCourse)
local Presence=require(script.Parent.Presence);local UI=require(script.Parent.UI);local RoadStream=require(script.Parent.RoadStream);local ReplayPlayer=require(script.Parent.ReplayPlayer)
local Settings=require(script.Parent.Settings);local ReplayCamera=require(script.Parent.ReplayCamera)
local Cockpit=require(script.Parent.Cockpit);local Effects=require(script.Parent.Effects)
local settings,options,keyMap,replayCamera,cockpit,effects;local currentRace;local lookYaw,lookPitch=0,0;local headlights=false
local mode='closed';local scene,stream,visual,route,run,predicted,ghostPlayer,ghostVisual,replayPlayer
local replayTime,replayRate,replayPaused=0,1,false
local held={};local gamepad={steer=0,throttle=0,brake=0};local seq=0;local sent=0;local accumulator=0;local roadAt=0
local cameraMode=1
local freeFrame;local readySent=false;local noticeUntil=0;local lastFrame;local clockAt,clockValue=0,0
local correction;local countdownUntil;local ui;local presence;local menuPark;local closing=false
local opponents={};local avatarParts={};local serverParts={};local pendingStart=false;local startSerial=0
local openExpansion,closeExpansion
local function notice(text,seconds)if ui then ui.message.Text=tostring(text);ui.menuMessage.Text=tostring(text);noticeUntil=os.clock()+(seconds or 3)end end
local function invoke(kind,data)
 local ok,response=pcall(function()return remotes.Request:InvokeServer(kind,data)end)
 if not ok then return {error='Connection interrupted; try again'}end
 return response or {error='No response'}
end
local function finiteState(state)
 if type(state)~='table'then return false end
 for _,key in ipairs({'x','z','v','yaw'})do
  local n=state[key];if type(n)~='number'or n~=n or math.abs(n)&gt;=1e9 then return false end
 end
 local count=0
 local function check(value,depth)
  if type(value)=='number'then return value==value and math.abs(value)&lt;1e9 end
  if type(value)~='table'then return true end
  if depth&gt;4 then return false end
  for _,item in pairs(value)do count+=1;if count&gt;256 or not check(item,depth+1)then return false end end
  return true
 end
 return check(state,0)
end
local function controls()
 local focus=UIS:GetFocusedTextBox();if focus or (settings and settings:isOpen()) then return {throttle=0,brake=.5,steer=0}end
 local reversing=held.brake and predicted and predicted.v&lt;.8
 return {throttle=held.throttle and 1 or ((held.reverse or reversing)and -1 or gamepad.throttle),
  brake=held.brake and not reversing and 1 or gamepad.brake,steer=held.left and -1 or (held.right and 1 or gamepad.steer),handbrake=held.handbrake==true}
end
local function clearScene()
 opponents={}
 if replayCamera then replayCamera:destroy();replayCamera=nil end
 if cockpit then cockpit:destroy();cockpit=nil end
 if effects then effects:reset()end
 for part,old in pairs(avatarParts)do if part.Parent then part.LocalTransparencyModifier=old end end;avatarParts={}
 for part,old in pairs(serverParts)do if part.Parent then part.LocalTransparencyModifier=old end end;serverParts={}
 if ghostPlayer then ghostPlayer:destroy();ghostPlayer=nil end
 if replayPlayer then replayPlayer:destroy();replayPlayer=nil end
 if stream then stream:destroy();stream=nil end
 if scene then scene:Destroy();scene=nil end
 visual=nil;ghostVisual=nil;predicted=nil;correction=nil;lastFrame=nil;freeFrame=nil;held={}
end
local function menuCamera()
 local original=C.UseOriginalStages and OriginalCourse.default(C)
 if original then
  local at=original:worldPoint(0);local camera=workspace.CurrentCamera;camera.CameraType=Enum.CameraType.Scriptable
  camera.CFrame=CFrame.lookAt(at+Vector3.new(18,12,22),at+Vector3.new(0,2,-8));camera.FieldOfView=56
  presence:view(camera.CFrame,56);return
 end
 if not menuPark then
  menuPark=Instance.new('Model');menuPark.Name='ExpeditionLocalPark';menuPark.Parent=workspace
  Assets.park(menuPark);menuPark:PivotTo(CFrame.new(C.WorldX,0,0))
 end
 local camera=workspace.CurrentCamera;camera.CameraType=Enum.CameraType.Scriptable
 camera.CFrame=CFrame.lookAt(Vector3.new(C.WorldX+52,22,53),Vector3.new(C.WorldX,3,-12));camera.FieldOfView=56
 presence:view(camera.CFrame,56)
end
local function getCar(id)for _,car in ipairs(C.Cars)do if car.id==id then return car end end;return C.Cars[1]end
local function refreshLobby()
 task.spawn(function()local data=invoke('lobby');if data.error then notice(data.error)else ui:lobby(data)end end)
end
local function exitToMenu()
 clearScene();mode='menu';run=nil;ui:show('menu');menuCamera();refreshLobby()
end
local function setQuality(quality)
 ui.quality=quality;ui.qualityButton.Text='QUALITY: '..quality:upper()
 if stream then stream.quality=quality end
 if settings and settings:values().quality~=quality then settings:set('quality',quality)end
end
local function setup(metadata,initial)
 if menuPark then menuPark:Destroy();menuPark=nil end
 clearScene();run=metadata;route=(metadata.stage and OriginalCourse.new(metadata.stage,C,metadata.seed))or Route.new(metadata.seed,metadata.length,C)
 presence:sceneProfile(route.original)
 scene=Instance.new('Folder');scene.Name='ExpeditionLocal';scene.Parent=workspace
 stream=RoadStream.new(scene);stream.quality=ui.quality;stream:reset(route,metadata.slot or 1,metadata.originZ or 0)
 visual=Assets.car(scene,getCar(metadata.car),false,C.ImportedVisuals,C.ExternalAudio)
 Assets.headlights(visual,headlights,ui.quality)
 predicted=initial or D.new(route);readySent=false;accumulator=0;cameraMode=1;roadAt=0;lookYaw=0;lookPitch=0
 if mode=='drive'then
  cockpit=Cockpit.new(scene,getCar(metadata.car),{visual=visual});Assets.cockpitView(visual,true)
 end
 workspace.CurrentCamera.CameraType=Enum.CameraType.Scriptable;workspace.CurrentCamera.FieldOfView=72
 presence:time(metadata.mode=='daily'and 18.15 or 15.8)
end
local function loadGhost(id)
 if not id then return end
 local active=run and run.id
 task.spawn(function()
  local data=invoke('replay',{id=id})
  if not run or run.id~=active or mode~='drive'or data.error or not data.record or data.record.generation~=C.Generation then return end
  ghostPlayer=ReplayPlayer.new(remotes.Request,data.record);ghostVisual=Assets.car(scene,getCar(data.record.car),true,false);ghostPlayer:page(1)
 end)
end
local function watch(record)
 if record.stage and record.stage~=root:GetAttribute('OriginalStage')then notice('This replay needs the original '..record.stage..' place.');return end
 if record.generation~=C.Generation then notice('This replay uses a different road generation version.');return end
 mode='replay';setup({seed=record.seed,length=record.length,slot=1,originZ=0,mode=record.mode,stage=record.stage,stageName=record.stageName,car=record.car,passenger=0},nil)
 replayPlayer=ReplayPlayer.new(remotes.Request,record);replayPlayer:page(1)
 replayCamera=ReplayCamera.new(workspace.CurrentCamera,UIS,{cockpitFov=options.fov,canInput=function()return not settings:isOpen()end})
 replayTime=record.startTime or 0;replayRate=1;replayPaused=false;ui:show('replay');notice('Loading saved replay…',2)
 for _,child in ipairs(ui.timeline:GetChildren())do if child.Name=='Moment'then child:Destroy()end end
 for _,t in ipairs(record.markers or {})do
  local marker=Instance.new('Frame');marker.Name='Moment';marker.Size=UDim2.fromOffset(3,16)
  marker.Position=UDim2.new(t/math.max(record.duration,1),-1,0,0);marker.BorderSizePixel=0;marker.BackgroundColor3=Color3.fromRGB(237,126,84);marker.Parent=ui.timeline
 end
end
ui=UI.new({
 open=function()openExpansion()end,close=function()
  if mode=='drive'then closing=true;remotes.Action:FireServer(run and run.owner~=player.UserId and 'leave'or 'retire');notice('Saving the run…')else closeExpansion()end
 end,
 start=function(modeId,carId,seed,map)
  if mode=='drive'or pendingStart then return end
  if mode=='replay'then clearScene();mode='menu'end
  pendingStart=true;startSerial+=1;local serial=startSerial;ui.startButton.Text='STARTING…'
  notice('Preparing your car and road…',8)
  remotes.Action:FireServer('start',{mode=modeId,car=carId,seed=seed,map=map,settings=options})
  task.delay(8,function()if pendingStart and startSerial==serial then
   pendingStart=false;ui.startButton.Text='TAKE THE ROAD →';notice('Unable to start the run. Please try again.',8)
  end end)
 end,
 library=function()task.spawn(function()local data=invoke('library');if data.error then notice(data.error)else ui:library(data)end end)end,
 lobby=refreshLobby,quality=setQuality,
 stop=function()if mode=='drive'then remotes.Action:FireServer('retire')end end,
 recover=function()if mode=='drive'then remotes.Action:FireServer('recover')end end,
 bookmark=function()if mode=='drive'then remotes.Action:FireServer('bookmark')end end,
 camera=function()
  if mode=='replay'and replayCamera then notice(replayCamera:cycle()..' CAMERA',1.5)else lookYaw=0;lookPitch=0;notice('COCKPIT · hold right mouse to look',2)end
 end,
 settings=function()settings:toggle();held={};gamepad={steer=0,throttle=0,brake=0}end,
 service=function()if mode=='drive'then remotes.Action:FireServer('service',{pressure=options.tyrePressure})end end,
 race=function(kind,data)
  data=data or {};data.car=ui.car.id;data.seed=tonumber(ui.seed.Text);data.settings=options
