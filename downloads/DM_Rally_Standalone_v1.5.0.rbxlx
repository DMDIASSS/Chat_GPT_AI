local actionHeld={throttle=true,brake=true,left=true,right=true,handbrake=true,reverse=true}
local function keyboardAction(name,down)
 local action=keyMap[name]
 if actionHeld[action]then held[action]=down;return end
 if not down then return end
 if action=='settings'then settings:toggle();held={}
 elseif action=='recover'then ui.callbacks.recover()
 elseif action=='service'then ui.callbacks.service()
 elseif action=='bookmark'then ui.callbacks.bookmark()
 elseif action=='camera'then ui.callbacks.camera()
 elseif action=='callLeft'then ui.callbacks.call('left')
 elseif action=='callRight'then ui.callbacks.call('right')
 elseif action=='caution'then ui.callbacks.call('caution')
 elseif action=='headlights'then headlights=not headlights;if visual then Assets.headlights(visual,headlights,ui.quality)end
 elseif mode=='replay'and name=='P'then ui.callbacks.pause()
 elseif mode=='replay'and name=='Comma'then ui.callbacks.skip(-5)
 elseif mode=='replay'and name=='Period'then ui.callbacks.skip(5)end
end
-- CAS and UIS can both report the same InputObject. Dispatch each phase once,
-- including unprocessed raw UIS reports on devices that do not flag CAS sinks.
local inputPhases=setmetatable({},{__mode='k'})
local function dispatchInput(input,state,processed)
 if mode=='closed'then return end
 local ended=state==Enum.UserInputState.End or state==Enum.UserInputState.Cancel
 local name=input.KeyCode.Name
 if state~=Enum.UserInputState.Change and inputPhases[input]==state then return end
 if settings:isOpen()then
  if state~=Enum.UserInputState.Change then inputPhases[input]=state end
  if not ended then
   if keyMap[name]=='settings'and not settings.pending then settings:toggle(false)else settings:capture(input)end
  end
  held={};gamepad={steer=0,throttle=0,brake=0};return
 end
 if (processed or UIS:GetFocusedTextBox())and not ended then return end
 if state~=Enum.UserInputState.Change then inputPhases[input]=state end
 local action=keyMap[name]
 if mode=='replay'and replayCamera then
  -- Camera motion keys belong to the replay rig; utility keys still use their
  -- bindings even when CAS has consumed the corresponding raw UIS event.
  replayCamera:controlInput(input,state)
  if not actionHeld[action]then keyboardAction(name,not ended)end
  return
 end
 if action then keyboardAction(name,not ended)
 elseif input.KeyCode==Enum.KeyCode.Thumbstick1 then gamepad.steer=ended and 0 or input.Position.X
 elseif input.KeyCode==Enum.KeyCode.ButtonR2 then gamepad.throttle=ended and 0 or input.Position.Z
 elseif input.KeyCode==Enum.KeyCode.ButtonL2 then gamepad.brake=ended and 0 or input.Position.Z end
end
presence.input=function(input,state)dispatchInput(input,state,false)end
UIS.InputBegan:Connect(function(input,processed)dispatchInput(input,Enum.UserInputState.Begin,processed)end)
UIS.InputEnded:Connect(function(input)dispatchInput(input,Enum.UserInputState.End,false)end)
UIS.InputChanged:Connect(function(input)
 if mode=='closed'or settings:isOpen()then return end
 if input.KeyCode==Enum.KeyCode.Thumbstick1 then gamepad.steer=input.Position.X
 elseif input.KeyCode==Enum.KeyCode.ButtonR2 then gamepad.throttle=input.Position.Z
 elseif input.KeyCode==Enum.KeyCode.ButtonL2 then gamepad.brake=input.Position.Z end
end)
UIS.WindowFocusReleased:Connect(function()held={};gamepad={steer=0,throttle=0,brake=0}end)
remotes.Action.OnClientEvent:Connect(function(kind,data)
 if kind=='start'then
  pendingStart=false;ui.startButton.Text='TAKE THE ROAD →'
  if not presence.active then openExpansion()end
  mode='drive';setup(data,D.copy(data.s));clockAt=os.clock();clockValue=data.clock;ui:show('drive');notice('Building the road ahead…',10);loadGhost(data.ghost)
 elseif kind=='countdown'then countdownUntil=os.clock()+3;notice('3 · get ready',3)
 elseif kind=='go'then countdownUntil=nil;if run then run.status='running'end;notice('GO · make it a good one',1.5)
 elseif kind=='notice'then pendingStart=false;ui.startButton.Text='TAKE THE ROAD →';notice(data)
 elseif kind=='checkpoint'then notice('CHECKPOINT / '..UI.time(data.time),1.6)
 elseif kind=='result'then
  if closing then closeExpansion()else clearScene();mode='result';run=nil;menuCamera();ui:resultScreen(data)end
 elseif kind=='race'then currentRace=data.id and data or nil;ui:raceState(currentRace)
 elseif kind=='saved'then ui:saved(data)
 elseif kind=='lobby'then if closing then closeExpansion()else exitToMenu()end end
end)
remotes.State.OnClientEvent:Connect(function(packet)
 if mode~='drive'or not run then return end
 local retained={}
 for _,peer in ipairs(packet.nearby or {})do if route.original and peer.stage==route.stageId and peer.owner~=run.owner and finiteState(peer.s)then
  retained[peer.owner]=true;local entry=opponents[peer.owner]
  if not entry then
   local v=Assets.car(scene,getCar(peer.car),false,C.ImportedVisuals,false);v.model.Name='OriginalOpponent_'..peer.owner
   entry={visual=v,render=D.copy(peer.s)};opponents[peer.owner]=entry
  end
  entry.target=D.copy(peer.s)
 end end
 for owner,entry in pairs(opponents)do if not retained[owner]then entry.visual.model:Destroy();opponents[owner]=nil end end
 for _,data in ipairs(packet.runs or {})do if data.owner==run.owner and finiteState(data.s)then
  local oldOrigin=run.originZ or 0;local oldPenalty=run.penalty;run=data
  if not route.original and data.originZ~=oldOrigin then
   local delta=Vector3.new(0,0,data.originZ-oldOrigin);stream:shift(data.originZ)
   workspace.CurrentCamera.CFrame=workspace.CurrentCamera.CFrame+delta
   if replayCamera then replayCamera:shift(delta)end
  end
  local target=D.copy(data.s)
  if predicted then
   local condition=D.copy(target)
   for _,key in ipairs({'tyres','health','settings','terminal','impactSpeed','impactSide','impactId'})do predicted[key]=condition[key]end
  end
  local lag=math.clamp(workspace:GetServerTimeNow()-packet.time,0,.25)
  if data.status=='running'and data.owner==player.UserId then
   local input=controls();local left=lag
   while left&gt;0 do local dt=math.min(C.Step,left);D.step(target,input,route,getCar(data.car),dt);left-=dt end
  end
  local error=predicted and math.sqrt((predicted.x-target.x)^2+(predicted.z-target.z)^2)or 100
  if not predicted or error&gt;18 or oldPenalty~=data.penalty then predicted=target;correction=nil else correction=target end
  clockValue=data.clock;clockAt=os.clock()
  break
 end end
end)
local function updateCamera(cf,dt)
 for owner,entry in pairs(opponents)do
  local blend=1-math.exp(-12*dt)
  for _,key in ipairs({'x','z','v','steer','bodyY','pitch','roll'})do local value=entry.target[key]
   if value~=nil then entry.render[key]=entry.render[key]and entry.render[key]+(value-entry.render[key])*blend or value end
  end
  local delta=(entry.target.yaw-entry.render.yaw+math.pi)%(2*math.pi)-math.pi;entry.render.yaw+=delta*blend
  Assets.pose(entry.visual,entry.render,route,Vector3.zero,dt)
  local proxy=workspace:FindFirstChild('Rally_'..owner)
  if proxy and not entry.proxyHidden then for _,part in ipairs(proxy:GetDescendants())do if part:IsA('BasePart')and serverParts[part]==nil then
   serverParts[part]=part.LocalTransparencyModifier;part.LocalTransparencyModifier=1
  end end;entry.proxyHidden=true end
 end
 local camera=presence:ensureCamera()
 if replayCamera and replayCamera.camera~=camera then replayCamera.camera=camera end
 if mode=='replay'and replayCamera then
  if visual.eyeOffsets and visual.eyeOffsets.Driver then replayCamera.options.cockpitOffset=visual.eyeOffsets.Driver.Position end
  replayCamera:update(cf,predicted,dt,replayTime);presence:view(camera.CFrame,camera.FieldOfView)
  local interior=replayCamera:name()=='COCKPIT';Assets.cockpitView(visual,interior)
  if interior and not cockpit then cockpit=Cockpit.new(scene,getCar(run.car),{visual=visual})end
  if cockpit then cockpit:setVisible(interior)end
  return
 end
 local passenger=run.passenger==player.UserId
 if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)and not settings:isOpen()then
  local delta=UIS:GetMouseDelta();lookYaw=math.clamp(lookYaw-delta.X*.003*options.lookSensitivity,-1.45,1.45)
  lookPitch=math.clamp(lookPitch-delta.Y*.003*options.lookSensitivity,-.65,.6)
 else
  lookYaw*=math.exp(-3*dt);lookPitch*=math.exp(-3*dt)
 end
 local shake=options.shake or 0
 local jitter=math.min(1,(predicted.impact or 0))*shake
 local t=os.clock()
 local eyes=visual and visual.eyeOffsets;local originalEye=eyes and eyes[passenger and 'CoDriver'or 'Driver']
 local baseEye=originalEye and originalEye.Position or Vector3.new(passenger and 1.15 or -1.15,1.45,.35)
 local view=cf*CFrame.new(baseEye+Vector3.new(0,options.seatHeight,-options.seatForward))
 view=view*CFrame.Angles(lookPitch+math.sin(t*43)*jitter*.035,lookYaw,math.sin(t*37)*jitter*.02)
 -- Body motion remains readable while the user can reduce head movement.
 if lastFrame and shake==0 then
  local forward=cf.LookVector;local flatDirection=Vector3.new(forward.X,0,forward.Z)
  local flat=CFrame.lookAt(view.Position,view.Position+flatDirection)*CFrame.Angles(lookPitch,lookYaw,0)
  view=flat
 end
 camera.CFrame=view;camera.FieldOfView=options.fov;presence:view(view,options.fov);lastFrame=cf
end
local uiAt=0;local slowTime=0
RunService.RenderStepped:Connect(function(dt)
 if mode=='closed'then return end
 ui:resize()
 if countdownUntil and os.clock()&lt;countdownUntil then ui.message.Text=tostring(math.ceil(countdownUntil-os.clock()))..' · GET READY'end
 if noticeUntil&gt;0 and os.clock()&gt;noticeUntil then ui.message.Text='';ui.menuMessage.Text='';noticeUntil=0 end
 if mode~='drive'and mode~='replay'then return end
 if not stream or not predicted then return end
 local input=controls();local speed=getCar(run.car)
 if mode=='drive'then
  sent+=dt
  if sent&gt;=1/C.InputRate then sent=0;seq+=1;input.seq=seq;remotes.Input:FireServer(input)end
  accumulator=math.min(accumulator+dt,.1)
  while accumulator&gt;=C.Step do
   accumulator-=C.Step
   if run.status=='running'then
    local driving=run.owner==player.UserId and input or {throttle=predicted.throttle or 0,brake=predicted.brake or 0,steer=predicted.steer or 0,handbrake=predicted.handbrake}
    D.step(predicted,driving,route,speed,C.Step)end
   if correction then
    -- Advance the correction too, so interpolation does not pull toward an old pose.
    if run.status=='running'then
     local driving=run.owner==player.UserId and input or {throttle=correction.throttle or 0,brake=correction.brake or 0,steer=correction.steer or 0,handbrake=correction.handbrake}
     D.step(correction,driving,route,speed,C.Step)end
    local blend=1-math.exp(-7*C.Step)
    for _,k in ipairs({'x','z','v','lateralV'})do predicted[k]+=(correction[k]-predicted[k])*blend end
    local delta=(correction.yaw-predicted.yaw+math.pi)%(math.pi*2)-math.pi;predicted.yaw+=delta*blend
    predicted.damage=correction.damage;predicted.crashes=correction.crashes
   end
  end
  if not finiteState(predicted)then
   -- Reject a bad prediction before chunk selection or Model:PivotTo sees it.
   predicted=finiteState(run.s)and D.copy(run.s)or D.new(route);correction=nil
   ui.gui:SetAttribute('RecoveredInvalidState',(ui.gui:GetAttribute('RecoveredInvalidState')or 0)+1)
  end
 else
  local state,error=replayPlayer:sample(replayTime)
  if state then
   predicted=state
   if not replayPaused and stream:ready(predicted.z)then replayTime=math.min(replayPlayer.meta.duration,replayTime+dt*replayRate)end
   if replayTime&gt;=replayPlayer.meta.duration then replayPaused=true;ui.pauseButton.Text='PLAY'end
  else notice(error,.5)end
  local newOrigin=-math.floor(predicted.z/4096)*4096
  if not route.original and newOrigin~=(run.originZ or 0)then
   local delta=Vector3.new(0,0,newOrigin-(run.originZ or 0));stream:shift(newOrigin);run.originZ=newOrigin;workspace.CurrentCamera.CFrame+=delta;if replayCamera then replayCamera:shift(delta)end
  end
 end
 roadAt+=dt
 if roadAt&gt;.10 then
  roadAt=0;stream:update(predicted.z)
  if mode=='drive'and run then
   if player.Character then for _,part in ipairs(player.Character:GetDescendants())do if part:IsA('BasePart')and avatarParts[part]==nil then avatarParts[part]=part.LocalTransparencyModifier;part.LocalTransparencyModifier=1 end end end
   local car=workspace:FindFirstChild('Rally_'..run.owner)
   if car then for _,part in ipairs(car:GetDescendants())do if part:IsA('BasePart')and serverParts[part]==nil then
    serverParts[part]=part.LocalTransparencyModifier;part.LocalTransparencyModifier=1
   end end end
  end
 end
 stream:work(.0025)
 if mode=='drive'and not readySent and run.owner==player.UserId and stream:ready(predicted.z)then readySent=true;remotes.Action:FireServer('ready')end
 local cf=Assets.pose(visual,predicted,route,stream:offset(),dt*(mode=='replay'and (replayPaused and 0 or replayRate)or 1))
 updateCamera(cf,dt)
 if cockpit then cockpit:update(cf,predicted,dt,run.passenger==player.UserId)end
 effects:update(predicted,dt,options,mode=='replay',route:conditions(predicted.z))
 local clock=mode=='replay'and replayTime or(clockValue+(run.status=='running'and math.min(.3,os.clock()-clockAt)or 0)+(run.penalty or 0))
 if ghostPlayer and ghostVisual then
  local ghost=ghostPlayer:sample(clock)
  if ghost then
   Assets.pose(ghostVisual,ghost,route,stream:offset(),dt)
   ui.ghost.Text=string.format('SAVED GHOST · %+0.1f m along the road',(predicted.z-ghost.z)*C.StudMetres)
  else ui.ghost.Text='Loading saved ghost…'end
 else ui.ghost.Text=mode=='replay'and (replayCamera and replayCamera:hint()or '')or 'Every finished run saves a replay. Beat your time to update its ghost.'end
 uiAt+=dt
 if uiAt&gt;.1 then
  uiAt=0;ui:runInfo(run,predicted,route,clock);presence:climate(route:conditions(predicted.z),ui.quality)
  if visual and ui.visualStatus then ui:visualStatus(visual)end
  if mode=='replay'then
   ui.playhead.Size=UDim2.fromScale(math.clamp(replayTime/math.max(1,replayPlayer.meta.duration),0,1),1)
   ui.replayLabel.Text=UI.time(replayTime)..' / '..UI.time(replayPlayer.meta.duration)..'   '..(replayCamera and replayCamera:name()or 'COCKPIT')..' CAMERA   ·   '..(replayPlayer.meta.storage or '')
  end
 end
 slowTime=dt&gt;.027 and slowTime+dt or math.max(0,slowTime-dt*.35)
 if slowTime&gt;6 and options.autoQuality and ui.quality~='low'then
  setQuality(ui.quality=='high'and 'medium'or 'low');slowTime=0
 end
end)
-- The downloaded place enters the runnable modes instead of the incomplete old garage.
-- A Studio installation into another game can keep the opt-in launcher.
task.defer(function()
 if C.AutoOpen and root:GetAttribute('AutoOpen')~=false then openExpansion()end
