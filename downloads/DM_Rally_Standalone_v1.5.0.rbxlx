        <Item class="ModuleScript" referent="RBX0000002A">
          <Properties>
            <string name="Name">Presence</string>
            <ProtectedString name="Source">-- Local, reversible ownership of the view while the optional expansion is open.
local Players=game:GetService('Players')
local Lighting=game:GetService('Lighting')
local RunService=game:GetService('RunService')
local Context=game:GetService('ContextActionService')
local UIS=game:GetService('UserInputService')
local Presence={};Presence.__index=Presence
local function finite(n)return type(n)=='number'and n==n and math.abs(n)&lt;1e9 end
function Presence.validFrame(value)
 if typeof(value)~='CFrame'then return false end
 for _,v in ipairs({value.Position,value.RightVector,value.UpVector,value.LookVector})do
  if not finite(v.X)or not finite(v.Y)or not finite(v.Z)then return false end
 end
 local look=value.LookVector.Magnitude;local up=value.UpVector.Magnitude
 return look&gt;.5 and look&lt;1.5 and up&gt;.5 and up&lt;1.5
end
local daylight={ClockTime=15.8,Brightness=2.2,Ambient=Color3.fromRGB(114,122,114),
 OutdoorAmbient=Color3.fromRGB(148,155,144),GlobalShadows=false,FogStart=800,FogEnd=6000,FogColor=Color3.fromRGB(195,213,219)}
local atmosphere={Density=.18,Haze=.5,Glare=.1,Offset=0,Color=Color3.fromRGB(205,219,229),Decay=Color3.fromRGB(139,153,157)}
function Presence.new(gui)
 return setmetatable({gui=gui,active=false,screens={},connections={},environment={}},Presence)
end
function Presence:environmentProfile(object,profile)
 if self.environment[object]then return end
 local entry={before={},after=profile};self.environment[object]=entry
 for property in pairs(profile)do entry.before[property]=object[property]end
 for property,value in pairs(profile)do object[property]=value end
end
function Presence:effect(effect)
 if effect:IsA('Atmosphere')then self:environmentProfile(effect,atmosphere)
 elseif effect:IsA('PostEffect')then self:environmentProfile(effect,{Enabled=false})end
end
function Presence:time(clock)
 if self.environment[Lighting]then self.environment[Lighting].after.ClockTime=clock;Lighting.ClockTime=clock end
end
function Presence:hide(screen)
 if screen==self.gui or not screen:IsA('ScreenGui')or self.screens[screen]then return end
 self.screens[screen]={enabled=screen.Enabled}
 screen.Enabled=false
 self.connections[#self.connections+1]=screen:GetPropertyChangedSignal('Enabled'):Connect(function()
  if self.active and screen.Enabled then screen.Enabled=false end
 end)
end
function Presence:bindKeys(map)
 self.keyMap=map
 if self.active then self:bindControls()end
end
function Presence:bindControls()
 Context:UnbindAction('ExpeditionControls')
 local keys={Enum.KeyCode.Thumbstick1,Enum.KeyCode.ButtonR2,Enum.KeyCode.ButtonL2}
 for name in pairs(self.keyMap or {W=true,S=true,A=true,D=true,Space=true,Up=true,Down=true,Left=true,Right=true})do
  local ok,key=pcall(function()return Enum.KeyCode[name]end);if ok and key then keys[#keys+1]=key end
 end
 Context:BindActionAtPriority('ExpeditionControls',function(_,state,input)
  if UIS:GetFocusedTextBox()and state~=Enum.UserInputState.End and state~=Enum.UserInputState.Cancel then return Enum.ContextActionResult.Pass end
  if self.input then self.input(input,state)end
  return Enum.ContextActionResult.Sink
 end,false,4000,table.unpack(keys))
end
function Presence:sceneProfile(original)
 self.originalScene=original==true
 for object,entry in pairs(self.environment)do
  if object==Lighting then
   entry.after=self.originalScene and table.clone(entry.before)or table.clone(daylight)
   if self.originalScene then entry.after.FogEnd=math.max(1200,tonumber(entry.before.FogEnd)or 6000)end
  elseif object:IsA('Atmosphere')then
   entry.after=self.originalScene and table.clone(entry.before)or atmosphere
   if self.originalScene then entry.after.Density=math.min(.32,tonumber(entry.before.Density)or .18);entry.after.Haze=math.min(2,tonumber(entry.before.Haze)or .5)end
  elseif object:IsA('PostEffect')then
   local keep=self.originalScene and not object:IsA('BlurEffect')and not object:IsA('DepthOfFieldEffect')
   entry.after={Enabled=keep and entry.before.Enabled or false}
  end
 end
end
function Presence:climate(conditions,quality)
 local light=self.environment[Lighting]
 if light then
  light.after.FogEnd=self.originalScene and math.max(1200,(tonumber(light.before.FogEnd)or 6000)*(conditions.wetness&gt;.3 and .85 or 1))or (conditions.wetness&gt;.3 and 2600 or 6000)
  light.after.GlobalShadows=self.originalScene and quality~='low'or quality=='high'
 end
end
function Presence:open()
 if self.active then return end
 self.active=true
 local camera=workspace.CurrentCamera
 self.camera={object=camera,parent=camera.Parent,cf=camera.CFrame,focus=camera.Focus,kind=camera.CameraType,subject=camera.CameraSubject,fov=camera.FieldOfView}
 -- Old controllers cache their Camera instance. Keep that instance intact while
 -- the expansion owns a separate view. Cameras are stored under a folder because
 -- CurrentCamera replacement can delete other cameras directly under Workspace.
 self.cameraStore=Instance.new('Folder');self.cameraStore.Name='ExpeditionCameraStore';self.cameraStore.Parent=workspace
 camera.Parent=self.cameraStore;camera.CameraType=Enum.CameraType.Scriptable
 self:ensureCamera()
 self.clock=Lighting.ClockTime
 self:environmentProfile(Lighting,table.clone(daylight))
 for _,effect in ipairs(Lighting:GetChildren())do self:effect(effect)end
 self.connections[#self.connections+1]=Lighting.ChildAdded:Connect(function(effect)self:effect(effect)end)
 local pg=Players.LocalPlayer:WaitForChild('PlayerGui')
 for _,screen in ipairs(pg:GetChildren())do self:hide(screen)end
 self.connections[#self.connections+1]=pg.ChildAdded:Connect(function(screen)self:hide(screen)end)
 self:bindControls()
 RunService:BindToRenderStep('ExpeditionCamera',Enum.RenderPriority.Last.Value,function()
  if self.active then for object,entry in pairs(self.environment)do
   if object==Lighting or object.Parent then for property,value in pairs(entry.after)do
    if object[property]~=value then object[property]=value end
   end end
  end end
  if self.active and self.desired then
   local current=self:ensureCamera();current.CameraType=Enum.CameraType.Scriptable
   current.CFrame=self.desired;current.Focus=self.desired*CFrame.new(0,0,-32);current.FieldOfView=self.fov or 72
  end
 end)
end
function Presence:ensureCamera()
 local current=self.managedCamera
 if not current or current.Parent~=self.cameraStore then
  current=Instance.new('Camera');current.Name='ExpeditionView';current.Parent=self.cameraStore
  local previous=workspace.CurrentCamera
  if previous then
   -- ViewportSize is renderer-owned in Studio; copying only supports test doubles.
   pcall(function()current.ViewportSize=previous.ViewportSize end)
  end
  current.CameraType=Enum.CameraType.Scriptable
  if self.desired then current.CFrame=self.desired end
  current.FieldOfView=self.fov or 72;self.managedCamera=current
 end
 if workspace.CurrentCamera~=current then workspace.CurrentCamera=current end
 return current
end
function Presence:view(cf,fov)
 if not Presence.validFrame(cf)then
  self.invalidFrames=(self.invalidFrames or 0)+1;self.gui:SetAttribute('RejectedViewFrames',self.invalidFrames)
  return false
 end
 self.desired=cf;self.fov=finite(fov)and math.clamp(fov,20,110)or 72
 return true
end
function Presence:close()
 if not self.active then return end
 self.active=false
 RunService:UnbindFromRenderStep('ExpeditionCamera');Context:UnbindAction('ExpeditionControls')
 for _,connection in ipairs(self.connections)do connection:Disconnect()end
 self.connections={}
 for screen,data in pairs(self.screens)do if screen.Parent then screen.Enabled=data.enabled end end
 self.screens={}
 local old=self.camera
 if old then
  local camera=old.object
  workspace.CurrentCamera=camera
  camera.Parent=old.parent;camera.CameraType=old.kind;camera.CameraSubject=old.subject;camera.CFrame=old.cf;camera.FieldOfView=old.fov
  if old.focus then camera.Focus=old.focus end
 end
 if self.cameraStore then self.cameraStore:Destroy()end
 self.cameraStore=nil;self.managedCamera=nil
 Lighting.ClockTime=self.clock
 for object,entry in pairs(self.environment)do if object==Lighting or object.Parent then
  for property,value in pairs(entry.before)do object[property]=value end
 end end
 self.environment={}
 self.desired=nil;self.camera=nil
end
return Presence
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000002B">
          <Properties>
            <string name="Name">ReplayCamera</string>
            <ProtectedString name="Source">-- Replay-only camera rig. Driving cameras are owned by the driving controller.
-- No per-frame instances, raycasts or network traffic; director shots are local.
local Rig={};Rig.__index=Rig
local names={'COCKPIT','CHASE','ORBIT','DIRECTOR','FREECAM'}
local function clampDt(dt)return math.clamp(tonumber(dt)or 0,0,.1)end
local function flat(v)
 local f=Vector3.new(v.X,0,v.Z)
 return f.Magnitude&gt;.001 and f.Unit or Vector3.new(0,0,-1)
end
function Rig.new(camera,uis,options)
 assert(camera and uis,'Replay camera requires camera and input service')
 local self=setmetatable({camera=camera,input=uis,options=options or {},mode=2,held={},connections={},angle=0,pitch=.3,distance=22,
  yaw=0,freePitch=0,freeSpeed=35,fov=70,alive=true,mouseHeld=false,frames=0},Rig)
 self.saved={cameraType=camera.CameraType,cframe=camera.CFrame,fov=camera.FieldOfView,
  mouseBehavior=uis.MouseBehavior,mouseIcon=uis.MouseIconEnabled}
 local function connect(signal,fn)self.connections[#self.connections+1]=signal:Connect(fn)end
 connect(uis.InputBegan,function(event,processed)
  if processed or uis:GetFocusedTextBox()then return end
  self:controlInput(event,Enum.UserInputState.Begin)
 end)
 connect(uis.InputEnded,function(event)
  self:controlInput(event,Enum.UserInputState.End)
 end)
 connect(uis.InputChanged,function(event)self:inputChanged(event)end)
 connect(uis.WindowFocusReleased,function()self.held={};self.mouseHeld=false;self:releaseMouse()end)
 return self
end
-- ContextActionService sinks the game's movement keys, marking raw UIS events
-- processed. The owning controller forwards those keys through this method.
function Rig:canInput()
 local allowed=self.alive and not self.input:GetFocusedTextBox()and (not self.options.canInput or self.options.canInput())
 if not allowed then self.held={};self.mouseHeld=false;self:releaseMouse()end
 return allowed
end
function Rig:controlInput(event,state)
 if not self:canInput()then return end
 local ended=state==Enum.UserInputState.End or state==Enum.UserInputState.Cancel
 if not ended and self.input:GetFocusedTextBox()then return end
 self.held[event.KeyCode.Name]=not ended or nil
 if event.UserInputType==Enum.UserInputType.MouseButton2 then
  self.mouseHeld=not ended;if ended then self:releaseMouse()end
 end
end
function Rig:name()return names[self.mode]end
function Rig:hint()
 if self.mode==5 then return 'RMB look · WASD move · Q/E down/up · Shift fast · wheel FOV'end
 if self.mode==3 then return 'RMB orbit · wheel distance'end
 if self.mode==4 then return 'Automatic roadside shots · C switch camera'end
 return 'C switch camera · P pause · , . seek'
end
function Rig:releaseMouse()
 if self.mouseCaptured then
  self.input.MouseBehavior=self.saved.mouseBehavior
  self.input.MouseIconEnabled=self.saved.mouseIcon
  self.mouseCaptured=false
 end
end
function Rig:setMode(mode)
 local n=type(mode)=='number'and mode or table.find(names,tostring(mode):upper())
 if not n or n~=math.floor(n)or n&lt;1 or n&gt;#names then return self:name()end
 self.mode=n;self.initialized=false;self.shot=nil;self.freeFrame=nil
 self:releaseMouse()
 return self:name()
end
function Rig:cycle()return self:setMode(self.mode%#names+1)end
function Rig:inputChanged(event)
 if not self:canInput()or event.UserInputType~=Enum.UserInputType.MouseWheel then return end
 local z=event.Position.Z
 if self.mode==5 then self.fov=math.clamp(self.fov-z*3,25,100)
 elseif self.mode==3 then self.distance=math.clamp(self.distance-z*2,6,85)end
end
function Rig:shift(delta)
 if self.freeFrame then self.freeFrame+=delta end
 if self.shot then self.shot.position+=delta end
 if self.lastPosition then self.lastPosition+=delta end
end
function Rig:_mouseDelta()
 if not self:canInput()then return 0,0 end
 if not self.mouseHeld and not self.input:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)then self:releaseMouse();return 0,0 end
 if not self.mouseCaptured then self.mouseCaptured=true end
 self.input.MouseBehavior=Enum.MouseBehavior.LockCurrentPosition;self.input.MouseIconEnabled=false
 local d=self.input:GetMouseDelta();return d.X,d.Y
end
function Rig:update(cf,state,dt,time)
 if not self.alive then return self.camera.CFrame end
 dt=clampDt(dt);time=tonumber(time)or 0;state=state or {}
 local camera=self.camera;camera.CameraType=Enum.CameraType.Scriptable
 local speed=math.abs(state.v or 0);local forward=cf.LookVector;local up=Vector3.new(0,1,0)
 local discontinuity=self.lastTime and (math.abs(time-self.lastTime)&gt;1 or (self.lastPosition and (cf.Position-self.lastPosition).Magnitude&gt;180))
 if discontinuity then self.initialized=false;self.shot=nil end
 self.lastTime=time;self.lastPosition=cf.Position
 local mx,my=self:_mouseDelta();local target;local fov=70
 if self.mode==5 then
  if not self.freeFrame then
   self.freeFrame=camera.CFrame
   local look=self.freeFrame.LookVector
   self.yaw=math.atan2(-look.X,-look.Z);self.freePitch=math.asin(math.clamp(look.Y,-1,1))
  end
  self.yaw-=mx*.003;self.freePitch=math.clamp(self.freePitch-my*.003,-1.5,1.5)
  local rotation=CFrame.Angles(0,self.yaw,0)*CFrame.Angles(self.freePitch,0,0)
  local h=self.held
  local move=Vector3.new(((h.D or h.Right)and 1 or 0)-((h.A or h.Left)and 1 or 0),0,
   ((h.S or h.Down)and 1 or 0)-((h.W or h.Up)and 1 or 0))
  if move.Magnitude&gt;1 then move=move.Unit end
  local vertical=((h.E or h.PageUp)and 1 or 0)-((h.Q or h.PageDown)and 1 or 0)
  local rate=self.freeSpeed*((h.LeftShift or h.RightShift)and 3 or 1)*((h.LeftAlt or h.RightAlt)and .2 or 1)
  local delta=(rotation.RightVector*move.X+rotation.LookVector*(-move.Z)+up*vertical)*dt*rate
  self.freeFrame=CFrame.new(self.freeFrame.Position+delta)*rotation;target=self.freeFrame;fov=self.fov
 elseif self.mode==1 then
  -- Car pose already includes suspension pitch and roll; replay preserves it.
  local offset=self.options.cockpitOffset or Vector3.new(-.7,2.05,.15)
  local pos=cf*offset;target=CFrame.lookAt(pos,pos+forward*45,cf.UpVector);fov=self.options.cockpitFov or 76
 elseif self.mode==3 then
  self.angle-=mx*.004;self.pitch=math.clamp(self.pitch-my*.003,-.05,1.2)
  local horizontal=math.cos(self.pitch)*self.distance
  local offset=Vector3.new(math.sin(self.angle)*horizontal,math.sin(self.pitch)*self.distance+2,math.cos(self.angle)*horizontal)
  target=CFrame.lookAt(cf.Position+offset,cf.Position+up);fov=65
 elseif self.mode==4 then
  local segment=math.floor(time/6)
  if not self.shot or self.shot.segment~=segment then
   local front=flat(forward);local right=flat(cf.RightVector);local choice=segment%4
   local ahead=math.clamp(speed*1.7,18,70)
   local position
   if choice==0 then position=cf.Position+front*ahead+right*18+up*4
   elseif choice==1 then position=cf.Position-front*15-right*27+up*9
   elseif choice==2 then position=cf.Position+front*26+right*35+up*20
   else position=cf.Position-front*22+right*14+up*3 end
   self.shot={segment=segment,position=position};self.initialized=false
  end
  target=CFrame.lookAt(self.shot.position,cf.Position+up*.8+forward*math.min(4,speed*.025));fov=48
 else
  local pos=cf.Position-forward*(15+speed*.035)+up*5.4
  target=CFrame.lookAt(pos,cf.Position+forward*7+up*1.3);fov=68+math.min(8,speed*.045)
 end
 local smooth=self.mode==1 and 18 or self.mode==3 and 14 or self.mode==4 and 12 or 8
 camera.CFrame=self.initialized and self.mode~=5 and camera.CFrame:Lerp(target,1-math.exp(-smooth*dt))or target
 camera.FieldOfView=fov;self.initialized=true;self.frames+=1
 return camera.CFrame
end
function Rig:destroy()
 if not self.alive then return end;self.alive=false
 for _,connection in ipairs(self.connections)do connection:Disconnect()end;self.connections={};self.held={}
 self:releaseMouse()
 self.camera.CameraType=self.saved.cameraType;self.camera.CFrame=self.saved.cframe;self.camera.FieldOfView=self.saved.fov
end
return Rig
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000002C">
          <Properties>
            <string name="Name">ReplayPlayer</string>
            <ProtectedString name="Source">local root=game:GetService('ReplicatedStorage'):WaitForChild('BackseatExpedition')
local Codec=require(root.Shared.Replay)
local Player={};Player.__index=Player
function Player.new(remote,metadata)
 return setmetatable({remote=remote,meta=metadata,cache={},pending={},queue={},alive=true,errors={}},Player)
end
function Player:page(index)
 if not self.alive or not self.meta.pages[index]or self.cache[index]or self.pending[index]then return end
 self.pending[index]=true;self.queue[#self.queue+1]=index
 if self.worker then return end;self.worker=true
 task.spawn(function()
  while self.alive and #self.queue&gt;0 do
   local i=table.remove(self.queue,1);local result
   -- Seeking drops queued fetches for pages far from the new playhead.
   if self.current and math.abs(i-self.current)&gt;2 then self.pending[i]=nil;continue end
   for attempt=1,3 do
    local ok,response=pcall(function()return self.remote:InvokeServer('page',{id=self.meta.id,index=i})end)
    if ok and response and response.text then
     local decoded,frames=pcall(Codec.decode,response.text)
     if decoded and #frames&gt;0 then result=frames;break else self.errors[i]='Invalid replay data'end
    else self.errors[i]=ok and response and response.error or 'Connection interrupted'end
    task.wait(.5*attempt)
   end
   if not self.alive then break end
   self.cache[i]=result;self.pending[i]=nil
   if result then self.errors[i]=nil end
   -- A five-page moving cache bounds both ghost and replay memory.
   for j in pairs(self.cache)do if math.abs(j-(self.current or i))&gt;2 then self.cache[j]=nil end end
   task.wait(.18)
  end
  self.worker=false
 end)
end
function Player:sample(t)
 if not self.alive then return nil,'Replay closed'end
 if type(t)~='number'or t~=t or math.abs(t)==math.huge then return nil,'Invalid replay time'end
 local pages=self.meta.pages;if #pages==0 then return nil,'Replay has no recorded frames'end
 local index=1
 for i,p in ipairs(pages)do if p.from&lt;=t then index=i else break end end
 self.current=index
 -- Bound the seek queue as well as the cache; repeated scrubbing cannot build
 -- an unbounded list of obsolete HTTP/DataStore requests.
 for i=#self.queue,1,-1 do
  local queued=self.queue[i]
  if math.abs(queued-index)&gt;2 then self.pending[queued]=nil;table.remove(self.queue,i)end
 end
 self:page(index);self:page(index+1)
 local frames=self.cache[index]
 if not frames then return nil,self.errors[index]or 'Loading replay…'end
 if frames[#frames][1]&lt;t*1000 and self.cache[index+1]then
  local joined=table.clone(frames);joined[#joined+1]=self.cache[index+1][1];return Codec.sample(joined,t)
 end
 return Codec.sample(frames,t)
end
function Player:destroy()self.alive=false;self.queue={};self.cache={};self.pending={}end
return Player
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX0000002D">
          <Properties>
            <string name="Name">RoadStream</string>
            <ProtectedString name="Source">-- Bounded chunk window; generation jobs yield frequently and recycle parts.
local Root=game:GetService('ReplicatedStorage'):WaitForChild('BackseatExpedition')
local C=require(Root.Shared.Config);local Route=require(Root.Shared.Route)
local Loader=require(Root.Shared.AssetLoader)
local Stream={};Stream.__index=Stream
local function rgb(a)return Color3.new(a[1],a[2],a[3])end
function Stream.new(parent)
 local folder=Instance.new('Folder');folder.Name='RallyWorld';folder.Parent=parent
 return setmetatable({folder=folder,chunks={},queue={},pool={},quality='medium',made=0,epoch=0},Stream)
end
function Stream:part(parent,name,size,cf,tint,material,shape)
 local p=table.remove(self.pool)or Instance.new('Part')
 p.Name=name;p.Size=size;p.CFrame=cf;p.Color=rgb(tint);p.Material=material or Enum.Material.SmoothPlastic
 p.Shape=shape or Enum.PartType.Block;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false
 p.CastShadow=false;p.Transparency=0;p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=parent
 self.made+=1;if self.made%8==0 then coroutine.yield()end
 return p
end
function Stream:release(chunk)
 for _,p in ipairs(chunk:GetChildren())do
  if p:IsA('BasePart')and #self.pool&lt;400 then p:ClearAllChildren();p.Parent=nil;self.pool[#self.pool+1]=p else p:Destroy()end
 end
 chunk:Destroy()
end
function Stream:reset(route,slot,originZ)
 self:restoreOriginal()
 self.epoch+=1;self.route=route;self.slot=slot or 1;self.originZ=originZ or 0
 for _,entry in pairs(self.chunks)do self:release(entry.model)end
 self.chunks={};self.queue={}
end
function Stream:shift(originZ)
 if self.route and self.route.original then return end
 if originZ==self.originZ then return end
 local delta=Vector3.new(0,0,originZ-self.originZ)
 for _,entry in pairs(self.chunks)do
  -- Jobs resume with the new origin, so unfinished chunks are rebuilt.
  if entry.done then for _,part in ipairs(entry.model:GetDescendants())do if part:IsA('BasePart')then part.CFrame+=delta end end else entry.cancel=true end
 end
 self.originZ=originZ
end
function Stream:offset()if self.route and self.route.original then return Vector3.zero end;return Vector3.new(C.WorldX+(self.slot or 1)*C.LaneSpacing,0,self.originZ or 0)end
function Stream:decor(model,index)
 local route=self.route;local cfg=C.Quality[self.quality];local offset=self:offset()
 local imported=Root:FindFirstChild('ImportedProps')
 local templates=imported and imported:GetChildren()or {}
 local z0=index*C.Chunk;local biome=C.Biomes[route:point(z0).biome]
 for i=1,cfg.props do
  local r=Route.random(route.seed,index*71+i*7);local z=z0+r*C.Chunk
  local p=route:point(z);local side=i%2==0 and 1 or -1;local x=p.x+side*(p.width/2+20+Route.random(route.seed,i+index*33)*65)
  local at=Vector3.new(x,p.y-2,z)+offset
  local height=8+Route.random(route.seed,i*71+index)*10
  local template=C.ImportedVisuals and biome.trees and #templates&gt;0 and self.quality~='low'and templates[(i-1)%#templates+1]
  if template and Loader.ready(template)then
   local prop=template:Clone();prop.Parent=model;prop:PivotTo(CFrame.new(at)*CFrame.Angles(0,r*6,0))
   coroutine.yield()
  elseif biome.trees and i%3~=0 then
   self:part(model,'Pine trunk',Vector3.new(1,height*.6,1),CFrame.new(at+Vector3.new(0,height*.3,0)),{.25,.20,.14},Enum.Material.Wood)
   local layers=self.quality=='low'and 1 or 2
   for level=1,layers do
    local size=(height*.65)*(1-(level-1)*.28)
    self:part(model,'Pine canopy',Vector3.new(size,height*.48,size),CFrame.new(at+Vector3.new(0,height*(.50+level*.16),0)),{.14,.27+level*.015,.19},Enum.Material.Grass,Enum.PartType.Ball)
   end
  elseif biome.desert and i%2==0 then
   self:part(model,'Cactus',Vector3.new(1.3,height*.65,1.3),CFrame.new(at+Vector3.new(0,height*.325,0)),{.28,.42,.27})
   self:part(model,'Cactus arm',Vector3.new(4,1,1),CFrame.new(at+Vector3.new(1,height*.4,0)),{.28,.42,.27})
  else
   self:part(model,'Boulder',Vector3.new(height*.7,height*.4,height*.55),CFrame.new(at+Vector3.new(0,height*.17,0))*CFrame.Angles(.12,r*4,.18),biome.snow and {.71,.74,.72}or{.39,.38,.33},Enum.Material.Slate,Enum.PartType.Ball)
  end
 end
 -- Distant low-poly landforms give each biome a readable skyline.
 local p=route:point(z0+C.Chunk/2)
 for _,side in ipairs({-1,1})do
  local h=biome.desert and 90 or 140
  self:part(model,'Distant ridge',Vector3.new(240,h,320),CFrame.new(p.x+side*420,p.y+h*.25-20,z0+128)*CFrame.new(offset),biome.ground,Enum.Material.Rock,Enum.PartType.Ball)
 end
end
function Stream:build(index,entry)
 local route=self.route;local model=entry.model;local offset=self:offset();local start=index*C.Chunk
 for z=start,start+C.Chunk-C.RoadStep,C.RoadStep do
  if entry.cancel or entry.epoch~=self.epoch then return end
  local a,b=route:point(z),route:point(z+C.RoadStep);local p=route:point(z+C.RoadStep/2)
  local pos=Vector3.new((a.x+b.x)/2,(a.y+b.y)/2,z+C.RoadStep/2)+offset
  local dir=Vector3.new(b.x-a.x,b.y-a.y,C.RoadStep)
  -- Match the analytic heightfield, including grade across a curved, banked road.
  local slope=math.tan(p.bank)/math.sqrt(1+p.dx*p.dx)
  local normal=Vector3.new(-slope,1,p.dx*slope-p.dy).Unit
  local frame=CFrame.lookAt(pos,pos+dir,normal)
  frame=frame-frame.UpVector*.35
  local length=dir.Magnitude+.04;local biome=C.Biomes[p.biome]
  self:part(model,'Road',Vector3.new(p.width,.7,length),frame,biome.road,p.surface=='tarmac'and Enum.Material.Asphalt or Enum.Material.Ground)
  local seam=CFrame.lookAt(Vector3.new(b.x,b.y-.362,b.z)+offset,Vector3.new(b.x+b.dx,b.y-.362+b.dy,b.z+1)+offset,normal)
  self:part(model,'Road seam',Vector3.new(p.width,.7,math.max(.12,p.width*math.abs(b.heading-a.heading)+.12)),seam,biome.road,p.surface=='tarmac'and Enum.Material.Asphalt or Enum.Material.Ground)
  for _,side in ipairs({-1,1})do
   self:part(model,'Shoulder',Vector3.new(3,.5,length),frame*CFrame.new(side*(p.width/2+1.5),-.18,0),biome.ground,Enum.Material.Ground)
   if p.bridge or p.tunnel then
    self:part(model,'Safety rail',Vector3.new(.5,2.8,length),frame*CFrame.new(side*(p.width/2+.6),1.5,0),{.57,.59,.55},Enum.Material.Metal)
   end
  end
  if p.bridge and z==start then
   local water=self:part(model,'River',Vector3.new(320,.3,C.Chunk+8),CFrame.new(p.x,-12,start+C.Chunk/2)+offset,{.16,.36,.39},Enum.Material.Glass);water.Transparency=.2
  end
  if p.bridge and z%64==0 then
   for _,side in ipairs({-1,1})do self:part(model,'Bridge pier',Vector3.new(2,28,3),frame*CFrame.new(side*11,-14,0),{.36,.37,.34},Enum.Material.Concrete)end
  end
  if not p.bridge then self:part(model,'Land',Vector3.new(190,5,math.max(.1,length-.08)),frame*CFrame.new(0,-4,0),biome.ground,Enum.Material.Grass)end
  if z%32==0 and p.surface=='tarmac'then self:part(model,'Centre dash',Vector3.new(.25,.04,8),frame*CFrame.new(0,.38,0),{.88,.85,.68})end
  if p.tunnel and z%32==0 then
   self:part(model,'Tunnel roof',Vector3.new(p.width+4,2,35),frame*CFrame.new(0,13,0),{.30,.32,.32},Enum.Material.Concrete)
   for _,side in ipairs({-1,1})do self:part(model,'Tunnel wall',Vector3.new(1,12,35),frame*CFrame.new(side*(p.width/2+1.5),6,0),{.31,.33,.32},Enum.Material.Concrete)end
   self:part(model,'Tunnel strip',Vector3.new(.3,.15,14),frame*CFrame.new(0,11.8,0),{.9,.77,.48},Enum.Material.Neon)
  end
  if z&gt;=0 and z%128==0 and math.abs(p.curvature)&gt;.0013 then
   local sign=self:part(model,'Turn marker',Vector3.new(3.5,3,.2),frame*CFrame.new(p.width/2+5,3,0),{.94,.72,.22})
   local face=Instance.new('SurfaceGui');face.Face=Enum.NormalId.Back;face.CanvasSize=Vector2.new(120,120);face.Parent=sign
   local text=Instance.new('TextLabel');text.Size=UDim2.fromScale(1,1);text.BackgroundTransparency=1;text.Text=p.curvature&gt;0 and '←'or '→';text.TextScaled=true;text.TextColor3=Color3.fromRGB(25,30,25);text.Parent=face
  end
  if z&gt;=0 and (z%C.Checkpoint==0 or z==route.length and route.length&gt;0)then
   for _,side in ipairs({-1,1})do self:part(model,'Timing post',Vector3.new(.4,7,.4),frame*CFrame.new(side*(p.width/2+2),3.5,0),{.95,.72,.29})end
   self:part(model,'Timing banner',Vector3.new(p.width+5,1.5,.3),frame*CFrame.new(0,7,0),{.14,.27,.23})
   local service=self:part(model,'Service bay sign',Vector3.new(6,2.6,.2),frame*CFrame.new(-p.width/2-6,3,-9),{.12,.24,.21})
   local face=Instance.new('SurfaceGui');face.Face=Enum.NormalId.Back;face.CanvasSize=Vector2.new(360,160);face.Parent=service
   local text=Instance.new('TextLabel');text.Size=UDim2.fromScale(1,1);text.BackgroundTransparency=1;text.Text='SERVICE BAY\nSTOP · REPAIR / TYRES';text.TextScaled=true;text.TextColor3=Color3.fromRGB(240,213,154);text.Parent=face
  end
 end
 self:decor(model,index);entry.done=true
end
-- Reuse the baked map that was uploaded. Its visual EditableMesh is not saved,
-- but the original invisible native road/shoulder/verge Parts contain its shape.
-- Appearance changes are local and restored exactly when the rally closes.
function Stream:restoreOriginal()
 if self.originalConnection then self.originalConnection:Disconnect();self.originalConnection=nil end
 for part,old in pairs(self.originalParts or {})do if part.Parent then
  part.Transparency=old.transparency;part.Color=old.color;part.Material=old.material
 end end
 self.originalParts={};self.originalRoads={};self.originalStage=nil;self.originalCollision=nil;self.requestedAt=nil;self.requestedSection=nil
end
function Stream:originalAppearance(part)
 if not part:IsA('BasePart')or self.originalParts[part]then return end
 local name=part.Name
 if name~='Road'and name~='Shoulder'and name~='Verge'then return end
 self.originalParts[part]={transparency=part.Transparency,color=part.Color,material=part.Material}
 -- Palette values from the uploaded Shared.Core.RoadProfile table.
 local surface=part:GetAttribute('Surface')
 local gravel=surface and surface~='Tarmac'or (not surface and self.route.stageId=='PineForest')
 if name=='Road'then
  part.Color=gravel and Color3.fromRGB(176,158,124)or Color3.fromRGB(66,68,74)
  part.Material=gravel and Enum.Material.Ground or Enum.Material.Asphalt
  self.originalRoads[#self.originalRoads+1]=part
 elseif name=='Shoulder'then part.Color=gravel and Color3.fromRGB(158,148,112)or Color3.fromRGB(150,142,116);part.Material=Enum.Material.Ground
 else part.Color=Color3.fromRGB(112,132,70);part.Material=Enum.Material.Grass end
 part.Transparency=0
end
function Stream:updateOriginal(progress)
 local world=workspace:FindFirstChild('World');local stage=world and world:FindFirstChild('Stage_'..self.route.stageId)
 local collision=stage and stage:FindFirstChild('Collision')
 if stage~=self.originalStage or collision~=self.originalCollision then
  if self.originalConnection then self.originalConnection:Disconnect();self.originalConnection=nil end
  self.originalStage=stage;self.originalCollision=collision
  if collision then
   for _,part in ipairs(collision:GetDescendants())do self:originalAppearance(part)end
   if collision.DescendantAdded then self.originalConnection=collision.DescendantAdded:Connect(function(part)self:originalAppearance(part)end)end
  end
 end
 local section=math.floor(progress/256)
 if self.requestedSection~=section and os.clock()-(self.requestedAt or -100)&gt;2 then
  self.requestedSection=section;self.requestedAt=os.clock()
  local player=game:GetService('Players').LocalPlayer;local point=self.route:worldPoint(progress+90)
  if player and player.RequestStreamAroundAsync then task.spawn(function()pcall(function()player:RequestStreamAroundAsync(point,2)end)end)end
 end
end
function Stream:update(z)
 if not self.route then return end
 if self.route.original then self:updateOriginal(z);return end
 local cfg=C.Quality[self.quality];local centre=math.floor(math.max(0,z)/C.Chunk);local wanted={}
 for i=math.max(-1,centre-cfg.behind),centre+cfg.ahead do wanted[i]=true end
 for i,entry in pairs(self.chunks)do
  if not wanted[i]or entry.cancel then entry.cancel=true;self:release(entry.model);self.chunks[i]=nil end
 end
 -- Prioritize the piece beneath the car and its immediate approach.
 local order={centre,centre+1,centre-1}
 for i=centre+2,centre+cfg.ahead do order[#order+1]=i end
 for i=centre-2,math.max(-1,centre-cfg.behind),-1 do order[#order+1]=i end
 for _,i in ipairs(order)do if wanted[i]and not self.chunks[i]then
  local model=Instance.new('Model');model.Name='Road_'..i;model.Parent=self.folder
  local entry={model=model,epoch=self.epoch};self.chunks[i]=entry
  entry.job=coroutine.create(function()self:build(i,entry)end);self.queue[#self.queue+1]=entry
 end end
end
function Stream:work(budget)
 if self.route and self.route.original then return end
 local began=os.clock()
 while #self.queue&gt;0 and os.clock()-began&lt;budget do
  local entry=self.queue[1]
  if entry.cancel or entry.epoch~=self.epoch or coroutine.status(entry.job)=='dead'then table.remove(self.queue,1)
  else local ok,err=coroutine.resume(entry.job);if not ok then entry.cancel=true;warn('Road generation failed: '..tostring(err));table.remove(self.queue,1)end end
 end
end
function Stream:ready(z)
 if self.route and self.route.original then
  local at=self.route:worldPoint(z)
  for _,part in ipairs(self.originalRoads or {})do if part.Parent then
   local delta=part.Position-at
   if delta.X*delta.X+delta.Z*delta.Z&lt;math.max(22,part.Size.Z)^2 and math.abs(delta.Y)&lt;12 then return true end
  end end
  return false
 end
 local index=math.floor(math.max(0,z)/C.Chunk)
 return self.chunks[index]and self.chunks[index].done and self.chunks[index+1]and self.chunks[index+1].done
end
function Stream:destroy()
 self:restoreOriginal()
 self.epoch+=1;for _,entry in pairs(self.chunks)do entry.cancel=true;self:release(entry.model)end
 for _,p in ipairs(self.pool)do p:Destroy()end;self.chunks={};self.pool={};self.folder:Destroy()
end
return Stream
</ProtectedString>
