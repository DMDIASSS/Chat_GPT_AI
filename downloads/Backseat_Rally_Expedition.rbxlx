  <Item class="ServerStorage" referent="RBX00000007">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
  </Item>
  <Item class="ReplicatedFirst" referent="RBX00000008">
    <Properties>
      <string name="Name">ReplicatedFirst</string>
    </Properties>
  </Item>
  <Item class="StarterGui" referent="RBX00000009">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="RBX0000000A">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX0000000B">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="RBX0000001F">
        <Properties>
          <string name="Name">BackseatExpeditionClient</string>
        </Properties>
        <Item class="LocalScript" referent="RBX00000020">
          <Properties>
            <string name="Name">Main</string>
            <ProtectedString name="Source">local Players=game:GetService('Players');local RS=game:GetService('ReplicatedStorage')
local RunService=game:GetService('RunService');local UIS=game:GetService('UserInputService');local Lighting=game:GetService('Lighting')
local player=Players.LocalPlayer;local root=RS:WaitForChild('BackseatExpedition');local remotes=root.Remotes
local C=require(root.Shared.Config);local Route=require(root.Shared.Route);local D=require(root.Shared.Dynamics);local Assets=require(root.Shared.Assets)
local Presence=require(script.Parent.Presence);local UI=require(script.Parent.UI);local RoadStream=require(script.Parent.RoadStream);local ReplayPlayer=require(script.Parent.ReplayPlayer)
local mode='closed';local scene,stream,visual,route,run,predicted,ghostPlayer,ghostVisual,replayPlayer
local replayTime,replayRate,replayPaused=0,1,false
local held={};local gamepad={steer=0,throttle=0,brake=0};local seq=0;local sent=0;local accumulator=0;local roadAt=0
local cameraMode=1;local cameraNames={'CHASE','HOOD','ORBIT','FREE'};local orbitAngle,orbitPitch,orbitDistance=0,.35,20
local freeFrame;local readySent=false;local noticeUntil=0;local lastFrame;local clockAt,clockValue=0,0
local correction;local countdownUntil;local ui;local presence;local menuPark;local closing=false
local openExpansion,closeExpansion
local function notice(text,seconds)if ui then ui.message.Text=tostring(text);noticeUntil=os.clock()+(seconds or 3)end end
local function invoke(kind,data)
 local ok,response=pcall(function()return remotes.Request:InvokeServer(kind,data)end)
 if not ok then return {error='Connection interrupted; try again'}end
 return response or {error='No response'}
end
local function controls()
 local focus=UIS:GetFocusedTextBox();if focus then return {throttle=0,brake=.5,steer=0}end
 local reversing=held.brake and predicted and predicted.v&lt;.8
 return {throttle=held.throttle and 1 or ((held.reverse or reversing)and -1 or gamepad.throttle),
  brake=held.brake and not reversing and 1 or gamepad.brake,steer=held.left and -1 or (held.right and 1 or gamepad.steer),handbrake=held.handbrake==true}
end
local function clearScene()
 if ghostPlayer then ghostPlayer:destroy();ghostPlayer=nil end
 if replayPlayer then replayPlayer:destroy();replayPlayer=nil end
 if stream then stream:destroy();stream=nil end
 if scene then scene:Destroy();scene=nil end
 visual=nil;ghostVisual=nil;predicted=nil;correction=nil;lastFrame=nil;freeFrame=nil;held={}
end
local function menuCamera()
 if not menuPark then
  menuPark=Instance.new('Model');menuPark.Name='ExpeditionLocalPark';menuPark.Parent=workspace
  Assets.park(menuPark);menuPark:PivotTo(CFrame.new(C.WorldX,0,0))
 end
 local camera=workspace.CurrentCamera;camera.CameraType=Enum.CameraType.Scriptable
 camera.CFrame=CFrame.lookAt(Vector3.new(C.WorldX+52,22,53),Vector3.new(C.WorldX,3,-12));camera.FieldOfView=56
 presence:view(camera.CFrame,56)
end
local function getCar(id)for _,car in ipairs(C.Cars)do if car.id==id then return car end end;return C.Cars[1]end
local function refreshLobby()
 task.spawn(function()local data=invoke('lobby');if data.error then notice(data.error)else ui:lobby(data)end end)
end
local function exitToMenu()
 clearScene();mode='menu';run=nil;ui:show('menu');menuCamera();refreshLobby()
end
local function setQuality(quality)if stream then stream.quality=quality end end
local function setup(metadata,initial)
 if menuPark then menuPark:Destroy();menuPark=nil end
 clearScene();run=metadata;route=Route.new(metadata.seed,metadata.length,C)
 scene=Instance.new('Folder');scene.Name='ExpeditionLocal';scene.Parent=workspace
 stream=RoadStream.new(scene);stream.quality=ui.quality;stream:reset(route,metadata.slot or 1,metadata.originZ or 0)
 visual=Assets.car(scene,getCar(metadata.car),false,ui.quality~='low',true)
 predicted=initial or D.new(route);readySent=false;accumulator=0;cameraMode=1;roadAt=0
 workspace.CurrentCamera.CameraType=Enum.CameraType.Scriptable;workspace.CurrentCamera.FieldOfView=72
 presence:time(metadata.mode=='daily'and 18.15 or 15.8)
end
local function loadGhost(id)
 if not id then return end
 local active=run and run.id
 task.spawn(function()
  local data=invoke('replay',{id=id})
  if not run or run.id~=active or mode~='drive'or data.error or not data.record or data.record.generation~=C.Generation then return end
  ghostPlayer=ReplayPlayer.new(remotes.Request,data.record);ghostVisual=Assets.car(scene,getCar(data.record.car),true,false);ghostPlayer:page(1)
 end)
end
local function watch(record)
 if record.generation~=C.Generation then notice('This replay uses a different road generation version.');return end
 mode='replay';setup({seed=record.seed,length=record.length,slot=1,originZ=0,mode=record.mode,car=record.car,passenger=0},nil)
 replayPlayer=ReplayPlayer.new(remotes.Request,record);replayPlayer:page(1)
 replayTime=record.startTime or 0;replayRate=1;replayPaused=false;ui:show('replay');notice('Loading saved replay…',2)
 for _,child in ipairs(ui.timeline:GetChildren())do if child.Name=='Moment'then child:Destroy()end end
 for _,t in ipairs(record.markers or {})do
  local marker=Instance.new('Frame');marker.Name='Moment';marker.Size=UDim2.fromOffset(3,16)
  marker.Position=UDim2.new(t/math.max(record.duration,1),-1,0,0);marker.BorderSizePixel=0;marker.BackgroundColor3=Color3.fromRGB(237,126,84);marker.Parent=ui.timeline
 end
end
ui=UI.new({
 open=function()openExpansion()end,close=function()
  if mode=='drive'then closing=true;remotes.Action:FireServer(run and run.owner~=player.UserId and 'leave'or 'retire');notice('Saving the run…')else closeExpansion()end
 end,
 start=function(modeId,carId,seed)
  if mode=='drive'then return end
  if mode=='replay'then clearScene();mode='menu'end
  remotes.Action:FireServer('start',{mode=modeId,car=carId,seed=seed});notice('Preparing your road…',2)
 end,
 library=function()task.spawn(function()local data=invoke('library');if data.error then notice(data.error)else ui:library(data)end end)end,
 lobby=refreshLobby,quality=setQuality,
 stop=function()if mode=='drive'then remotes.Action:FireServer('retire')end end,
 recover=function()if mode=='drive'then remotes.Action:FireServer('recover')end end,
 bookmark=function()if mode=='drive'then remotes.Action:FireServer('bookmark')end end,
 camera=function()cameraMode=cameraMode%(mode=='replay'and 4 or 3)+1;freeFrame=workspace.CurrentCamera.CFrame;notice(cameraNames[cameraMode]..' CAMERA',1.5)end,
 join=function(owner)remotes.Action:FireServer('join',{owner=owner})end,
 leave=function()remotes.Action:FireServer('leave')end,
 call=function(note)remotes.Action:FireServer('call',{note=note})end,
 touch=function(key,down)held[key]=down end,
 watch=watch,
 seek=function(fraction)if replayPlayer then replayTime=math.clamp(fraction*replayPlayer.meta.duration,replayPlayer.meta.startTime or 0,replayPlayer.meta.duration)end end,
 skip=function(delta)if replayPlayer then replayTime=math.clamp(replayTime+delta,replayPlayer.meta.startTime or 0,replayPlayer.meta.duration)end end,
 pause=function()replayPaused=not replayPaused;ui.pauseButton.Text=replayPaused and 'PLAY'or 'PAUSE'end,
 rate=function(rate)replayRate=rate end,
 exitReplay=function()exitToMenu();task.delay(.2,function()ui.callbacks.library()end)end,
})
presence=Presence.new(ui.gui)
openExpansion=function()
 if presence.active then return end
 presence:open();mode='menu';closing=false;ui.canvas.Visible=true;ui.launcher.Visible=false;ui.closeButton.Visible=true
 ui:show('menu');menuCamera();refreshLobby()
end
closeExpansion=function()
 clearScene();if menuPark then menuPark:Destroy();menuPark=nil end
 mode='closed';run=nil;closing=false;countdownUntil=nil;held={};gamepad={steer=0,throttle=0,brake=0}
 ui.canvas.Visible=false;ui.touch.Visible=false;ui.closeButton.Visible=false;ui.launcher.Visible=true
 presence:close()
end
local keyMap={W='throttle',S='brake',A='left',D='right',Space='handbrake',Down='reverse',Up='throttle',Left='left',Right='right'}
UIS.InputBegan:Connect(function(input,processed)
 if mode=='closed'or processed or UIS:GetFocusedTextBox()then return end
 local name=input.KeyCode.Name
 if keyMap[name]then held[keyMap[name]]=true end
 if name=='R'then ui.callbacks.recover()
 elseif name=='B'then ui.callbacks.bookmark()
 elseif name=='C'then ui.callbacks.camera()
 elseif name=='J'then ui.callbacks.call('left')
 elseif name=='K'then ui.callbacks.call('right')
 elseif name=='L'then ui.callbacks.call('caution')
 elseif mode=='replay'and name=='P'then ui.callbacks.pause()
 elseif mode=='replay'and name=='Comma'then ui.callbacks.skip(-5)
 elseif mode=='replay'and name=='Period'then ui.callbacks.skip(5)end
end)
UIS.InputEnded:Connect(function(input)
 local name=input.KeyCode.Name;if keyMap[name]then held[keyMap[name]]=false end
end)
UIS.InputChanged:Connect(function(input)
 if mode=='closed'then return end
 if input.KeyCode==Enum.KeyCode.Thumbstick1 then gamepad.steer=input.Position.X
 elseif input.KeyCode==Enum.KeyCode.ButtonR2 then gamepad.throttle=input.Position.Z
 elseif input.KeyCode==Enum.KeyCode.ButtonL2 then gamepad.brake=input.Position.Z
 elseif input.UserInputType==Enum.UserInputType.MouseWheel then orbitDistance=math.clamp(orbitDistance-input.Position.Z*2,8,55)end
end)
UIS.WindowFocusReleased:Connect(function()held={};gamepad={steer=0,throttle=0,brake=0}end)
remotes.Action.OnClientEvent:Connect(function(kind,data)
 if kind=='start'then
  if not presence.active then openExpansion()end
  mode='drive';setup(data,D.copy(data.s));clockAt=os.clock();clockValue=data.clock;ui:show('drive');notice('Building the road ahead…',10);loadGhost(data.ghost)
 elseif kind=='countdown'then countdownUntil=os.clock()+3;notice('3 · get ready',3)
 elseif kind=='go'then countdownUntil=nil;if run then run.status='running'end;notice('GO · make it a good one',1.5)
 elseif kind=='notice'then notice(data)
 elseif kind=='checkpoint'then notice('CHECKPOINT / '..UI.time(data.time),1.6)
 elseif kind=='result'then
  if closing then closeExpansion()else clearScene();mode='result';run=nil;menuCamera();ui:resultScreen(data)end
 elseif kind=='saved'then ui:saved(data)
 elseif kind=='lobby'then if closing then closeExpansion()else exitToMenu()end end
end)
remotes.State.OnClientEvent:Connect(function(packet)
 if mode~='drive'or not run then return end
 for _,data in ipairs(packet.runs or {})do if data.owner==run.owner then
  local oldOrigin=run.originZ or 0;local oldPenalty=run.penalty;run=data
  if data.originZ~=oldOrigin then
   local delta=Vector3.new(0,0,data.originZ-oldOrigin);stream:shift(data.originZ)
   workspace.CurrentCamera.CFrame=workspace.CurrentCamera.CFrame+delta
   if freeFrame then freeFrame+=delta end
  end
  local target=D.copy(data.s)
  local lag=math.clamp(workspace:GetServerTimeNow()-packet.time,0,.25)
  if data.status=='running'and data.owner==player.UserId then
   local input=controls();local left=lag
   while left&gt;0 do local dt=math.min(C.Step,left);D.step(target,input,route,getCar(data.car),dt);left-=dt end
  end
  local error=predicted and math.sqrt((predicted.x-target.x)^2+(predicted.z-target.z)^2)or 100
  if not predicted or error&gt;18 or oldPenalty~=data.penalty then predicted=target;correction=nil else correction=target end
  clockValue=data.clock;clockAt=os.clock()
  break
 end end
end)
local function updateCamera(cf,dt)
 local camera=workspace.CurrentCamera
 if cameraMode==4 then
  freeFrame=freeFrame or camera.CFrame
  local direction=Vector3.new((held.right and 1 or 0)-(held.left and 1 or 0),0,(held.brake and 1 or 0)-(held.throttle and 1 or 0))
  if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)then
   local delta=UIS:GetMouseDelta();freeFrame=CFrame.new(freeFrame.Position)*CFrame.Angles(0,-delta.X*.004,0)*freeFrame.Rotation*CFrame.Angles(-delta.Y*.004,0,0)
  end
  freeFrame=freeFrame*CFrame.new(direction*dt*55);camera.CFrame=freeFrame;presence:view(camera.CFrame);return
 end
 if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)then
  local delta=UIS:GetMouseDelta();orbitAngle-=delta.X*.006;orbitPitch=math.clamp(orbitPitch+delta.Y*.004,-.05,1.1)
 end
 local target
 if cameraMode==2 then
  local pos=cf.Position+cf.LookVector*3.8+Vector3.new(0,2.1,0);target=CFrame.lookAt(pos,pos+cf.LookVector*40)
 elseif cameraMode==3 then
  local offset=Vector3.new(math.sin(orbitAngle)*orbitDistance,math.sin(orbitPitch)*orbitDistance+3,math.cos(orbitAngle)*orbitDistance)
  target=CFrame.lookAt(cf.Position+offset,cf.Position+Vector3.new(0,.7,0))
 else
  local pos=cf.Position-cf.LookVector*(15+math.abs(predicted.v)*.025)+Vector3.new(0,6.3,0)
  target=CFrame.lookAt(pos,cf.Position+cf.LookVector*9+Vector3.new(0,1.6,0))
 end
 camera.CFrame=lastFrame and camera.CFrame:Lerp(target,1-math.exp(-9*dt))or target
 presence:view(camera.CFrame)
 lastFrame=cf
end
local uiAt=0;local slowTime=0
RunService.RenderStepped:Connect(function(dt)
 if mode=='closed'then return end
 ui:resize()
 if countdownUntil and os.clock()&lt;countdownUntil then ui.message.Text=tostring(math.ceil(countdownUntil-os.clock()))..' · GET READY'end
 if noticeUntil&gt;0 and os.clock()&gt;noticeUntil then ui.message.Text='';noticeUntil=0 end
 if mode~='drive'and mode~='replay'then return end
 if not stream or not predicted then return end
 local input=controls();local speed=getCar(run.car)
 if mode=='drive'then
  sent+=dt
  if sent&gt;=1/C.InputRate then sent=0;seq+=1;input.seq=seq;remotes.Input:FireServer(input)end
  accumulator=math.min(accumulator+dt,.1)
  while accumulator&gt;=C.Step do
   accumulator-=C.Step
   if run.status=='running'then
    local driving=run.owner==player.UserId and input or {throttle=predicted.throttle or 0,brake=predicted.brake or 0,steer=predicted.steer or 0,handbrake=predicted.handbrake}
    D.step(predicted,driving,route,speed,C.Step)end
   if correction then
    -- Advance the correction too, so interpolation does not pull toward an old pose.
    if run.status=='running'then
     local driving=run.owner==player.UserId and input or {throttle=correction.throttle or 0,brake=correction.brake or 0,steer=correction.steer or 0,handbrake=correction.handbrake}
     D.step(correction,driving,route,speed,C.Step)end
    local blend=1-math.exp(-7*C.Step)
    for _,k in ipairs({'x','z','v','lateralV'})do predicted[k]+=(correction[k]-predicted[k])*blend end
    local delta=(correction.yaw-predicted.yaw+math.pi)%(math.pi*2)-math.pi;predicted.yaw+=delta*blend
    predicted.damage=correction.damage;predicted.crashes=correction.crashes
   end
  end
 else
  local state,error=replayPlayer:sample(replayTime)
  if state then
   predicted=state
   if not replayPaused and stream:ready(predicted.z)then replayTime=math.min(replayPlayer.meta.duration,replayTime+dt*replayRate)end
   if replayTime&gt;=replayPlayer.meta.duration then replayPaused=true;ui.pauseButton.Text='PLAY'end
  else notice(error,.5)end
  local newOrigin=-math.floor(predicted.z/4096)*4096
  if newOrigin~=(run.originZ or 0)then
   local delta=Vector3.new(0,0,newOrigin-(run.originZ or 0));stream:shift(newOrigin);run.originZ=newOrigin;workspace.CurrentCamera.CFrame+=delta
  end
 end
 roadAt+=dt
 if roadAt&gt;.10 then roadAt=0;stream:update(predicted.z)end
 stream:work(.0025)
 if mode=='drive'and not readySent and run.owner==player.UserId and stream:ready(predicted.z)then readySent=true;remotes.Action:FireServer('ready')end
 local cf=Assets.pose(visual,predicted,route,stream:offset(),dt*(mode=='replay'and (replayPaused and 0 or replayRate)or 1))
 updateCamera(cf,dt)
 local clock=mode=='replay'and replayTime or(clockValue+(run.status=='running'and math.min(.3,os.clock()-clockAt)or 0)+(run.penalty or 0))
 if ghostPlayer and ghostVisual then
  local ghost=ghostPlayer:sample(clock)
  if ghost then
   Assets.pose(ghostVisual,ghost,route,stream:offset(),dt)
   ui.ghost.Text=string.format('SAVED GHOST · %+0.1f m along the road',(predicted.z-ghost.z)*C.StudMetres)
  else ui.ghost.Text='Loading saved ghost…'end
 else ui.ghost.Text=mode=='replay'and 'SAVED REPLAY · P pause / , . seek / RMB orbit'or 'Every finished run saves a replay. Beat your time to update its ghost.'end
 uiAt+=dt
 if uiAt&gt;.1 then
  uiAt=0;ui:runInfo(run,predicted,route,clock)
  if mode=='replay'then
   ui.playhead.Size=UDim2.fromScale(math.clamp(replayTime/math.max(1,replayPlayer.meta.duration),0,1),1)
   ui.replayLabel.Text=UI.time(replayTime)..' / '..UI.time(replayPlayer.meta.duration)..'   '..cameraNames[cameraMode]..' CAMERA   ·   '..(replayPlayer.meta.storage or '')
  end
 end
 slowTime=dt&gt;.027 and slowTime+dt or math.max(0,slowTime-dt*.35)
 if slowTime&gt;6 and ui.quality~='low'then
  ui.quality=ui.quality=='high'and 'medium'or 'low';stream.quality=ui.quality;ui.qualityButton.Text='QUALITY: '..ui.quality:upper()..' · AUTO';slowTime=0
 end
end)
-- The downloaded place enters the runnable modes instead of the incomplete old garage.
-- A Studio installation into another game can keep the opt-in launcher.
task.defer(function()
 if C.AutoOpen and root:GetAttribute('AutoOpen')~=false then openExpansion()end
end)
</ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000021">
          <Properties>
            <string name="Name">Presence</string>
            <ProtectedString name="Source">-- Local, reversible ownership of the view while the optional expansion is open.
local Players=game:GetService('Players')
local Lighting=game:GetService('Lighting')
local RunService=game:GetService('RunService')
local Context=game:GetService('ContextActionService')
local Presence={};Presence.__index=Presence
local daylight={ClockTime=15.8,Brightness=2.2,Ambient=Color3.fromRGB(114,122,114),
 OutdoorAmbient=Color3.fromRGB(148,155,144),FogStart=800,FogEnd=6000,FogColor=Color3.fromRGB(195,213,219)}
local atmosphere={Density=.18,Haze=.5,Glare=.1,Offset=0,Color=Color3.fromRGB(205,219,229),Decay=Color3.fromRGB(139,153,157)}
function Presence.new(gui)
 return setmetatable({gui=gui,active=false,screens={},connections={},environment={}},Presence)
end
function Presence:environmentProfile(object,profile)
 if self.environment[object]then return end
 local entry={before={},after=profile};self.environment[object]=entry
 for property in pairs(profile)do entry.before[property]=object[property]end
 for property,value in pairs(profile)do object[property]=value end
end
function Presence:effect(effect)
 if effect:IsA('Atmosphere')then self:environmentProfile(effect,atmosphere)
 elseif effect:IsA('PostEffect')then self:environmentProfile(effect,{Enabled=false})end
end
function Presence:time(clock)
 if self.environment[Lighting]then self.environment[Lighting].after.ClockTime=clock;Lighting.ClockTime=clock end
end
function Presence:hide(screen)
 if screen==self.gui or not screen:IsA('ScreenGui')or self.screens[screen]then return end
 self.screens[screen]={enabled=screen.Enabled}
 screen.Enabled=false
 self.connections[#self.connections+1]=screen:GetPropertyChangedSignal('Enabled'):Connect(function()
  if self.active and screen.Enabled then screen.Enabled=false end
 end)
end
function Presence:open()
 if self.active then return end
 self.active=true
 local camera=workspace.CurrentCamera
 self.camera={object=camera,cf=camera.CFrame,kind=camera.CameraType,subject=camera.CameraSubject,fov=camera.FieldOfView}
 self.clock=Lighting.ClockTime
 self:environmentProfile(Lighting,table.clone(daylight))
 for _,effect in ipairs(Lighting:GetChildren())do self:effect(effect)end
 self.connections[#self.connections+1]=Lighting.ChildAdded:Connect(function(effect)self:effect(effect)end)
 local pg=Players.LocalPlayer:WaitForChild('PlayerGui')
 for _,screen in ipairs(pg:GetChildren())do self:hide(screen)end
 self.connections[#self.connections+1]=pg.ChildAdded:Connect(function(screen)self:hide(screen)end)
 Context:BindActionAtPriority('ExpeditionControls',function()return Enum.ContextActionResult.Sink end,false,4000,
  Enum.PlayerActions.CharacterForward,Enum.PlayerActions.CharacterBackward,Enum.PlayerActions.CharacterLeft,
  Enum.PlayerActions.CharacterRight,Enum.PlayerActions.CharacterJump)
 RunService:BindToRenderStep('ExpeditionCamera',Enum.RenderPriority.Last.Value,function()
  if self.active then for object,entry in pairs(self.environment)do
   if object==Lighting or object.Parent then for property,value in pairs(entry.after)do
    if object[property]~=value then object[property]=value end
   end end
  end end
  if self.active and self.desired then
   local current=workspace.CurrentCamera;current.CameraType=Enum.CameraType.Scriptable
   current.CFrame=self.desired;current.FieldOfView=self.fov or 72
  end
 end)
end
function Presence:view(cf,fov)
 self.desired=cf;self.fov=fov or 72
end
function Presence:close()
 if not self.active then return end
 self.active=false
 RunService:UnbindFromRenderStep('ExpeditionCamera');Context:UnbindAction('ExpeditionControls')
 for _,connection in ipairs(self.connections)do connection:Disconnect()end
 self.connections={}
 for screen,data in pairs(self.screens)do if screen.Parent then screen.Enabled=data.enabled end end
 self.screens={}
 local old=self.camera;local camera=workspace.CurrentCamera
 if old and camera==old.object then
  camera.CameraType=old.kind;camera.CameraSubject=old.subject;camera.CFrame=old.cf;camera.FieldOfView=old.fov
 end
 Lighting.ClockTime=self.clock
 for object,entry in pairs(self.environment)do if object==Lighting or object.Parent then
  for property,value in pairs(entry.before)do object[property]=value end
 end end
 self.environment={}
 self.desired=nil;self.camera=nil
end
return Presence
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000022">
          <Properties>
            <string name="Name">ReplayPlayer</string>
            <ProtectedString name="Source">local root=game:GetService('ReplicatedStorage'):WaitForChild('BackseatExpedition')
local Codec=require(root.Shared.Replay)
local Player={};Player.__index=Player
function Player.new(remote,metadata)
 return setmetatable({remote=remote,meta=metadata,cache={},pending={},queue={},alive=true,errors={}},Player)
end
function Player:page(index)
 if not self.meta.pages[index]or self.cache[index]or self.pending[index]then return end
 self.pending[index]=true;self.queue[#self.queue+1]=index
 if self.worker then return end;self.worker=true
 task.spawn(function()
  while self.alive and #self.queue&gt;0 do
   local i=table.remove(self.queue,1);local result
   for attempt=1,3 do
    local ok,response=pcall(function()return self.remote:InvokeServer('page',{id=self.meta.id,index=i})end)
    if ok and response and response.text then
     local decoded,frames=pcall(Codec.decode,response.text)
     if decoded then result=frames;break else self.errors[i]='Invalid replay data'end
    else self.errors[i]=ok and response and response.error or 'Connection interrupted'end
    task.wait(.5*attempt)
   end
   if not self.alive then break end
   self.cache[i]=result;self.pending[i]=nil
   if result then self.errors[i]=nil end
   -- A five-page moving cache bounds both ghost and replay memory.
   for j in pairs(self.cache)do if math.abs(j-(self.current or i))&gt;2 then self.cache[j]=nil end end
   task.wait(.18)
  end
  self.worker=false
 end)
end
function Player:sample(t)
 local pages=self.meta.pages;local index=1
 for i,p in ipairs(pages)do if p.from&lt;=t then index=i else break end end
 self.current=index;self:page(index);self:page(index+1)
 local frames=self.cache[index]
 if not frames then return nil,self.errors[index]or 'Loading replay…'end
 if frames[#frames][1]&lt;t*1000 and self.cache[index+1]then
  local joined=table.clone(frames);joined[#joined+1]=self.cache[index+1][1];return Codec.sample(joined,t)
 end
 return Codec.sample(frames,t)
end
function Player:destroy()self.alive=false;self.queue={};self.cache={}end
return Player
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000023">
          <Properties>
            <string name="Name">RoadStream</string>
            <ProtectedString name="Source">-- Bounded chunk window; generation jobs yield frequently and recycle parts.
local Root=game:GetService('ReplicatedStorage'):WaitForChild('BackseatExpedition')
local C=require(Root.Shared.Config);local Route=require(Root.Shared.Route)
local Loader=require(Root.Shared.AssetLoader)
local Stream={};Stream.__index=Stream
local function rgb(a)return Color3.new(a[1],a[2],a[3])end
function Stream.new(parent)
 local folder=Instance.new('Folder');folder.Name='RallyWorld';folder.Parent=parent
 return setmetatable({folder=folder,chunks={},queue={},pool={},quality='medium',made=0,epoch=0},Stream)
end
function Stream:part(parent,name,size,cf,tint,material,shape)
 local p=table.remove(self.pool)or Instance.new('Part')
 p.Name=name;p.Size=size;p.CFrame=cf;p.Color=rgb(tint);p.Material=material or Enum.Material.SmoothPlastic
 p.Shape=shape or Enum.PartType.Block;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false
 p.CastShadow=false;p.Transparency=0;p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=parent
 self.made+=1;if self.made%8==0 then coroutine.yield()end
 return p
end
function Stream:release(chunk)
 for _,p in ipairs(chunk:GetChildren())do
  if p:IsA('BasePart')and #self.pool&lt;400 then p.Parent=nil;self.pool[#self.pool+1]=p else p:Destroy()end
 end
 chunk:Destroy()
end
function Stream:reset(route,slot,originZ)
 self.epoch+=1;self.route=route;self.slot=slot or 1;self.originZ=originZ or 0
 for _,entry in pairs(self.chunks)do self:release(entry.model)end
 self.chunks={};self.queue={}
end
function Stream:shift(originZ)
 if originZ==self.originZ then return end
 local delta=Vector3.new(0,0,originZ-self.originZ)
 for _,entry in pairs(self.chunks)do
  -- Jobs resume with the new origin, so unfinished chunks are rebuilt.
  if entry.done then entry.model:PivotTo(entry.model:GetPivot()+delta)else entry.cancel=true end
 end
 self.originZ=originZ
end
function Stream:offset()return Vector3.new(C.WorldX+(self.slot or 1)*C.LaneSpacing,0,self.originZ or 0)end
function Stream:decor(model,index)
 local route=self.route;local cfg=C.Quality[self.quality];local offset=self:offset()
 local imported=Root:FindFirstChild('ImportedProps')
 local templates=imported and imported:GetChildren()or {}
 local z0=index*C.Chunk;local biome=C.Biomes[route:point(z0).biome]
 for i=1,cfg.props do
  local r=Route.random(route.seed,index*71+i*7);local z=z0+r*C.Chunk
  local p=route:point(z);local side=i%2==0 and 1 or -1;local x=p.x+side*(p.width/2+20+Route.random(route.seed,i+index*33)*65)
  local at=Vector3.new(x,p.y-2,z)+offset
  local height=8+Route.random(route.seed,i*71+index)*10
  local template=biome.trees and #templates&gt;0 and self.quality~='low'and templates[(i-1)%#templates+1]
  if template and Loader.ready(template)then
   local prop=template:Clone();prop.Parent=model;prop:PivotTo(CFrame.new(at)*CFrame.Angles(0,r*6,0))
   coroutine.yield()
  elseif biome.trees and i%3~=0 then
   self:part(model,'Pine trunk',Vector3.new(1,height*.6,1),CFrame.new(at+Vector3.new(0,height*.3,0)),{.25,.20,.14},Enum.Material.Wood)
   local layers=self.quality=='low'and 1 or 2
   for level=1,layers do
    local size=(height*.65)*(1-(level-1)*.28)
    self:part(model,'Pine canopy',Vector3.new(size,height*.48,size),CFrame.new(at+Vector3.new(0,height*(.50+level*.16),0)),{.14,.27+level*.015,.19},Enum.Material.Grass,Enum.PartType.Ball)
   end
  elseif biome.desert and i%2==0 then
   self:part(model,'Cactus',Vector3.new(1.3,height*.65,1.3),CFrame.new(at+Vector3.new(0,height*.325,0)),{.28,.42,.27})
   self:part(model,'Cactus arm',Vector3.new(4,1,1),CFrame.new(at+Vector3.new(1,height*.4,0)),{.28,.42,.27})
  else
   self:part(model,'Boulder',Vector3.new(height*.7,height*.4,height*.55),CFrame.new(at+Vector3.new(0,height*.17,0))*CFrame.Angles(.12,r*4,.18),biome.snow and {.71,.74,.72}or{.39,.38,.33},Enum.Material.Slate,Enum.PartType.Ball)
  end
 end
 -- Distant low-poly landforms give each biome a readable skyline.
 local p=route:point(z0+C.Chunk/2)
 for _,side in ipairs({-1,1})do
  local h=biome.desert and 90 or 140
  self:part(model,'Distant ridge',Vector3.new(240,h,320),CFrame.new(p.x+side*420,p.y+h*.25-20,z0+128)*CFrame.new(offset),biome.ground,Enum.Material.Rock,Enum.PartType.Ball)
 end
end
function Stream:build(index,entry)
 local route=self.route;local model=entry.model;local offset=self:offset();local start=index*C.Chunk
 for z=start,start+C.Chunk-C.RoadStep,C.RoadStep do
  if entry.cancel or entry.epoch~=self.epoch then return end
  local a,b=route:point(z),route:point(z+C.RoadStep);local p=route:point(z+C.RoadStep/2)
  local pos=Vector3.new((a.x+b.x)/2,(a.y+b.y)/2,z+C.RoadStep/2)+offset
  local dir=Vector3.new(b.x-a.x,b.y-a.y,C.RoadStep)
  -- Match the analytic heightfield, including grade across a curved, banked road.
  local slope=math.tan(p.bank)/math.sqrt(1+p.dx*p.dx)
  local normal=Vector3.new(-slope,1,p.dx*slope-p.dy).Unit
  local frame=CFrame.lookAt(pos,pos+dir,normal)
  frame=frame-frame.UpVector*.35
  local length=dir.Magnitude+2.4;local biome=C.Biomes[p.biome]
  self:part(model,'Road',Vector3.new(p.width,.7,length),frame,biome.road,p.surface=='tarmac'and Enum.Material.Asphalt or Enum.Material.Ground)
  for _,side in ipairs({-1,1})do
   self:part(model,'Shoulder',Vector3.new(3,.5,length),frame*CFrame.new(side*(p.width/2+1.5),-.18,0),biome.ground,Enum.Material.Ground)
   if p.bridge or p.tunnel then
    self:part(model,'Safety rail',Vector3.new(.5,2.8,length),frame*CFrame.new(side*(p.width/2+.6),1.5,0),{.57,.59,.55},Enum.Material.Metal)
   end
  end
  if p.bridge and z==start then
   local water=self:part(model,'River',Vector3.new(320,.3,C.Chunk+8),CFrame.new(p.x,-12,start+C.Chunk/2)+offset,{.16,.36,.39},Enum.Material.Glass);water.Transparency=.2
  end
  if p.bridge and z%64==0 then
   for _,side in ipairs({-1,1})do self:part(model,'Bridge pier',Vector3.new(2,28,3),frame*CFrame.new(side*11,-14,0),{.36,.37,.34},Enum.Material.Concrete)end
  end
  if not p.bridge then self:part(model,'Land',Vector3.new(190,5,length+2),frame*CFrame.new(0,-4,0),biome.ground,Enum.Material.Grass)end
  if z%32==0 and p.surface=='tarmac'then self:part(model,'Centre dash',Vector3.new(.25,.04,8),frame*CFrame.new(0,.38,0),{.88,.85,.68})end
  if p.tunnel and z%32==0 then
   self:part(model,'Tunnel roof',Vector3.new(p.width+4,2,35),frame*CFrame.new(0,13,0),{.30,.32,.32},Enum.Material.Concrete)
   for _,side in ipairs({-1,1})do self:part(model,'Tunnel wall',Vector3.new(1,12,35),frame*CFrame.new(side*(p.width/2+1.5),6,0),{.31,.33,.32},Enum.Material.Concrete)end
   self:part(model,'Tunnel strip',Vector3.new(.3,.15,14),frame*CFrame.new(0,11.8,0),{.9,.77,.48},Enum.Material.Neon)
  end
  if z&gt;=0 and (z%C.Checkpoint==0 or z==route.length and route.length&gt;0)then
   for _,side in ipairs({-1,1})do self:part(model,'Timing post',Vector3.new(.4,7,.4),frame*CFrame.new(side*(p.width/2+2),3.5,0),{.95,.72,.29})end
   self:part(model,'Timing banner',Vector3.new(p.width+5,1.5,.3),frame*CFrame.new(0,7,0),{.14,.27,.23})
  end
 end
 self:decor(model,index);entry.done=true
end
function Stream:update(z)
 if not self.route then return end
 local cfg=C.Quality[self.quality];local centre=math.floor(math.max(0,z)/C.Chunk);local wanted={}
 for i=math.max(-1,centre-cfg.behind),centre+cfg.ahead do wanted[i]=true end
 for i,entry in pairs(self.chunks)do
  if not wanted[i]or entry.cancel then entry.cancel=true;self:release(entry.model);self.chunks[i]=nil end
 end
 -- Prioritize the piece beneath the car and its immediate approach.
 local order={centre,centre+1,centre-1}
 for i=centre+2,centre+cfg.ahead do order[#order+1]=i end
 for i=centre-2,math.max(-1,centre-cfg.behind),-1 do order[#order+1]=i end
 for _,i in ipairs(order)do if wanted[i]and not self.chunks[i]then
  local model=Instance.new('Model');model.Name='Road_'..i;model.Parent=self.folder
  local entry={model=model,epoch=self.epoch};self.chunks[i]=entry
  entry.job=coroutine.create(function()self:build(i,entry)end);self.queue[#self.queue+1]=entry
 end end
end
function Stream:work(budget)
 local began=os.clock()
 while #self.queue&gt;0 and os.clock()-began&lt;budget do
  local entry=self.queue[1]
  if entry.cancel or entry.epoch~=self.epoch or coroutine.status(entry.job)=='dead'then table.remove(self.queue,1)
  else local ok,err=coroutine.resume(entry.job);if not ok then entry.cancel=true;warn('Road generation failed: '..tostring(err));table.remove(self.queue,1)end end
 end
end
function Stream:ready(z)
 local index=math.floor(math.max(0,z)/C.Chunk)
 return self.chunks[index]and self.chunks[index].done and self.chunks[index+1]and self.chunks[index+1].done
end
function Stream:destroy()
 self.epoch+=1;for _,entry in pairs(self.chunks)do entry.cancel=true;self:release(entry.model)end
 for _,p in ipairs(self.pool)do p:Destroy()end;self.chunks={};self.pool={};self.folder:Destroy()
end
return Stream
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000024">
          <Properties>
            <string name="Name">UI</string>
            <ProtectedString name="Source">local UI={};UI.__index=UI
local Players=game:GetService('Players');local UIS=game:GetService('UserInputService')
local C=require(game:GetService('ReplicatedStorage').BackseatExpedition.Shared.Config)
local Assets=require(game:GetService('ReplicatedStorage').BackseatExpedition.Shared.Assets)
local palette={ink=Color3.fromRGB(20,35,32),panel=Color3.fromRGB(29,48,42),card=Color3.fromRGB(41,62,52),
 light=Color3.fromRGB(242,232,207),muted=Color3.fromRGB(169,184,163),gold=Color3.fromRGB(233,180,84),red=Color3.fromRGB(224,119,91)}
local function frame(parent,name,x,y,w,h,bg)
 local f=Instance.new('Frame');f.Name=name;f.Position=UDim2.fromOffset(x,y);f.Size=UDim2.fromOffset(w,h);f.BackgroundColor3=bg or palette.panel;f.BorderSizePixel=0;f.Parent=parent;return f
end
local function label(parent,text,x,y,w,h,size,tint)
 local t=Instance.new('TextLabel');t.Position=UDim2.fromOffset(x,y);t.Size=UDim2.fromOffset(w,h);t.BackgroundTransparency=1
 t.Text=text;t.TextColor3=tint or palette.light;t.Font=Enum.Font.Gotham;t.TextSize=size or 16;t.TextXAlignment=Enum.TextXAlignment.Left;t.TextWrapped=true;t.Parent=parent;return t
end
local function button(parent,text,x,y,w,h,callback,accent)
 local b=Instance.new('TextButton');b.Position=UDim2.fromOffset(x,y);b.Size=UDim2.fromOffset(w,h);b.BackgroundColor3=accent and palette.gold or palette.card
 b.TextColor3=accent and palette.ink or palette.light;b.Text=text;b.Font=Enum.Font.GothamBold;b.TextSize=15;b.BorderSizePixel=0;b.AutoButtonColor=true;b.Parent=parent
 local corner=Instance.new('UICorner');corner.CornerRadius=UDim.new(0,6);corner.Parent=b
 if callback then b.Activated:Connect(callback)end;return b
end
function UI.time(seconds)
 seconds=math.max(0,seconds or 0);return string.format('%02d:%05.2f',math.floor(seconds/60),seconds%60)
end
function UI.new(callbacks)
 local gui=Instance.new('ScreenGui');gui.Name='ExpeditionUI';gui.ResetOnSpawn=false;gui.IgnoreGuiInset=true;gui.DisplayOrder=10000;gui.Parent=Players.LocalPlayer:WaitForChild('PlayerGui')
 local self=setmetatable({gui=gui,callbacks=callbacks,mode=C.Modes[1],car=C.Cars[1],quality='medium',xp=0,speedIndex=3},UI)
 self.launcher=button(gui,'EXPEDITION',0,0,160,40,function()callbacks.open()end,true)
 self.launcher.Position=UDim2.new(1,-180,0,72)
 self.closeButton=button(gui,'RETURN TO ORIGINAL',0,0,180,36,function()callbacks.close()end)
 self.closeButton.Position=UDim2.new(1,-200,0,24);self.closeButton.Visible=false
 local canvas=frame(gui,'ResponsiveCanvas',0,0,1180,680,palette.ink);canvas.AnchorPoint=Vector2.new(.5,.5);canvas.Position=UDim2.fromScale(.5,.5);canvas.BackgroundTransparency=1
 local scale=Instance.new('UIScale');scale.Parent=canvas
 self.scale=scale;self.canvas=canvas
 local menu=frame(canvas,'GarageMenu',0,0,1180,680,palette.ink);self.menu=menu
 local grad=Instance.new('UIGradient');grad.Color=ColorSequence.new(palette.ink,palette.panel);grad.Rotation=28;grad.Parent=menu
 label(menu,'BACKSEAT / EXPEDITION',34,25,760,30,19,palette.gold).Font=Enum.Font.GothamBold
 label(menu,'Find the long\nway home.',32,79,660,125,53).Font=Enum.Font.GothamBold
 local preview=Instance.new('ViewportFrame');preview.Name='CarPreview';preview.Position=UDim2.fromOffset(420,78)
 preview.Size=UDim2.fromOffset(260,130);preview.BackgroundTransparency=1
 preview.Ambient=Color3.fromRGB(185,185,185);preview.LightColor=Color3.fromRGB(255,244,218)
 preview.LightDirection=Vector3.new(-1,-1,-1);preview.Parent=menu
 local previewCamera=Instance.new('Camera');previewCamera.FieldOfView=34
 previewCamera.CFrame=CFrame.lookAt(Vector3.new(15,9,-19),Vector3.new(0,.5,0));previewCamera.Parent=preview
 preview.CurrentCamera=previewCamera
 self.previewWorld=Instance.new('WorldModel');self.previewWorld.Parent=preview
 label(menu,'A fresh road. A proper finish. Your best run, waiting as a ghost.',36,211,640,40,17,palette.muted)
 self.modeButtons={}
 for i,mode in ipairs(C.Modes)do
  local x,y=36+((i-1)%2)*318,274+math.floor((i-1)/2)*88
  local b=button(menu,mode.name,x,y,300,76,function()self.mode=mode;self:selection()end)
  b.Text='';label(b,mode.name,14,7,270,24,18).Font=Enum.Font.GothamBold
  label(b,mode.tag,14,35,268,32,12,palette.muted);self.modeButtons[i]=b
 end
 label(menu,'YOUR GARAGE',36,463,600,22,12,palette.gold)
 self.carButtons={}
 for i,car in ipairs(C.Cars)do
  local b=button(menu,car.name,36+(i-1)*210,494,196,48,function()self.car=car;self:selection()end);self.carButtons[i]=b
 end
 self.carDescription=label(menu,'',36,549,625,28,13,palette.muted)
 local seed=Instance.new('TextBox');seed.Name='CourseSeed';seed.Position=UDim2.fromOffset(36,600);seed.Size=UDim2.fromOffset(155,42)
 seed.Text='';seed.PlaceholderText='Seed · random';seed.ClearTextOnFocus=false;seed.TextColor3=palette.light;seed.PlaceholderColor3=palette.muted;seed.BackgroundColor3=palette.card;seed.TextSize=14;seed.Font=Enum.Font.Gotham;seed.Parent=menu;self.seed=seed
 button(menu,'TAKE THE ROAD →',205,600,269,42,function()callbacks.start(self.mode.id,self.car.id,tonumber(seed.Text))end,true)
 button(menu,'REPLAY LIBRARY',489,600,165,42,function()callbacks.library()end)
 local side=frame(menu,'Roadbook',708,75,438,566,palette.card)
 label(side,'ROADBOOK / NEXT DEPARTURE',24,21,390,25,12,palette.gold)
 self.modeTitle=label(side,'',24,56,390,42,29);self.modeTitle.Font=Enum.Font.GothamBold
 self.modeDetail=label(side,'',24,103,385,50,15,palette.muted)
 label(side,'SOLO + CO-DRIVER SEAT',24,184,390,23,12,palette.gold)
 self.drivers=frame(side,'Drivers',24,218,390,145,palette.card)
 button(side,'REFRESH OPEN SEATS',24,374,390,34,function()callbacks.lobby()end)
 self.saveStatus=label(side,'Loading your garage…',24,425,390,48,13,palette.muted)
 button(side,'QUALITY: MEDIUM',24,493,390,34,function()
  local order={'low','medium','high'};self.quality=order[(table.find(order,self.quality)or 2)%3+1]
  self.qualityButton.Text='QUALITY: '..self.quality:upper();callbacks.quality(self.quality)
 end)
 self.qualityButton=side:GetChildren()[#side:GetChildren()]
 -- Keep a direct reference, independent of child enumeration order.
 for _,child in ipairs(side:GetChildren())do if child:IsA('TextButton')and child.Text=='QUALITY: MEDIUM'then self.qualityButton=child end end
 self.hud=frame(canvas,'DrivingHUD',0,0,1180,680,palette.ink);self.hud.BackgroundTransparency=1;self.hud.Visible=false
 local top=frame(self.hud,'Run strip',0,0,1180,66,palette.ink);top.BackgroundTransparency=.08
 self.runSummary=label(top,'',22,9,390,48,14,palette.muted)
 self.note=label(top,'STRAIGHT · opens',400,9,500,48,21,palette.gold);self.note.Font=Enum.Font.GothamBold
 self.timer=label(top,'00:00.00',930,9,230,48,27);self.timer.TextXAlignment=Enum.TextXAlignment.Right
 self.message=label(self.hud,'',170,114,840,80,27,palette.light);self.message.TextXAlignment=Enum.TextXAlignment.Center;self.message.Font=Enum.Font.GothamBold
 self.speed=label(self.hud,'0',935,486,224,100,78);self.speed.Font=Enum.Font.GothamBold;self.speed.TextXAlignment=Enum.TextXAlignment.Right
 label(self.hud,'KM/H',1065,584,95,22,13,palette.gold).TextXAlignment=Enum.TextXAlignment.Right
 self.telemetry=label(self.hud,'',24,535,600,76,14,palette.muted)
 self.ghost=label(self.hud,'',24,490,660,28,15,palette.gold)
 self.endButton=button(self.hud,'RETIRE &amp; SAVE',947,92,210,37,function()callbacks.stop()end)
 button(self.hud,'R · CHECKPOINT',24,623,175,36,function()callbacks.recover()end)
 button(self.hud,'B · MARK MOMENT',211,623,190,36,function()callbacks.bookmark()end)
 button(self.hud,'C · CAMERA',413,623,150,36,function()callbacks.camera()end)
 self.leave=button(self.hud,'LEAVE CO-DRIVER SEAT',947,137,210,36,function()callbacks.leave()end);self.leave.Visible=false
 self.calls={}
 for i,n in ipairs({'left','right','caution'})do
  local b=button(self.hud,n:upper(),24+(i-1)*132,434,122,37,function()callbacks.call(n)end);b.Visible=false;self.calls[i]=b
 end
 local library=frame(canvas,'ReplayLibrary',0,0,1180,680,palette.ink);library.Visible=false;self.libraryPanel=library
 label(library,'THE ROAD, REMEMBERED.',36,34,850,48,34).Font=Enum.Font.GothamBold
 label(library,'Saved runs and fastest ghosts · each run keeps its exact road seed',38,93,1020,32,16,palette.muted)
 button(library,'← GARAGE',953,35,190,42,function()self:show('menu');callbacks.lobby()end)
 local scroll=Instance.new('ScrollingFrame');scroll.Name='SavedRuns';scroll.Position=UDim2.fromOffset(36,147);scroll.Size=UDim2.fromOffset(1110,482)
 scroll.BackgroundTransparency=1;scroll.BorderSizePixel=0;scroll.ScrollBarThickness=4;scroll.CanvasSize=UDim2.fromOffset(0,0);scroll.Parent=library;self.records=scroll
 self.libraryStatus=label(library,'',36,640,1080,27,13,palette.muted)
 self.result=frame(canvas,'RunResult',190,115,800,450,palette.ink);self.result.Visible=false
 label(self.result,'ROADBOOK / RUN COMPLETE',32,28,730,25,13,palette.gold)
 self.resultTitle=label(self.result,'Made it home.',30,82,730,60,43);self.resultTitle.Font=Enum.Font.GothamBold
 self.resultInfo=label(self.result,'',32,164,730,104,21)
 self.resultSaved=label(self.result,'Saving replay and ghost…',32,291,730,48,14,palette.muted)
 self.watchButton=button(self.result,'WATCH REPLAY',32,365,230,44,function()if self.resultMeta and self.resultReady then callbacks.watch(self.resultMeta)end end)
 button(self.result,'SAME ROAD AGAIN',278,365,230,44,function()
  if self.resultMeta and self.resultReady then callbacks.start(self.resultMeta.mode,self.resultMeta.car,self.resultMeta.seed)end
 end,true)
 button(self.result,'GARAGE',524,365,245,44,function()self:show('menu');callbacks.lobby()end)
 local replay=frame(canvas,'ReplayControls',0,563,1180,117,palette.ink);self.replayControls=replay;replay.Visible=false
 self.replayLabel=label(replay,'',20,8,1140,23,13,palette.muted)
 local timeline=button(replay,'',20,42,1140,16,nil);timeline.BackgroundColor3=palette.card;self.timeline=timeline
 self.playhead=frame(timeline,'Playhead',0,0,0,16,palette.gold)
 local drag=false
 local function scrub(x)callbacks.seek(math.clamp((x-timeline.AbsolutePosition.X)/math.max(1,timeline.AbsoluteSize.X),0,1))end
 timeline.InputBegan:Connect(function(event)if event.UserInputType==Enum.UserInputType.MouseButton1 or event.UserInputType==Enum.UserInputType.Touch then drag=true;scrub(event.Position.X)end end)
 UIS.InputChanged:Connect(function(event)if drag and (event.UserInputType==Enum.UserInputType.MouseMovement or event.UserInputType==Enum.UserInputType.Touch)then scrub(event.Position.X)end end)
 UIS.InputEnded:Connect(function(event)if event.UserInputType==Enum.UserInputType.MouseButton1 or event.UserInputType==Enum.UserInputType.Touch then drag=false end end)
 self.pauseButton=button(replay,'PAUSE',20,72,130,34,function()callbacks.pause()end)
 button(replay,'−5 s',163,72,100,34,function()callbacks.skip(-5)end)
 button(replay,'+5 s',276,72,100,34,function()callbacks.skip(5)end)
 self.rateButton=button(replay,'1×',390,72,110,34,function()
  self.speedIndex=self.speedIndex%5+1;local speed=({.25,.5,1,2,4})[self.speedIndex];self.rateButton.Text=speed..'×';callbacks.rate(speed)
 end)
 button(replay,'C · CAMERA',514,72,178,34,function()callbacks.camera()end)
 button(replay,'EXIT REPLAY',950,72,210,34,function()callbacks.exitReplay()end)
 -- Native-size touch controls remain usable independently of menu scaling.
 self.touch=Instance.new('Frame');self.touch.Name='TouchControls';self.touch.Size=UDim2.fromScale(1,1);self.touch.BackgroundTransparency=1;self.touch.Visible=false;self.touch.Parent=gui
 for _,spec in ipairs({{'◀','left',18,-155},{'▶','right',104,-155},{'BRAKE','brake',-190,-155},{'GO','throttle',-104,-155}})do
  local b=button(self.touch,spec[1],0,0,78,72,nil,spec[2]=='throttle')
  b.Position=UDim2.new(spec[3]&lt;0 and 1 or 0,spec[3],1,spec[4]);b.TextSize=18
  b.InputBegan:Connect(function(e)if e.UserInputType==Enum.UserInputType.Touch or e.UserInputType==Enum.UserInputType.MouseButton1 then callbacks.touch(spec[2],true)end end)
  b.InputEnded:Connect(function(e)if e.UserInputType==Enum.UserInputType.Touch or e.UserInputType==Enum.UserInputType.MouseButton1 then callbacks.touch(spec[2],false)end end)
 end
 self:selection();self:resize();canvas.Visible=false;return self
end
function UI:resize()
 local camera=workspace.CurrentCamera;local v=camera and camera.ViewportSize or Vector2.new(1280,720)
 self.scale.Scale=math.min(v.X/1220,v.Y/720)
end
function UI:selection()
 if self.previewWorld and self.previewCarId~=self.car.id then
  if self.previewCar then self.previewCar.model:Destroy()end
  -- Show a complete car immediately, independently of external mesh permissions.
  self.previewCar=Assets.car(self.previewWorld,self.car,false,false)
  self.previewCarId=self.car.id
 end
 for i,b in ipairs(self.modeButtons)do b.BackgroundColor3=C.Modes[i]==self.mode and Color3.fromRGB(61,85,63)or palette.card end
 for i,b in ipairs(self.carButtons)do
  local car=C.Cars[i];b.BackgroundColor3=car==self.car and Color3.fromRGB(61,85,63)or palette.card
  b.Text=car.name..(self.xp&lt;car.unlock and ' · '..car.unlock..' XP'or '')
 end
 self.carDescription.Text=self.car.description
 self.modeTitle.Text=self.mode.name
 self.modeDetail.Text=self.mode.length==0 and 'An endless road. Bank at any point.\nEvery completed run keeps its replay.'or string.format('%.1f km · finishable seeded stage\nCheckpoint recovery adds 5 seconds.',self.mode.length*C.StudMetres/1000)
end
function UI:show(which)
 self.menu.Visible=which=='menu';self.hud.Visible=which=='drive'or which=='replay';self.libraryPanel.Visible=which=='library';self.result.Visible=which=='result'
 self.replayControls.Visible=which=='replay';self.touch.Visible=which=='drive'and UIS.TouchEnabled
 self.mode= self.mode or C.Modes[1]
end
function UI:lobby(data)
 if data.library then self.xp=data.library.xp or 0;self.saveStatus.Text=(data.library.status or '')..'\n'..self.xp..' XP';self:selection()end
 for _,c in ipairs(self.drivers:GetChildren())do c:Destroy()end
 if #(data.drivers or {})==0 then label(self.drivers,'No open seats yet. Start a road and a friend can join you.',0,0,385,100,16,palette.muted)end
 for i,d in ipairs(data.drivers or {})do if i&lt;=3 then button(self.drivers,d.name..' · JOIN',0,(i-1)*47,390,39,function()self.callbacks.join(d.owner)end)end end
end
function UI:library(data)
 self:show('library');self.libraryStatus.Text=data.status or '';self.xp=data.xp or self.xp
 for _,child in ipairs(self.records:GetChildren())do child:Destroy()end
 local list,seen={},{}
 for _,collection in ipairs({data.records or {},data.bests or {}})do for _,r in ipairs(collection)do if not seen[r.id]then seen[r.id]=true;list[#list+1]=r end end end
 table.sort(list,function(a,b)return a.created&gt;b.created end)
 for i,r in ipairs(list)do
  local row=frame(self.records,'Run',0,(i-1)*91,1090,79,palette.card)
  label(row,(r.mode or 'rally'):upper()..' / '..(r.car or 'hatch'):upper(),16,8,510,24,17).Font=Enum.Font.GothamBold
  label(row,'Seed '..r.seed..' · '..UI.time(r.duration)..' · '..(r.storage or 'Session only'),16,39,680,25,13,palette.muted)
  button(row,'WATCH',801,19,120,40,function()self.callbacks.watch(r)end)
  button(row,'RACE ROAD',935,19,140,40,function()self.callbacks.start(r.mode,r.car,r.seed)end,true)
 end
 if #list==0 then label(self.records,'Your first road is waiting. Finish or bank a run to save its replay.',15,60,1020,100,23,palette.muted)end
 self.records.CanvasSize=UDim2.fromOffset(0,#list*91)
end
function UI:resultScreen(meta)
 self:show('result');self.resultMeta=meta;self.resultReady=false
 self.resultTitle.Text=meta.completed and 'Made it home.'or(meta.banked and 'A good place to stop.'or 'Every road teaches you.')
 self.resultInfo.Text=string.format('%s     +%d XP\n%.2f km · %d contacts · %.0f s penalties',UI.time(meta.duration),meta.reward or 0,(meta.progress or 0)*C.StudMetres/1000,meta.crashes or 0,meta.penalty or 0)
 self.resultSaved.Text='Saving replay and ghost…';self.watchButton.Text='SAVING…'
end
function UI:saved(data)
 if self.resultMeta and self.resultMeta.id==data.id then self.resultReady=true;self.resultSaved.Text=data.status;self.watchButton.Text='WATCH REPLAY'end
end
function UI:runInfo(run,s,route,clock)
 self.runSummary.Text=(run.mode or 'replay'):upper()..' / SEED '..run.seed..'\n'..C.Biomes[route:point(s.z).biome].name
 self.note.Text=run.missed and 'MISSED CHECKPOINT · press R'or route:note(s.z+math.abs(s.v))
 self.timer.Text=UI.time(clock);self.speed.Text=tostring(math.floor(math.abs(s.v)*C.StudMetres*3.6+.5))
 local progress=run.length and run.length&gt;0 and string.format('%.2f / %.2f km',math.max(0,s.z)*C.StudMetres/1000,run.length*C.StudMetres/1000)or string.format('%.2f km',math.max(0,s.z)*C.StudMetres/1000)
 self.telemetry.Text=string.format('THROTTLE %3d%%   BRAKE %3d%%   STEER %+3d%%\n%s   ·   BODY %d%%   ·   R recover / B mark / C camera',
  (s.throttle or 0)*100,(s.brake or 0)*100,(s.steer or 0)*100,progress,100-math.floor(s.damage or 0))
 self.endButton.Text=run.mode=='endless'and 'BANK RUN &amp; SAVE'or 'RETIRE &amp; SAVE'
 local passenger=run.passenger==Players.LocalPlayer.UserId;self.leave.Visible=passenger
 for _,b in ipairs(self.calls)do b.Visible=passenger end
 self.endButton.Visible=not passenger and self.replayControls.Visible==false
end
return UI
