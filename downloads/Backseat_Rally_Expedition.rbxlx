        <Item class="ModuleScript" referent="RBX00000010">
          <Properties>
            <string name="Name">AssetLoader</string>
            <ProtectedString name="Source">-- Optional meshes never block driving or replace complete geometry before loading.
local ContentProvider=game:GetService('ContentProvider')
local Loader={};local entries=setmetatable({},{__mode='k'})
local timeout=8
local function inspect(template)
 local visible,external=0,false
 for _,item in ipairs(template:GetDescendants())do
  if item:IsA('BasePart')and item.Transparency&lt;1 then
   visible+=1
   if item:IsA('MeshPart')then
    if item.MeshId==''then return false,false end
    external=true
   end
  elseif item:IsA('SpecialMesh')and item.MeshType==Enum.MeshType.FileMesh then
   if item.MeshId==''then return false,false end
   external=true
  elseif item:IsA('SurfaceAppearance')or item:IsA('Decal')or item:IsA('Texture')then external=true end
 end
 return visible&gt;0,external
end
local function finish(entry,ok)
 if entry.status~='loading'then return end
 entry.status=ok and 'ready'or 'unavailable'
 local callbacks=entry.callbacks;entry.callbacks={}
 for _,callback in ipairs(callbacks)do task.defer(callback,ok)end
end
function Loader.check(template,callback)
 if not template then if callback then task.defer(callback,false)end;return 'unavailable'end
 local entry=entries[template]
 if not entry then
  entry={status='loading',callbacks={}};entries[template]=entry
  local valid,external=inspect(template)
  if not valid then entry.status='unavailable'
  elseif not external then entry.status='ready'
  else
   task.delay(timeout,function()finish(entry,false)end)
   task.spawn(function()
    local failed=false;local observed=false
    local ok=pcall(function()
     ContentProvider:PreloadAsync({template},function(_,status)
      observed=true
      if status~=Enum.AssetFetchStatus.Success then failed=true end
     end)
    end)
    finish(entry,ok and observed and not failed)
   end)
  end
 end
 if callback then
  if entry.status=='loading'then entry.callbacks[#entry.callbacks+1]=callback
  else task.defer(callback,entry.status=='ready')end
 end
 return entry.status
end
function Loader.ready(template)return Loader.check(template)=='ready'end
return Loader
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000011">
          <Properties>
            <string name="Name">Assets</string>
            <ProtectedString name="Source">-- Original lightweight models; optional skins are harvested from the user's place by Installer.
local Assets={}
local Loader=require(script.Parent.AssetLoader)
local function color(t)return Color3.new(t[1],t[2],t[3])end
function Assets.part(parent,name,size,cf,tint,material,shape)
 local p=Instance.new('Part');p.Name=name;p.Size=size;p.CFrame=cf;p.Anchored=true
 p.Color=typeof(tint)=='Color3'and tint or color(tint);p.Material=material or Enum.Material.SmoothPlastic
 p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.CastShadow=false
 p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;if shape then p.Shape=shape end;p.Parent=parent;return p
end
local function box(model,name,size,position,tint,material)
 return Assets.part(model,name,size,CFrame.new(position),tint,material)
end
local dark={.075,.09,.095};local glass={.14,.24,.25};local metal={.50,.55,.54}
function Assets.car(parent,car,ghost,useOriginal,withAudio)
 local model=Instance.new('Model');model.Name=ghost and 'SavedGhost'or car.name
 local body=box(model,'Chassis',Vector3.new(5.7,1.55,9.4),Vector3.zero,car.color);model.PrimaryPart=body
 box(model,'Bonnet',Vector3.new(5.55,.55,2.7),Vector3.new(0,.9,-3),car.color)
 box(model,'Roof',Vector3.new(4.6,.35,4.7),Vector3.new(0,2.2,.4),car.color)
 box(model,'Cabin',Vector3.new(4.5,1.5,4.3),Vector3.new(0,1.4,.4),glass)
 box(model,'Windscreen',Vector3.new(4.5,1.25,.12),Vector3.new(0,1.5,-1.8),glass)
 for _,side in ipairs({-1,1})do
  box(model,'A pillar',Vector3.new(.18,1.65,.22),Vector3.new(side*2.25,1.5,-1.8),car.color)
  box(model,'B pillar',Vector3.new(.18,1.65,.20),Vector3.new(side*2.25,1.5,.3),car.color)
  box(model,'C pillar',Vector3.new(.18,1.65,.22),Vector3.new(side*2.25,1.5,2.4),car.color)
  box(model,'Mirror',Vector3.new(.55,.25,.7),Vector3.new(side*3,1,-1.45),dark)
  box(model,'Sill',Vector3.new(.15,.3,6.2),Vector3.new(side*2.9,-.4,.3),dark)
  box(model,'Headlamp',Vector3.new(1.5,.45,.12),Vector3.new(side*1.65,.4,-4.76),{.99,.91,.64},Enum.Material.Neon)
  box(model,'Tail lamp',Vector3.new(1.1,.32,.12),Vector3.new(side*1.85,.45,4.76),{.72,.13,.1},Enum.Material.Neon)
 end
 box(model,'Front bumper',Vector3.new(5.9,.55,.4),Vector3.new(0,-.3,-4.8),dark)
 box(model,'Rear bumper',Vector3.new(5.9,.55,.4),Vector3.new(0,-.3,4.8),dark)
 box(model,'Grille',Vector3.new(2.3,.5,.15),Vector3.new(0,.3,-4.78),dark)
 box(model,'Rally stripe',Vector3.new(.8,.04,9.1),Vector3.new(.8,.8,0),{.94,.91,.79})
 if car.id=='scout'then
  box(model,'Roof rack',Vector3.new(4.9,.2,4.7),Vector3.new(0,2.5,.4),dark)
  box(model,'Expedition case',Vector3.new(3.5,.55,2.7),Vector3.new(0,2.9,.8),{.45,.37,.24})
 elseif car.id=='coupe'then
  box(model,'Spoiler',Vector3.new(6,.2,.8),Vector3.new(0,1.35,4.1),dark)
 end
 local wheels={}
 for _,front in ipairs({true,false})do for _,sign in ipairs({-1,1})do
  local tyre=Assets.part(model,'Tyre',Vector3.new(.8,2.4,2.4),CFrame.new(sign*3,-1,front and -3.8 or 3.8),dark,Enum.Material.SmoothPlastic,Enum.PartType.Cylinder)
  local rim=Assets.part(model,'Wheel',Vector3.new(.83,1.4,1.4),tyre.CFrame,metal,Enum.Material.Metal,Enum.PartType.Cylinder)
  wheels[#wheels+1]={tyre=tyre,rim=rim,side=sign,front=front}
 end end
 local root=game:GetService('ReplicatedStorage'):FindFirstChild('BackseatExpedition')
 local library=root and root:FindFirstChild('ImportedCars')
 local template=useOriginal~=false and library and library:FindFirstChild(car.template)
 local parts={}
 for _,p in ipairs(model:GetDescendants())do if p:IsA('BasePart')then
  p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=not ghost
  if ghost then p.Color=Color3.fromRGB(107,220,201);p.Transparency=.65;p.Material=Enum.Material.ForceField end
  parts[#parts+1]=p
 end end
 local sounds={};local bank=withAudio and root and root:FindFirstChild('ImportedAudio')
 if bank and not ghost then for _,name in ipairs({'Idle','Run','High'})do
  local source=bank:FindFirstChild(name)
  if source and source:IsA('Sound')then local sound=source:Clone();sound.Parent=body;sound.Volume=0;sound:Play();sounds[#sounds+1]=sound end
 end end
 model.Parent=parent
 model:SetAttribute('VisualSource','BuiltIn')
 local visual={model=model,wheels=wheels,parts=parts,spin=0,audio=sounds}
 if template and not ghost then
  Loader.check(template,function(ready)
   if not ready or not model.Parent then return end
   local skin=template:Clone()
   if not skin.PrimaryPart then skin:Destroy();return end
   skin.Name='Original exterior';skin:PivotTo(model:GetPivot())
   for _,part in ipairs(skin:GetDescendants())do if part:IsA('BasePart')then
    part.Anchored=true;part.CanCollide=false;part.CanTouch=false;part.CanQuery=false
   end end
   skin.Parent=model
   -- Keep a complete body until all external assets are confirmed available.
   for _,part in ipairs(parts)do
    if part.Name~='Tyre'and part.Name~='Wheel'then part.Transparency=1 end
   end
   model:SetAttribute('VisualSource','Original')
  end)
 end
 return visual
end
function Assets.pose(visual,s,route,offset,dt)
 local D=require(script.Parent.Dynamics)
 local y,pitch,roll=D.pose(s,route)
 local cf=CFrame.new(Vector3.new(s.x,y,s.z)+offset)*CFrame.Angles(0,math.pi+s.yaw,0)*CFrame.Angles(pitch,0,roll)
 visual.model:PivotTo(cf);visual.spin=(visual.spin+s.v*(dt or 0)/1.2)%(math.pi*2)
 for _,wheel in ipairs(visual.wheels)do
  local z=wheel.front and -3.8 or 3.8
  local pos=cf:PointToWorldSpace(Vector3.new(wheel.side*3,0,z))
  local localPos=pos-offset;local ground=route:ground(localPos.X,localPos.Z)
  local at=Vector3.new(pos.X,ground+1.2+offset.Y,pos.Z)
  local wc=CFrame.new(at)*cf.Rotation*CFrame.Angles(0,wheel.front and -s.steer*.32 or 0,0)*CFrame.Angles(visual.spin,0,0)
  wheel.tyre.CFrame=wc;wheel.rim.CFrame=wc
 end
 for i,sound in ipairs(visual.audio or {})do
  local speed=math.abs(s.v);local gear=(speed%32)/32
  sound.PlaybackSpeed=math.clamp(.65+gear*.8,.5,1.6)
  local gain=i==1 and math.clamp(1-speed/35,0,1)or(i==2 and math.clamp(speed/45,0,1)or math.clamp((speed-65)/65,0,1))
  sound.Volume=(dt or 0)&gt;0 and gain*.17 or 0
 end
 return cf
end
function Assets.park(parent)
 local ground=Assets.part(parent,'Service park',Vector3.new(160,2,150),CFrame.new(0,-1,0),{.21,.25,.22},Enum.Material.Asphalt)
 ground.CanCollide=true;ground.CanQuery=true
 for i,car in ipairs(require(script.Parent.Config).Cars)do
  local visual=Assets.car(parent,car,false,true)
  visual.model:PivotTo(CFrame.new((i-2)*20,2.2,-12)*CFrame.Angles(0,math.pi,0))
 end
 Assets.part(parent,'Workshop',Vector3.new(64,14,22),CFrame.new(0,7,-42),{.24,.30,.29},Enum.Material.WoodPlanks)
 Assets.part(parent,'Roof',Vector3.new(70,1,28),CFrame.new(0,14,-42),{.12,.18,.18},Enum.Material.Metal)
 for _,x in ipairs({-21,0,21})do Assets.part(parent,'Garage door',Vector3.new(17,10,.25),CFrame.new(x,5,-30.8),{.10,.14,.15},Enum.Material.Metal)end
 for _,x in ipairs({-44,44})do
  Assets.part(parent,'Lamp',Vector3.new(.5,12,.5),CFrame.new(x,6,5),metal,Enum.Material.Metal)
  Assets.part(parent,'Lantern',Vector3.new(2,.4,3),CFrame.new(x,12,5),{.99,.79,.48},Enum.Material.Neon)
 end
 local sign=Assets.part(parent,'Expedition sign',Vector3.new(45,4,.4),CFrame.new(0,12,-30.5),dark)
 local gui=Instance.new('SurfaceGui');gui.Face=Enum.NormalId.Back;gui.CanvasSize=Vector2.new(1000,100);gui.Parent=sign
 local text=Instance.new('TextLabel');text.Size=UDim2.fromScale(1,1);text.BackgroundTransparency=1;text.Text='BACKSEAT / EXPEDITION'
 text.TextColor3=Color3.fromRGB(239,222,183);text.Font=Enum.Font.GothamBold;text.TextScaled=true;text.Parent=gui
end
return Assets
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000012">
          <Properties>
            <string name="Name">Config</string>
            <ProtectedString name="Source">-- Backseat Rally: Expedition. Authored game systems, not an executor script.
return {
 Version='1.1.1', AutoOpen=true, Generation=1, WorldX=100000, LaneSpacing=1800, StudMetres=.28, Step=1/60, StateRate=12, InputRate=20,
 Chunk=256, RoadStep=16, RoadWidth=28, Checkpoint=768, MaxPlayers=8,
 ReplayRate=10, ReplayPage=500, ReplayPending=4, LibrarySize=12, BestSize=8,
 Modes={
  {id='sprint',name='Rally Sprint',tag='A road with an ending',length=6144,weather='clear',xp=240},
  {id='expedition',name='Expedition',tag='Four biomes. One long drive.',length=16384,weather='clear',xp=650},
  {id='daily',name='Daily Roadbook',tag='The same new road for everyone today',length=8192,weather='dusk',xp=340},
  {id='endless',name='Endless Journey',tag='Keep going. Bank the run whenever you want.',length=0,weather='clear',xp=0},
 },
 Cars={
  {id='hatch',name='Trail Hatch',template='Hatch',unlock=0,top=138,accel=33,grip=1,wheelbase=7.6,color={.89,.36,.16},description='Light, lively, and happy on gravel.'},
  {id='scout',name='Safari Scout',template='OrsoSafari',unlock=500,top=128,accel=30,grip=1.12,wheelbase=8,color={.64,.72,.43},description='A planted chassis for the long way home.'},
  {id='coupe',name='Ridge Coupe',template='Coupe',unlock=1400,top=151,accel=35,grip=.91,wheelbase=8.2,color={.28,.62,.76},description='A quick nose; treat the rear with respect.'},
 },
 Biomes={
  {name='Pine Country',ground={.29,.36,.24},road={.39,.34,.27},accent={.88,.66,.28},trees=true},
  {name='Alpine Pass',ground={.56,.60,.57},road={.40,.43,.43},accent={.72,.86,.91},snow=true},
  {name='Red Mesa',ground={.63,.40,.25},road={.67,.51,.35},accent={.91,.67,.33},desert=true},
  {name='North Coast',ground={.40,.51,.37},road={.36,.39,.40},accent={.80,.85,.71},coast=true},
 },
 Quality={low={behind=1,ahead=4,props=2,shadows=false},medium={behind=2,ahead=5,props=5,shadows=false},high={behind=2,ahead=6,props=9,shadows=true}},
}
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000013">
          <Properties>
            <string name="Name">Dynamics</string>
            <ProtectedString name="Source">-- Shared deterministic driving model. The server owns progress and outcomes.
-- Four road contacts set chassis attitude; visual wheels have independent travel.
local D={}
local function wrap(a)return (a+math.pi)%(2*math.pi)-math.pi end
local function approach(a,b,rate,dt)return a+(b-a)*(1-math.exp(-rate*dt))end
function D.new(route)
 local p=route:point(0)
 return {x=p.x,z=0,v=0,lateralV=0,yaw=p.heading,steer=0,damage=0,distance=0,crashes=0,impact=0}
end
function D.copy(s)local out={};for k,v in pairs(s)do out[k]=v end;return out end
function D.step(s,input,route,car,dt)
 dt=math.clamp(dt,0,1/30);local p=route:point(s.z)
 local _,offset=route:ground(s.x,s.z);local off=math.abs(offset)&gt;p.width/2+1
 local grip=car.grip*(p.surface=='tarmac'and 1.22 or 1)*(off and .63 or 1)
 s.steer=approach(s.steer,math.clamp(input.steer or 0,-1,1),9,dt)
 local throttle=math.clamp(input.throttle or 0,-1,1);local brake=math.clamp(input.brake or 0,0,1)
 local accel=throttle*car.accel*math.max(.72,1-s.damage*.003)*(1-.35*math.min(math.abs(s.v)/car.top,.94))
 if throttle&lt;0 and s.v&gt;2 then accel=-58 end
 if throttle&gt;0 and s.v&lt; -2 then accel=45 end
 local drag=(.72+.0011*s.v*s.v+(off and 8 or 0))*(s.v&lt;0 and -1 or 1)
 if math.abs(s.v)&lt;.3 and throttle==0 then s.v=0;drag=0 end
 s.throttle=throttle;s.brake=brake;s.handbrake=input.handbrake==true
 local braking=brake*66*(s.v&lt;0 and -1 or 1)
 local nextV=s.v+(accel-drag-braking-p.dy*20)*dt
 if brake&gt;0 and (math.abs(s.v)&lt;1.5 or s.v*nextV&lt;0)then nextV=0 end
 s.v=math.clamp(nextV,-23,car.top*(off and .68 or 1))
 local steerAngle=s.steer*math.rad(31)/(1+math.abs(s.v)/95)
 local yawRate=s.v/car.wheelbase*math.tan(steerAngle)
 local limit=grip*48/math.max(math.abs(s.v),10)
 local excess=yawRate-math.clamp(yawRate,-limit,limit)
 yawRate=math.clamp(yawRate,-limit,limit)+excess*.12
 s.lateralV=approach(s.lateralV,excess*math.abs(s.v)*.22,input.handbrake and 2.1 or 5*grip,dt)
 if input.handbrake then yawRate*=1.2;s.v*=math.exp(-.65*dt) end
 s.yaw=wrap(s.yaw-yawRate*dt)
 local forwardX,forwardZ=math.sin(s.yaw),math.cos(s.yaw)
 s.x+=(forwardX*s.v+forwardZ*s.lateralV)*dt
 s.z+=(forwardZ*s.v-forwardX*s.lateralV)*dt
 local _,lateral,newPoint=route:ground(s.x,s.z)
 s.impact=math.max(0,(s.impact or 0)-dt*2)
 local barrier=newPoint.bridge or newPoint.tunnel
 local bound=newPoint.width/2-3.1
 if barrier and math.abs(lateral)&gt;bound then
  local sign=lateral&lt;0 and -1 or 1
  s.x=newPoint.x+sign*bound*math.sqrt(1+newPoint.dx*newPoint.dx)
  local relative=wrap(s.yaw-newPoint.heading)
  local hit=math.abs(math.sin(relative)*s.v)+math.abs(s.lateralV)
  if hit&gt;5 and s.impact&lt;=0 then s.crashes+=1;s.damage=math.min(100,s.damage+hit*.2);s.impact=1 end
  s.yaw=approach(s.yaw,newPoint.heading,.8,dt);s.lateralV=0;s.v*=math.exp(-2*dt)
 elseif math.abs(lateral)&gt;newPoint.width/2+14 then
  s.v*=math.exp(-1.8*dt)
 end
 s.distance+=math.abs(s.v)*dt
 return s
end
function D.pose(s,route)
 local y=route:ground(s.x,s.z);local fX,fZ=math.sin(s.yaw),math.cos(s.yaw)
 local front=route:ground(s.x+fX*3.8,s.z+fZ*3.8)
 local back=route:ground(s.x-fX*3.8,s.z-fZ*3.8)
 local left=route:ground(s.x+fZ*2.8,s.z-fX*2.8)
 local right=route:ground(s.x-fZ*2.8,s.z+fX*2.8)
 return y+2.2,math.atan2(front-back,7.6),math.atan2(right-left,5.6)
end
function D.reset(s,route,z)
 local p=route:point(z);s.x=p.x;s.z=z;s.yaw=p.heading;s.v=0;s.lateralV=0;s.steer=0;s.impact=0
end
return D
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000014">
          <Properties>
            <string name="Name">ImportAssets</string>
            <ProtectedString name="Source">-- Clone visual templates only; source instances stay untouched.
local ImportAssets={}
local function safeClone(model,maxParts)
 local clone=model:Clone();local count=0
 for _,item in ipairs(clone:GetDescendants())do
  if item:IsA('LuaSourceContainer')or item:IsA('RemoteEvent')or item:IsA('RemoteFunction')or item:IsA('ProximityPrompt')or item:IsA('PackageLink')or item:IsA('Constraint')or item:IsA('JointInstance')then item:Destroy()
  elseif item:IsA('BasePart')then count+=1;item.Anchored=true;item.CanCollide=false;item.CanTouch=false;item.CanQuery=false;item.CastShadow=false
  elseif item:IsA('Sound')or item:IsA('ParticleEmitter')or item:IsA('Light')or item:IsA('Trail')or item:IsA('Beam')then item:Destroy()end
 end
 if count&gt;maxParts then clone:Destroy();return nil end
 return clone
end
function ImportAssets.harvest(root)
 if not root:FindFirstChild('ImportedAudio')then
  local audio=Instance.new('Folder');audio.Name='ImportedAudio';audio.Parent=root
  -- Idle, mid-load and high-load loops referenced by the supplied car audio bank.
  for i,id in ipairs({'rbxassetid://79745038579097','rbxassetid://112975795144083','rbxassetid://99444077339790'})do
   local sound=Instance.new('Sound');sound.Name=({'Idle','Run','High'})[i]
   sound.SoundId=id;sound.Looped=true;sound.Volume=0;sound.Parent=audio
  end
 end
 if root:FindFirstChild("ImportedCars") then return #root.ImportedCars:GetChildren(),#root.ImportedProps:GetChildren() end
 local rs=game:GetService('ReplicatedStorage');local assets=rs:FindFirstChild('Assets')
 if not assets then return 0,0 end
 local cars,props=0,0
 local carFolder=Instance.new('Folder');carFolder.Name='ImportedCars';carFolder.Parent=root
 local propFolder=Instance.new('Folder');propFolder.Name='ImportedProps';propFolder.Parent=root
 local originals=assets:FindFirstChild('Cars')
 for _,name in ipairs({'Hatch','OrsoSafari','Coupe'})do
  local source=originals and originals:FindFirstChild(name)
  local exterior=source and source:FindFirstChild('Exterior');local body=source and source:FindFirstChild('Body')
  if exterior and body and body:IsA('BasePart')then
   local clone=safeClone(exterior,180)
   if clone then
    clone.Name=name;local reference=body:Clone();reference.Name='SkinRoot';reference.Transparency=1;reference.Anchored=true;reference.CanCollide=false
    reference:ClearAllChildren();reference.Parent=clone;clone.PrimaryPart=reference;clone:PivotTo(CFrame.identity);clone.Parent=carFolder;cars+=1
   end
  end
 end
 local stage=assets:FindFirstChild('Stage');local forest=stage and stage:FindFirstChild('Forest')
 for _,name in ipairs({'SpruceYoung1','SpruceSlim1','Birch1','Rock1','Bush1'})do
  local source=forest and forest:FindFirstChild(name)
  if source and source:IsA('Model')then
   local clone=safeClone(source,24)
   if clone then
    local cf,size=clone:GetBoundingBox();clone.WorldPivot=CFrame.new(cf.Position.X,cf.Position.Y-size.Y/2,cf.Position.Z)
    clone:PivotTo(CFrame.identity);clone.Parent=propFolder;props+=1
   end
  end
 end
 return cars,props
end
return ImportAssets
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000015">
          <Properties>
            <string name="Name">Replay</string>
            <ProtectedString name="Source">-- Quantized, paged CSV data; no executable replay content. ~25 KB / 50 s page.
local R={}
local function round(n)return math.floor(n+.5)end
function R.frame(t,s,flags,input)
 input=input or {}
 return {round(t*1000),round(s.x*20),round(s.z*20),round(s.yaw*10000),round(s.v*10),round(s.steer*1000),round(s.damage*10),flags or 0,round((input.throttle or 0)*1000),round((input.brake or 0)*1000),input.handbrake and 1 or 0}
end
function R.encode(frames)
 local rows={}
 for i,f in ipairs(frames)do rows[i]=table.concat(f,',')end
 return table.concat(rows,'\n')
end
function R.decode(text)
 assert(type(text)=='string'and #text&lt;=100000,'Invalid replay page')
 local frames={};local previous=-1
 for line in text:gmatch('[^\n]+')do
  local f={};for value in line:gmatch('[^,]+')do f[#f+1]=tonumber(value)end
  assert(#f==11,'Invalid replay frame')
  for _,n in ipairs(f)do assert(n==n and math.abs(n)&lt;1e12 and n==math.floor(n),'Invalid replay number')end
  assert(f[1]&gt;=previous and f[8]&gt;=0 and f[8]&lt;=1,'Invalid replay chronology')
  assert(math.abs(f[9])&lt;=1000 and f[10]&gt;=0 and f[10]&lt;=1000 and (f[11]==0 or f[11]==1),'Invalid recorded controls')
  previous=f[1];frames[#frames+1]=f;assert(#frames&lt;=500,'Oversized replay page')
 end
 return frames
end
function R.state(f)
 return {x=f[2]/20,z=f[3]/20,yaw=f[4]/10000,v=f[5]/10,steer=f[6]/1000,damage=f[7]/10,lateralV=0,distance=0,crashes=0,impact=0,throttle=f[9]/1000,brake=f[10]/1000,handbrake=f[11]==1}
end
function R.sample(frames,t)
 if #frames==0 then return nil end
 local ms=t*1000;local lo,hi=1,#frames
 while lo&lt;hi do local mid=math.floor((lo+hi+1)/2);if frames[mid][1]&lt;=ms then lo=mid else hi=mid-1 end end
 local a,b=frames[lo],frames[math.min(lo+1,#frames)]
 if b[8]==1 and ms&lt;b[1]then return R.state(a)end
 local f=math.clamp((ms-a[1])/math.max(1,b[1]-a[1]),0,1)
 local s=R.state(a);local nextState=R.state(b)
 for _,k in ipairs({'x','z','v','steer','damage'})do s[k]+=(nextState[k]-s[k])*f end
 local delta=(nextState.yaw-s.yaw+math.pi)%(2*math.pi)-math.pi;s.yaw+=delta*f
 return s
end
return R
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX00000016">
          <Properties>
            <string name="Name">Route</string>
            <ProtectedString name="Source">-- Continuous, forward-monotone roads: no self-crossings, jumps, or blocked lanes.
local Route={};Route.__index=Route
local sin,cos,sqrt=math.sin,math.cos,math.sqrt
local function hash(seed,index)
 local value=(seed+(index+19)*104729)%2147483647
 for _=1,3 do value=(value*48271)%2147483647 end
 return value
end
function Route.random(seed,index)return hash(seed,index)/2147483647 end
function Route.new(seed,length,config)
 seed=math.floor(tonumber(seed)or 1)%1000000000
 local self=setmetatable({seed=seed,length=length or 0,config=config},Route)
 self.p1=Route.random(seed,1)*math.pi*2;self.p2=Route.random(seed,2)*math.pi*2
 self.p3=Route.random(seed,3)*math.pi*2
 self.a=90+Route.random(seed,5)*30;self.b=18+Route.random(seed,7)*8
 self.f=1/(220+Route.random(seed,8)*80);self.g=1/(62+Route.random(seed,9)*22)
 self.x0=self.a*sin(self.p1)+self.b*sin(self.p2)
 self.y0=11*sin(self.p3)
 return self
end
function Route:point(z)
 local c=self.config;local a,b,f,g=self.a,self.b,self.f,self.g
 -- Fade elevation into a flat starting apron, with zero derivative at z=0.
 local fade=math.clamp(z/160,0,1);local ease=fade*fade*(3-2*fade)
 local dease=(z&gt;0 and z&lt;160)and 6*fade*(1-fade)/160 or 0
 local raw=11*sin(z/280+self.p3)-self.y0+5*sin(z/510)
 local dy=(11/280*cos(z/280+self.p3)+5/510*cos(z/510))*ease+raw*dease
 local x=a*sin(f*z+self.p1)+b*sin(g*z+self.p2)-self.x0
 local dx=a*f*cos(f*z+self.p1)+b*g*cos(g*z+self.p2)
 local ddx=-a*f*f*sin(f*z+self.p1)-b*g*g*sin(g*z+self.p2)
 local chunk=math.floor(math.max(0,z)/c.Chunk)
 local biome=(math.floor(chunk/8)+self.seed%4)%4+1
 local bridge=chunk%17==10;local tunnel=chunk%19==14
 local bank=math.clamp(-ddx*6,-.055,.055)
 return {x=x,y=8+raw*ease,z=z,dx=dx,dy=dy,heading=math.atan2(dx,1),
  curvature=ddx/(1+dx*dx)^1.5,bank=bank,width=c.RoadWidth,biome=biome,
  bridge=bridge,tunnel=tunnel,chunk=chunk,surface=(biome==4 or tunnel)and 'tarmac'or 'gravel'}
end
function Route:ground(x,z)
 local p=self:point(z);local lateral=(x-p.x)/sqrt(1+p.dx*p.dx)
 local shoulder=math.max(0,math.abs(lateral)-p.width/2)
 return p.y+lateral*math.tan(p.bank)-math.min(shoulder*.13,3),lateral,p
end
function Route:note(z)
 local p=self:point(z+100);local k=p.curvature
 if p.tunnel then return 'TUNNEL · keep the line' end
 if p.bridge then return 'BRIDGE · stay tidy' end
 if math.abs(k)&lt;.0013 then return 'STRAIGHT · opens' end
 local severity=math.abs(k)&gt;.004 and '3' or '5'
 return (k&gt;0 and 'LEFT 'or 'RIGHT ')..severity..' · '..(math.abs(k)&gt;.004 and 'tightens'or 'flow')
end
function Route:key(mode,car)return table.concat({self.config.Generation,mode,self.seed,self.length,car},':')end
return Route
</ProtectedString>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="RBX00000017">
        <Properties>
          <string name="Name">Remotes</string>
        </Properties>
        <Item class="RemoteEvent" referent="RBX00000018">
          <Properties>
            <string name="Name">Action</string>
          </Properties>
        </Item>
        <Item class="RemoteFunction" referent="RBX00000019">
          <Properties>
            <string name="Name">Request</string>
          </Properties>
        </Item>
        <Item class="UnreliableRemoteEvent" referent="RBX0000001A">
          <Properties>
            <string name="Name">State</string>
          </Properties>
        </Item>
        <Item class="UnreliableRemoteEvent" referent="RBX0000001B">
          <Properties>
            <string name="Name">Input</string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX00000006">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX0000001C">
      <Properties>
        <string name="Name">BackseatExpeditionServer</string>
      </Properties>
      <Item class="Script" referent="RBX0000001D">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source">local Players=game:GetService('Players')
local ReplicatedStorage=game:GetService('ReplicatedStorage')
local RunService=game:GetService('RunService')
local Workspace=game:GetService('Workspace')
local root=ReplicatedStorage:WaitForChild('BackseatExpedition')
local C=require(root.Shared.Config);local Route=require(root.Shared.Route)
local D=require(root.Shared.Dynamics);local Replay=require(root.Shared.Replay)
local Persistence=require(script.Parent.Persistence);local storage=Persistence.new(C)
local Assets=require(root.Shared.Assets)
local remotes=root.Remotes;local action=remotes.Action;local request=remotes.Request;local stateEvent=remotes.State;local inputEvent=remotes.Input
local runs,viewing,slots={}, {}, {};local ending=0;local returnPoints={}
local function getCar(id)for _,car in ipairs(C.Cars)do if car.id==id then return car end end;return C.Cars[1]end
local function getMode(id)for _,mode in ipairs(C.Modes)do if mode.id==id then return mode end end;return C.Modes[1]end
local function tell(player,kind,data)if player and player.Parent then action:FireClient(player,kind,data)end end
local function participants(run)
 local out={run.player};if run.passenger and run.passenger.Parent then table.insert(out,run.passenger)end;return out
end
local function broadcastRun(run,kind,data)for _,p in ipairs(participants(run))do tell(p,kind,data)end end
local function origin(run)return Vector3.new(C.WorldX+run.slot*C.LaneSpacing,0,-math.floor(run.s.z/4096)*4096)end
local function worldFrame(run)
 local y,pitch,roll=D.pose(run.s,run.route)
 return CFrame.new(Vector3.new(run.s.x,y,run.s.z)+origin(run))*CFrame.Angles(0,math.pi+run.s.yaw,0)*CFrame.Angles(pitch,0,roll)
end
local function seatPlayer(player,seat)
 local character=player.Character;local humanoid=character and character:FindFirstChildOfClass('Humanoid')
 if humanoid then character:PivotTo(seat.CFrame*CFrame.new(0,3,0));seat:Sit(humanoid)end
end
local function rememberReturn(player)
 if not returnPoints[player]and player.Character then returnPoints[player]=player.Character:GetPivot()end
end
local function returnLobby(player)
 viewing[player]=nil
 local character=player.Character;local h=character and character:FindFirstChildOfClass('Humanoid')
 if h then h.Sit=false;h.Jump=true end
 local target=returnPoints[player];returnPoints[player]=nil
 task.delay(.15,function()if target and character and character.Parent and not runs[player]and not viewing[player]then character:PivotTo(target)end end)
end
local function packet(run)
 return {id=run.record.meta.id,owner=run.player.UserId,name=run.player.DisplayName,mode=run.mode.id,seed=run.route.seed,length=run.route.length,
  car=run.car.id,slot=run.slot,s=D.copy(run.s),clock=run.clock,penalty=run.penalty,nextGate=run.nextGate,
  missed=run.missed or false,status=run.status,originZ=origin(run).Z,course=run.record.meta.course,
  passenger=run.passenger and run.passenger.UserId or 0,ghost=run.ghost and run.ghost.id or nil,recording=not run.record.failed}
end
local function recordFrame(run,flag)
 local f=Replay.frame(run.clock+run.penalty,run.s,flag,run.input);local frames=run.frames
 frames[#frames+1]=f
 if #frames&gt;=C.ReplayPage then storage:page(run.record,Replay.encode(frames),frames);run.frames={}end
end
local function finish(run,reason)
 if runs[run.player]~=run then return end
 recordFrame(run)
 runs[run.player]=nil;slots[run.slot]=nil;ending+=1
 if #run.frames&gt;0 then storage:page(run.record,Replay.encode(run.frames),run.frames);run.frames={}end
 local meta=run.record.meta;meta.duration=run.clock+run.penalty;meta.penalty=run.penalty
 meta.completed=reason=='finish';meta.banked=reason=='bank';meta.reason=reason
 meta.distance=run.s.distance;meta.progress=run.missed and run.lastGate or run.validZ;meta.crashes=run.s.crashes
 local reward=meta.completed and run.mode.xp or (meta.banked and math.floor(run.validZ/128)or 0)
 if meta.completed and run.s.crashes==0 then reward+=50;meta.cleanBonus=50 end
 meta.reward=reward
 local members=participants(run)
 for _,p in ipairs(members)do
  returnLobby(p);tell(p,'result',meta)
 end
 run.model:Destroy()
 storage:finish(run.record,reward,function(userId,record,status)
  local p=Players:GetPlayerByUserId(userId);tell(p,'saved',{id=record.id,status=status,saved=record.saved})
 end)
 task.spawn(function()local deadline=os.clock()+22;while not run.record.done and os.clock()&lt;deadline do task.wait(.1)end;ending-=1 end)
end
local function start(player,data)
 if runs[player]or viewing[player]then return end
 local car=getCar(data.car);local profile=storage:load(player.UserId)
 if profile.xp&lt;car.unlock then tell(player,'notice','This car unlocks at '..car.unlock..' XP.');return end
 if profile.loading then tell(player,'notice','Loading your garage save; try again in a moment.');return end
 local numeric=tonumber(data.seed);if not numeric or numeric~=numeric or math.abs(numeric)&gt;1e12 then numeric=math.random(1,999999999)end
 local mode=getMode(data.mode);local seed=math.floor(numeric)%1000000000
 if mode.id=='daily'then seed=math.floor(os.time()/86400)end
 local slot
 for i=1,C.MaxPlayers do if not slots[i]then slot=i;break end end
 if not slot then tell(player,'notice','All rally slots are in use. Join a co-driver seat or try again shortly.');return end
 local route=Route.new(seed,mode.length,C)
 local run={player=player,route=route,car=car,mode=mode,slot=slot,s=D.new(route),clock=0,penalty=0,nextGate=C.Checkpoint,
  lastGate=0,validZ=0,status='loading',frames={},sample=0,input={throttle=0,steer=0,brake=1},lastInput=0,seq=-1,created=os.clock(),recoverAt=-100}
 if mode.length&gt;0 then run.nextGate=math.min(run.nextGate,mode.length)end
 run.record=storage:newRecording(player.UserId,{seed=seed,length=mode.length,mode=mode.id,car=car.id,course=route:key(mode.id,car.id),generation=C.Generation,weather=mode.weather})
 for _,best in ipairs(profile.bests)do if best.course==run.record.meta.course then run.ghost=best;break end end
 local model=Instance.new('Model');model.Name='Rally_'..player.UserId
 local body=Instance.new('Part');body.Name='Root';body.Size=Vector3.new(6,2,10);body.Transparency=1;body.Anchored=true;body.CanCollide=false;body.Parent=model;model.PrimaryPart=body
 for i,name in ipairs({'Driver','CoDriver'})do
  local seat=Instance.new('Seat');seat.Name=name;seat.Size=Vector3.new(2,1,2);seat.Transparency=1;seat.Anchored=true;seat.CanCollide=false
  seat.CFrame=CFrame.new(i==1 and -1.3 or 1.3,.25,0);seat.Parent=model
 end
 model.Parent=Workspace;run.model=model;model:PivotTo(worldFrame(run));runs[player]=run;slots[slot]=run
 rememberReturn(player);seatPlayer(player,model.Driver);tell(player,'start',packet(run));recordFrame(run)
end
local lastAction={}
action.OnServerEvent:Connect(function(player,kind,data)
 if type(kind)~='string'then return end
 local now=os.clock();if kind~='ready'and kind~='retire'and kind~='leave'and now-(lastAction[player]or -math.huge)&lt;.12 then return end;lastAction[player]=now
 data=type(data)=='table'and data or {};local run=runs[player]
 if kind=='start'then start(player,data)
 elseif kind=='ready'and run and run.status=='loading'then run.status='countdown';run.countUntil=now+3;broadcastRun(run,'countdown',3)
 elseif kind=='retire'and run then finish(run,run.mode.id=='endless'and 'bank'or 'retired')
 elseif kind=='recover'and run and now-run.recoverAt&gt;3 and run.status=='running'then
  run.recoverAt=now;run.penalty+=5;D.reset(run.s,run.route,run.lastGate);run.missed=false;recordFrame(run,1);broadcastRun(run,'notice','Recovered to checkpoint · +5 seconds')
 elseif kind=='bookmark'and run then
  local markers=run.record.meta.markers;if #markers&lt;32 then markers[#markers+1]=run.clock+run.penalty end;tell(player,'notice','Replay moment marked')
 elseif kind=='join'then
  if run or viewing[player]then return end
  local host=Players:GetPlayerByUserId(tonumber(data.owner)or 0);local target=host and runs[host]
  if target and not target.passenger then
   rememberReturn(player);target.passenger=player;viewing[player]=target
   if not table.find(target.record.meta.access,player.UserId)then table.insert(target.record.meta.access,player.UserId)end
   seatPlayer(player,target.model.CoDriver);tell(player,'start',packet(target));tell(host,'notice',player.DisplayName..' joined as co-driver')
  end
 elseif kind=='leave'and viewing[player]then
  local target=viewing[player];target.passenger=nil;returnLobby(player);tell(player,'lobby',{})
 elseif kind=='call'and viewing[player]then
  local allowed={left='LEFT · co-driver call',right='RIGHT · co-driver call',caution='CAUTION · co-driver call'}
  if allowed[data.note]then tell(viewing[player].player,'notice',allowed[data.note])end
 end
end)
inputEvent.OnServerEvent:Connect(function(player,data)
 local run=runs[player];if not run or type(data)~='table'then return end
 if type(data.seq)~='number'or data.seq%1~=0 or data.seq&lt;=run.seq then return end
 local function unit(n)if type(n)~='number'or n~=n then return 0 end;return math.clamp(n,-1,1)end
 run.seq=data.seq;run.lastInput=os.clock()
 run.input={throttle=unit(data.throttle),steer=unit(data.steer),brake=math.max(0,unit(data.brake)),handbrake=data.handbrake==true}
end)
local requestAt={}
request.OnServerInvoke=function(player,kind,data)
 local now=os.clock();if now-(requestAt[player]or -math.huge)&lt;.12 then return {error='Please wait a moment'}end;requestAt[player]=now
 if kind=='library'then return storage:library(player.UserId)
 elseif kind=='replay'then
  local id=type(data)=='table'and data.id;local r=storage:find(player.UserId,id)
  if not r then return {error='Replay unavailable'}end
  return {record=r}
 elseif kind=='page'then
  if type(data)~='table'then return {error='Invalid request'}end
  local text,reason=storage:getPage(player.UserId,data.id,data.index);return text and {text=text}or {error=reason}
 elseif kind=='lobby'then
  local open={};for _,r in pairs(runs)do if not r.passenger then table.insert(open,{owner=r.player.UserId,name=r.player.DisplayName,mode=r.mode.name})end end
  return {drivers=open,library=storage:library(player.UserId)}
 end
 return {error='Unknown request'}
end
local accumulated,network=0,0
RunService.Heartbeat:Connect(function(dt)
 accumulated=math.min(accumulated+dt,.15);local steps=0
 while accumulated&gt;=C.Step and steps&lt;5 do
  accumulated-=C.Step;steps+=1
  for _,run in pairs(runs)do
   if run.status=='loading'and os.clock()-run.created&gt;45 then finish(run,'loading cancelled')
   elseif run.status=='countdown'then
    if os.clock()&gt;=run.countUntil then run.status='running';broadcastRun(run,'go',{})end
   elseif run.status=='running'then
    local input=os.clock()-run.lastInput&lt;.6 and run.input or {throttle=0,steer=0,brake=.5}
    D.step(run.s,input,run.route,run.car,C.Step);run.clock+=C.Step
    local p=run.route:point(run.s.z);local lateral=math.abs((run.s.x-p.x)/math.sqrt(1+p.dx*p.dx))
    if not run.missed and run.s.z&gt;=run.nextGate and run.s.z&lt;run.nextGate+30 and lateral&lt;p.width/2+2 then
     run.lastGate=run.nextGate;run.validZ=run.lastGate;run.s.damage=math.max(0,run.s.damage-12)
     if run.route.length&gt;0 and run.lastGate&gt;=run.route.length then finish(run,'finish')
     else
      run.nextGate=run.lastGate+C.Checkpoint
      if run.route.length&gt;0 then run.nextGate=math.min(run.nextGate,run.route.length)end
      broadcastRun(run,'checkpoint',{z=run.lastGate,time=run.clock+run.penalty})
     end
    elseif run.s.z&gt;run.nextGate+30 then run.missed=true end
    if not run.missed and lateral&lt;p.width/2+3 then run.validZ=math.max(run.validZ,run.s.z)end
    if runs[run.player]==run then
    run.sample+=C.Step
    if run.sample&gt;=1/C.ReplayRate then run.sample-=1/C.ReplayRate;recordFrame(run)end
    end
   end
  end
 end
 network+=dt
 if network&gt;=1/C.StateRate then
  network=0;local list={}
  for _,run in pairs(runs)do
   run.model:PivotTo(worldFrame(run));list[#list+1]=packet(run)
   if not run.model.Driver.Occupant and os.clock()-run.created&gt;2 then seatPlayer(run.player,run.model.Driver)end
  end
  if #list&gt;0 then stateEvent:FireAllClients({time=Workspace:GetServerTimeNow(),runs=list})end
 end
end)
Players.PlayerAdded:Connect(function(player)storage:load(player.UserId)end)
Players.PlayerRemoving:Connect(function(player)
 if runs[player]then finish(runs[player],runs[player].mode.id=='endless'and 'bank'or 'disconnected')end
 if viewing[player]then viewing[player].passenger=nil;viewing[player]=nil end
 lastAction[player]=nil;requestAt[player]=nil
end)
for _,p in ipairs(Players:GetPlayers())do storage:load(p.UserId)end
game:BindToClose(function()
 local list={};for _,run in pairs(runs)do list[#list+1]=run end
 for _,run in ipairs(list)do finish(run,run.mode.id=='endless'and 'bank'or 'server closed')end
 local untilTime=os.clock()+25;while ending&gt;0 and os.clock()&lt;untilTime do task.wait(.1)end
end)
-- Reuse visual templates in the expansion namespace without changing the source assets.
task.spawn(function()
 local ok,reason=pcall(function()require(root.Shared.ImportAssets).harvest(root)end)
 if not ok then warn('Optional original visual templates unavailable: '..tostring(reason))end
end)
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX0000001E">
        <Properties>
          <string name="Name">Persistence</string>
          <ProtectedString name="Source">-- Immutable replay pages + small manifests. No DataStore work on the simulation thread.
local DataStoreService=game:GetService('DataStoreService')
local HttpService=game:GetService('HttpService')
local P={};P.__index=P
local function fresh()return {version=1,xp=0,records={},bests={},applied={}}end
function P.new(config)
 return setmetatable({config=config,profiles=DataStoreService:GetDataStore('BRExpeditionProfiles_v1'),
  replays=DataStoreService:GetDataStore('BRExpeditionReplays_v1'),users={},cache={},order={},status={},warned=false},P)
end
function P:request(store,method,key,value)
 local last
 for attempt=1,3 do
  local ok,result=pcall(function()
   if method=='GetAsync'then return store:GetAsync(key)end
   return store:UpdateAsync(key,function()return value end)
  end)
  if ok then return true,result end
  last=tostring(result)
  if not self.warned then self.warned=true;warn('Expedition storage unavailable; replays stay in this server until storage recovers.')end
  task.wait(math.min(2,attempt*.5))
 end
 return false,last
end
function P:load(userId)
 if self.users[userId]then return self.users[userId]end
 local profile=fresh();profile.loading=true;self.users[userId]=profile;self.status[userId]='Loading save…'
 task.spawn(function()
  local ok,data=self:request(self.profiles,'GetAsync','u:'..userId)
  if ok and type(data)=='table'and data.version==1 then
   profile.xp=tonumber(data.xp)or 0;profile.records=data.records or {};profile.bests=data.bests or {};profile.applied=data.applied or {}
  end
  profile.loading=false
  self.status[userId]=ok and 'Cloud save ready'or 'Session only · enable Studio API access for cloud saves'
 end)
 return profile
end
function P:remember(key,text)
 self.cache[key]=text;table.insert(self.order,key)
 while #self.order&gt;80 do local old=table.remove(self.order,1);self.cache[old]=nil end
end
function P:newRecording(userId,metadata)
 metadata.id=HttpService:GenerateGUID(false);metadata.owner=userId;metadata.pages={};metadata.created=os.time()
 metadata.access={userId};metadata.markers={};metadata.saved=false;metadata.startTime=0
 return {meta=metadata,pending=0,failed=false,finished=false}
end
function P:page(record,text,frames)
 local meta=record.meta;local index=#meta.pages+1;local key='r:'..meta.id..':'..index
 local desc={index=index,from=frames[1][1]/1000,to=frames[#frames][1]/1000,count=#frames,key=key,saved=false}
 meta.pages[index]=desc;self:remember(key,text)
 if record.pending&gt;=self.config.ReplayPending then
  record.failed=true;meta.partial=true;return
 end
 record.pending+=1
 task.spawn(function()
  local ok=self:request(self.replays,'UpdateAsync',key,text)
  desc.saved=ok;record.failed=record.failed or not ok;record.pending-=1
 end)
end
local function add(profile,meta,reward,config,durableOnly)
 local applied=profile.applied or {};profile.applied=applied
 if table.find(applied,meta.id)then return profile end
 table.insert(applied,meta.id);while #applied&gt;32 do table.remove(applied,1)end
 profile.xp=math.max(0,tonumber(profile.xp)or 0)+reward
 if durableOnly and not meta.saved then return profile end
 local records=profile.records or {};profile.records=records
 table.insert(records,1,meta);while #records&gt;config.LibrarySize do table.remove(records)end
 local bests=profile.bests or {};profile.bests=bests
 if meta.completed or meta.banked then
  local found
  for i,b in ipairs(bests)do if b.course==meta.course then found=i;break end end
  local previous=found and bests[found]
  local faster=not previous or meta.duration&lt;previous.duration
  local farther=not previous or (meta.progress or 0)&gt;(previous.progress or 0)
  if not previous or (meta.banked and farther)or (not meta.banked and faster)then
   if found then table.remove(bests,found)end
   table.insert(bests,1,meta)
  end
  while #bests&gt;config.BestSize do table.remove(bests)end
 end
 return profile
end
function P:finish(record,reward,notify)
 record.finished=true
 task.spawn(function()
  local deadline=os.clock()+18
  while record.pending&gt;0 and os.clock()&lt;deadline do task.wait(.1)end
  local meta=record.meta;local complete=#meta.pages&gt;0
  for _,page in ipairs(meta.pages)do if not page.saved then complete=false end end
  meta.saved=complete and not record.failed
  -- Session-only recordings stay accessible through the in-memory page cache.
  meta.storage=meta.saved and 'Saved to cloud'or 'Session only'
  local okManifest=self:request(self.replays,'UpdateAsync','m:'..meta.id,meta)
  if not okManifest then meta.saved=false;meta.storage='Session only'end
  for _,userId in ipairs(meta.access)do
   local profile=self:load(userId)
   add(profile,meta,reward,self.config)
   local savedProfile
   local ok=pcall(function()
    savedProfile=self.profiles:UpdateAsync('u:'..userId,function(old)
     old=type(old)=='table'and old.version==1 and old or fresh()
     return add(old,meta,reward,self.config,true)
    end)
   end)
   if ok and savedProfile then
    -- Preserve session-only clips in RAM without writing broken cloud references.
    local seen={};for _,r in ipairs(savedProfile.records)do seen[r.id]=true end
    for _,r in ipairs(profile.records)do if not r.saved and not seen[r.id]then table.insert(savedProfile.records,1,r);seen[r.id]=true end end
    while #savedProfile.records&gt;self.config.LibrarySize do table.remove(savedProfile.records)end
    local courses={};for _,r in ipairs(savedProfile.bests)do courses[r.course]=true end
    for _,r in ipairs(profile.bests)do if not r.saved and not courses[r.course]then table.insert(savedProfile.bests,r);courses[r.course]=true end end
    while #savedProfile.bests&gt;self.config.BestSize do table.remove(savedProfile.bests)end
    self.users[userId]=savedProfile
   elseif not ok then meta.saved=false;meta.storage='Session only · save index unconfirmed'end
   self.status[userId]=(meta.saved and ok)and 'Cloud save ready'or 'Session only · save was not confirmed'
   if notify then notify(userId,meta,self.status[userId])end
  end
  record.done=true
 end)
end
function P:find(userId,id)
 local profile=self:load(userId)
 for _,list in ipairs({profile.records,profile.bests})do for _,r in ipairs(list)do if r.id==id then return r end end end
end
function P:getPage(userId,id,index)
 local record=self:find(userId,id)
 if not record or type(index)~='number'or index%1~=0 then return nil,'Replay unavailable'end
 local page=record.pages[index];if not page then return nil,'Page unavailable'end
 local cached=self.cache[page.key];if cached then return cached end
 if not page.saved then return nil,'This session-only page is no longer in memory'end
 local ok,text=self:request(self.replays,'GetAsync',page.key)
 if ok and type(text)=='string'then self:remember(page.key,text);return text end
 return nil,'Could not load replay page; try again'
end
function P:library(userId)
 local profile=self:load(userId)
 return {xp=profile.xp,records=profile.records,bests=profile.bests,status=self.status[userId]or 'Loading save…'}
end
return P
