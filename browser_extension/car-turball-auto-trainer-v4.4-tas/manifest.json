{
  "manifest_version": 3,
  "name": "Car Soccer + Turball AI Trainer",
  "version": "4.5.3",
  "description": "AI models, TAS and local/host fun controls updated for Car Soccer main-B95SF9Gf; includes local capture for unsupported Turball builds.",
  "permissions": [
    "debugger",
    "tabs",
    "webNavigation",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://car-soccer.com/*",
    "https://turball.io/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Car Soccer + Turball AI Trainer",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://car-soccer.com/*",
        "https://turball.io/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "nexto-worker.bundle.js",
        "nexto-weights.bin",
        "g9-weights.bin"
      ],
      "matches": [
        "https://car-soccer.com/*",
        "https://turball.io/*"
      ]
    }
  ]
}
